      "annotations": [
        {
          "tag": "xsd_type",
          "value": "ReasonEnumeration"
        }
      ],
      "description": "A short label for why an entry may not suit vulnerability mapping.",
      "comments": [
        "Category stays beside Grouping because XSD 8.0 lists both. The data of CWE 5.0 uses only Grouping."
      ],
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_core",
      "permissible_values": [
        {
          "text": "Abstraction"
        },
        {
          "text": "Category"
        },
        {
          "text": "Grouping"
        },
        {
          "text": "View"
        },
        {
          "text": "Deprecated"
        },
        {
          "text": "Potential Deprecation"
        },
        {
          "text": "Frequent Misuse"
        },
        {
          "text": "Frequent Misinterpretation"
        },
        {
          "text": "Multiple Use"
        },
        {
          "text": "CWE Overlap"
        },
        {
          "text": "Acceptable-Use"
        },
        {
          "text": "Frequently-Resultant"
        },
        {
          "text": "Potential Major Changes"
        },
        {
          "text": "Other"
        }
      ]
