  "classes": [
    {
      "name": "CweWeaknessCatalog",
      "definition_uri": "https://w3id.org/lmodel/cwe/CweWeaknessCatalog",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "Weakness_Catalog",
          "@type": "Annotation"
        }
      ],
      "description": "One release of the CWE List, with all its entries and the sources they cite.",
      "comments": [
        "Wikidata's item is the catalogue in general and this class is one release of it, so the item is related."
      ],
      "from_schema": "https://w3id.org/lmodel/cwe",
      "close_mappings": [
        "skos:ConceptScheme",
        "schema:DefinedTermSet"
      ],
      "related_mappings": [
        "wd:Q2682392"
      ],
      "slots": [
        "cweWeaknessCatalog__Name",
        "cweWeaknessCatalog__Version",
        "cweWeaknessCatalog__Date",
        "cweWeaknessCatalog__Weaknesses",
        "cweWeaknessCatalog__Groupings",
        "cweWeaknessCatalog__Views",
        "cweWeaknessCatalog__External_References"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Name",
          "description": "The name of the catalogue, which is CWE.",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Version",
          "description": "The version of this release.",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Date",
          "description": "The date of this release.",
          "range": "date",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Weaknesses",
          "description": "The weakness entries.",
          "range": "CweWeakness",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Groupings",
          "description": "The grouping entries.",
          "range": "CweGrouping",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Views",
          "description": "The view entries.",
          "range": "CweView",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "External_References",
          "description": "The sources that the entries cite.",
          "range": "CweExternalReference",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/cwe/CweWeaknessCatalog",
      "tree_root": true,
      "@type": "ClassDefinition"
    },
    {
      "name": "CweExternalReference",
      "definition_uri": "https://w3id.org/lmodel/cwe/CweExternalReference",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "ExternalReferenceType",
          "@type": "Annotation"
        }
      ],
      "description": "A source that entries of the catalogue cite, such as a paper, a book or a web page.",
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_core",
      "close_mappings": [
        "sepses_cwe:Reference",
        "capec:CapecExternalReference"
      ],
      "slots": [
        "cweExternalReference__Reference_ID",
        "cweExternalReference__Author",
        "cweExternalReference__Title",
        "cweExternalReference__Edition",
        "cweExternalReference__Publication",
        "cweExternalReference__Publication_Year",
        "cweExternalReference__Publication_Month",
        "cweExternalReference__Publication_Day",
        "cweExternalReference__Publisher",
        "cweExternalReference__URL",
        "cweExternalReference__URL_Date",
        "cweExternalReference__Alt_URL",
        "cweExternalReference__Alt_URL_Date",
        "cweExternalReference__Media_Type",
        "cweExternalReference__Access_Restrictions",
        "cweExternalReference__Rationale"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Reference_ID",
          "description": "The identifier entries use to cite this source.",
          "identifier": true,
          "range": "cwe_reference_id",
          "@type": "SlotDefinition"
        },
        {
          "name": "Author",
          "description": "A person or group who wrote the source.",
          "exact_mappings": [
            "sepses_cwe:referenceAuthor"
          ],
          "close_mappings": [
            "dcterms:creator"
          ],
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Title",
          "description": "The title of the source.",
          "exact_mappings": [
            "sepses_cwe:referenceTitle",
            "dcterms:title"
          ],
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Edition",
          "description": "The edition of the source.",
          "exact_mappings": [
            "sepses_cwe:referenceEdition"
          ],
          "close_mappings": [
            "schema:bookEdition"
          ],
          "@type": "SlotDefinition"
        },
        {
          "name": "Publication",
          "description": "The journal, conference or other publication that holds the source.",
          "@type": "SlotDefinition"
        },
        {
          "name": "Publication_Year",
          "description": "The year the source came out.",
          "exact_mappings": [
            "sepses_cwe:referencePublicationYear"
          ],
          "range": "cwe_publication_year",
          "@type": "SlotDefinition"
        },
        {
          "name": "Publication_Month",
          "description": "The month the source came out.",
          "exact_mappings": [
            "sepses_cwe:referencePublicationMonth"
          ],
          "range": "cwe_publication_month",
          "@type": "SlotDefinition"
        },
        {
          "name": "Publication_Day",
          "description": "The day of the month the source came out.",
          "exact_mappings": [
            "sepses_cwe:referencePublicationDay"
          ],
          "range": "cwe_publication_day",
          "@type": "SlotDefinition"
        },
        {
          "name": "Publisher",
          "description": "Who published the source.",
          "exact_mappings": [
            "sepses_cwe:referencePublisher"
          ],
          "close_mappings": [
            "dcterms:publisher"
          ],
          "@type": "SlotDefinition"
        },
        {
          "name": "URL",
          "description": "An address where the source can be read.",
          "comments": [
            "One entry of CWE 5.0, REF-1068, holds the word Original here, which the XSD's anyURI admits."
          ],
          "exact_mappings": [
            "sepses_cwe:referenceUrl"
          ],
          "close_mappings": [
            "schema:url"
          ],
          "range": "uri",
          "@type": "SlotDefinition"
        },
        {
          "name": "URL_Date",
          "description": "The date on which the address was last seen to work.",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "Alt_URL",
          "description": "Another address of the source, usually one with fewer restrictions.",
          "range": "uri",
          "@type": "SlotDefinition"
        },
        {
          "name": "Alt_URL_Date",
          "description": "The date on which the other address was last seen to work.",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "Media_Type",
          "description": "A form the source takes.",
          "range": "CweReferenceMediaType",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Access_Restrictions",
          "description": "What stands between a reader and the source.",
          "range": "CweReferenceAccessRestriction",
          "@type": "SlotDefinition"
        },
        {
          "name": "Rationale",
          "description": "A hint at why the source was cited.",
          "range": "CweReferenceRationale",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/cwe/CweExternalReference",
      "@type": "ClassDefinition"
    },
    {
      "name": "CweReference",
      "definition_uri": "https://w3id.org/lmodel/cwe/CweReference",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "ReferencesType/Reference",
          "@type": "Annotation"
        }
      ],
      "description": "A citation of an external reference from an entry or from one of its parts.",
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_core",
      "slots": [
        "cweReference__External_Reference_ID",
        "cweReference__Section"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "External_Reference_ID",
          "description": "The external reference being cited.",
          "range": "CweExternalReference",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Section",
          "description": "The section or page of the source that this citation means.",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/cwe/CweReference",
      "@type": "ClassDefinition"
    },
    {
      "name": "CweDimension",
      "definition_uri": "https://w3id.org/lmodel/cwe/CweDimension",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "DimensionElementType",
          "@type": "Annotation"
        }
      ],
      "description": "One aspect of a weakness, or of how two weaknesses differ, named in a word or two.",
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_core",
      "slots": [
        "cweDimension__Type",
        "cweDimension__Value"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Type",
          "description": "The kind of aspect, such as a behaviour or a resource.",
          "range": "CweDimensionType",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Value",
          "annotations": [
            {
              "tag": "xsd_text_of",
              "value": "xs:string",
              "@type": "Annotation"
            }
          ],
          "description": "The aspect itself, such as Generation or Page.",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/cwe/CweDimension",
      "@type": "ClassDefinition"
    },
    {
      "name": "CweCustomPhase",
      "definition_uri": "https://w3id.org/lmodel/cwe/CweCustomPhase",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "CustomPhaseType",
          "@type": "Annotation"
        }
      ],
      "description": "A life cycle stage from a field whose stages differ from those of software.",
      "comments": [
        "XML Schema cannot tie the value to the domain, as a comment in the XSD regrets, so the XSD takes either list under either domain. The rules below state what it means, and tests/test_schema_rules.py holds their lists to the two enums."
      ],
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_core",
      "slots": [
        "cweCustomPhase__Domain",
        "cweCustomPhase__Value"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Domain",
          "description": "The field whose life cycle the stage belongs to.",
          "range": "CweCustomPhaseDomain",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Value",
          "annotations": [
            {
              "tag": "xsd_text_of",
              "value": "CustomPhaseEnumeration",
              "@type": "Annotation"
            }
          ],
          "description": "The stage.",
          "required": true,
          "any_of": [
            {
              "range": "CweAiPhase",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "CweHardwarePhase",
              "@type": "AnonymousSlotExpression"
            }
          ],
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/cwe/CweCustomPhase",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "Domain",
                "equals_string": "AI",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "Value",
                "equals_string_in": [
                  "Data Collection",
                  "Training",
                  "Fine-tuning",
                  "Testing",
                  "Tokenization",
                  "Prompting",
                  "Output Processing",
                  "Component Interaction",
                  "Re-training / Feedback"
                ],
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "A stage in the AI domain comes from the AI list.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "Domain",
                "equals_string": "Hardware",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "Value",
                "equals_string_in": [
                  "Hardware Requirements",
                  "Hardware Architecture",
                  "Hardware Microarchitecture",
                  "Implementation & Physical Design",
                  "Pre-Manufacturing Verification",
                  "Hardware Manufacturing",
                  "Post-Manufacturing Validation",
                  "Device Configuration & Personalization",
                  "Device / System Integration",
                  "Field Operations & Sustainment",
                  "Reuse",
                  "Decommissioning"
                ],
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "A stage in the Hardware domain comes from the hardware list.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "CweNote",
      "definition_uri": "https://w3id.org/lmodel/cwe/CweNote",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "NotesType/Note",
          "@type": "Annotation"
        }
      ],
      "description": "A remark on an entry that fits nowhere else.",
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_core",
      "slots": [
        "cweNote__Type",
        "cweNote__Version",
        "cweNote__ReleaseDate",
        "cweNote__Value"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Type",
          "description": "What the note is about.",
          "range": "CweNoteType",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Version",
          "description": "The CWE version the note belongs to.",
          "@type": "SlotDefinition"
        },
        {
          "name": "ReleaseDate",
          "description": "The release date of that version.",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "Value",
          "annotations": [
            {
              "tag": "xsd_text_of",
              "value": "StructuredTextType",
              "@type": "Annotation"
            }
          ],
          "description": "The text of the note.",
          "range": "cwe_structured_text",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/cwe/CweNote",
      "@type": "ClassDefinition"
    },
    {
      "name": "CweTaxonomyMapping",
      "definition_uri": "https://w3id.org/lmodel/cwe/CweTaxonomyMapping",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "TaxonomyMappingsType/Taxonomy_Mapping",
          "@type": "Annotation"
        }
      ],
      "description": "A link from an entry to an entry of another taxonomy.",
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_core",
      "slots": [
        "cweTaxonomyMapping__Taxonomy_Name",
        "cweTaxonomyMapping__Entry_ID",
        "cweTaxonomyMapping__Entry_Name",
        "cweTaxonomyMapping__Mapping_Fit"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Taxonomy_Name",
          "description": "The other taxonomy.",
          "range": "CweTaxonomyName",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Entry_ID",
          "description": "The identifier of the entry in the other taxonomy.",
          "@type": "SlotDefinition"
        },
        {
          "name": "Entry_Name",
          "description": "The name of the entry in the other taxonomy.",
          "@type": "SlotDefinition"
        },
        {
          "name": "Mapping_Fit",
          "description": "How closely the two entries match.",
          "range": "CweMappingFit",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/cwe/CweTaxonomyMapping",
      "@type": "ClassDefinition"
    },
    {
      "name": "CweContentHistory",
      "definition_uri": "https://w3id.org/lmodel/cwe/CweContentHistory",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "ContentHistoryType",
          "@type": "Annotation"
        }
      ],
      "description": "The record of who wrote an entry and how it has changed since.",
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_core",
      "slots": [
        "cweContentHistory__Submission",
        "cweContentHistory__Modification",
        "cweContentHistory__Contribution",
        "cweContentHistory__Previous_Entry_Name"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Submission",
          "description": "The original submission of the entry, or each of several.",
          "close_mappings": [
            "sepses_cwe:hasSubmissionHistory"
          ],
          "range": "CweSubmission",
          "required": true,
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Modification",
          "description": "A change made to the entry.",
          "close_mappings": [
            "sepses_cwe:hasModificationHistory",
            "skos:changeNote"
          ],
          "range": "CweModification",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Contribution",
          "description": "Feedback or content that someone gave to the entry.",
          "range": "CweContribution",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Previous_Entry_Name",
          "description": "A name the entry used to have.",
          "range": "CwePreviousEntryName",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/cwe/CweContentHistory",
      "@type": "ClassDefinition"
    },
    {
      "name": "CweSubmission",
      "definition_uri": "https://w3id.org/lmodel/cwe/CweSubmission",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "ContentHistoryType/Submission",
          "@type": "Annotation"
        }
      ],
      "description": "Who first submitted an entry, and when it joined the list.",
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_core",
      "close_mappings": [
        "sepses_cwe:SubmissionHistory"
      ],
      "slots": [
        "cweSubmission__Submission_Name",
        "cweSubmission__Submission_Organization",
        "cweSubmission__Submission_Date",
        "cweSubmission__Submission_Version",
        "cweSubmission__Submission_ReleaseDate",
        "cweSubmission__Submission_Comment"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Submission_Name",
          "description": "A person or group who submitted the entry.",
          "exact_mappings": [
            "sepses_cwe:submissionName"
          ],
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Submission_Organization",
          "description": "The organization the submitter belongs to.",
          "exact_mappings": [
            "sepses_cwe:submissionOrganization"
          ],
          "@type": "SlotDefinition"
        },
        {
          "name": "Submission_Date",
          "description": "The date of the submission.",
          "exact_mappings": [
            "sepses_cwe:submissionDate"
          ],
          "range": "date",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Submission_Version",
          "description": "The first CWE version that held the submission.",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Submission_ReleaseDate",
          "description": "The release date of that version.",
          "range": "date",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Submission_Comment",
          "description": "A remark on the submission.",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/cwe/CweSubmission",
      "any_of": [
        {
          "slot_conditions": [
            {
              "name": "Submission_Name",
              "required": true,
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        },
        {
          "slot_conditions": [
            {
              "name": "Submission_Organization",
              "required": true,
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "CweModification",
      "definition_uri": "https://w3id.org/lmodel/cwe/CweModification",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "ContentHistoryType/Modification",
          "@type": "Annotation"
        }
      ],
      "description": "One change made to an entry.",
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_core",
      "close_mappings": [
        "sepses_cwe:ModificationHistory"
      ],
      "slots": [
        "cweModification__Modification_Name",
        "cweModification__Modification_Organization",
        "cweModification__Modification_Date",
        "cweModification__Modification_Version",
        "cweModification__Modification_ReleaseDate",
        "cweModification__Modification_Importance",
        "cweModification__Modification_Comment"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Modification_Name",
          "description": "The person who made or suggested the change.",
          "exact_mappings": [
            "sepses_cwe:modificationName"
          ],
          "@type": "SlotDefinition"
        },
        {
          "name": "Modification_Organization",
          "description": "The organization that person belongs to.",
          "exact_mappings": [
            "sepses_cwe:modificationOrganization"
          ],
          "@type": "SlotDefinition"
        },
        {
          "name": "Modification_Date",
          "description": "The date of the change.",
          "exact_mappings": [
            "sepses_cwe:modificationDate"
          ],
          "range": "date",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Modification_Version",
          "description": "The first CWE version that held the change.",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Modification_ReleaseDate",
          "description": "The release date of that version.",
          "range": "date",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Modification_Importance",
          "description": "How much the change matters to people who rely on the entry.",
          "range": "CweImportance",
          "@type": "SlotDefinition"
        },
        {
          "name": "Modification_Comment",
          "description": "What changed.",
          "exact_mappings": [
            "sepses_cwe:modificationComment"
          ],
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/cwe/CweModification",
      "@type": "ClassDefinition"
    },
    {
      "name": "CweContribution",
      "definition_uri": "https://w3id.org/lmodel/cwe/CweContribution",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "ContentHistoryType/Contribution",
          "@type": "Annotation"
        }
      ],
      "description": "Feedback or content that someone gave to an entry.",
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_core",
      "slots": [
        "cweContribution__Type",
        "cweContribution__Contribution_Name",
        "cweContribution__Contribution_Organization",
        "cweContribution__Contribution_Date",
        "cweContribution__Contribution_Version",
        "cweContribution__Contribution_ReleaseDate",
        "cweContribution__Contribution_Comment"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Type",
          "description": "Whether the contribution was feedback or content.",
          "range": "CweContributionType",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Contribution_Name",
          "description": "A person or group who contributed.",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Contribution_Organization",
          "description": "The organization the contributor belongs to.",
          "@type": "SlotDefinition"
        },
        {
          "name": "Contribution_Date",
          "description": "The date of the contribution.",
          "range": "date",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Contribution_Version",
          "description": "The first CWE version that held the contribution.",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Contribution_ReleaseDate",
          "description": "The release date of that version.",
          "range": "date",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Contribution_Comment",
          "description": "A remark on the contribution.",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/cwe/CweContribution",
      "@type": "ClassDefinition"
    },
    {
      "name": "CwePreviousEntryName",
      "definition_uri": "https://w3id.org/lmodel/cwe/CwePreviousEntryName",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "ContentHistoryType/Previous_Entry_Name",
          "@type": "Annotation"
        }
      ],
      "description": "A name an entry had before.",
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_core",
      "slots": [
        "cwePreviousEntryName__Date",
        "cwePreviousEntryName__Version",
        "cwePreviousEntryName__Value"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Date",
          "description": "The date the name stopped being used.",
          "range": "date",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Version",
          "description": "The CWE version in which the name changed.",
          "@type": "SlotDefinition"
        },
        {
          "name": "Value",
          "annotations": [
            {
              "tag": "xsd_text_of",
              "value": "xs:string",
              "@type": "Annotation"
            }
          ],
          "description": "The earlier name.",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/cwe/CwePreviousEntryName",
      "@type": "ClassDefinition"
    },
    {
      "name": "CweEntry",
      "definition_uri": "https://w3id.org/lmodel/cwe/CweEntry",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "WeaknessType GroupingType ViewType",
          "@type": "Annotation"
        }
      ],
      "description": "Any item of the CWE List that has an identifier of its own: a weakness, a grouping or a view.",
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_entries",
      "see_also": [
        "https://cwe.mitre.org/documents/glossary/index.html#Entry"
      ],
      "abstract": true,
      "slots": [
        "cweEntry__ID",
        "cweEntry__Name",
        "cweEntry__Status",
        "cweEntry__References",
        "cweEntry__Mapping_Notes",
        "cweEntry__Notes",
        "cweEntry__Content_History"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "ID",
          "description": "The number that identifies the entry across the whole list.",
          "comments": [
            "Wikidata's P3624 holds this number for a weakness, without the CWE- prefix. lmodel/cve's cweId and lmodel/kev-catalog's cwes write the same number with the prefix, as CWE-79, so they are related."
          ],
          "close_mappings": [
            "wdt:P3624",
            "schema:termCode"
          ],
          "related_mappings": [
            "cve:cweId",
            "kev_catalog:cwes"
          ],
          "identifier": true,
          "range": "cwe_entry_id",
          "@type": "SlotDefinition"
        },
        {
          "name": "Name",
          "description": "The name of the entry.",
          "close_mappings": [
            "schema:name",
            "skos:prefLabel"
          ],
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Status",
          "description": "How far the entry has come and how much it can be trusted.",
          "exact_mappings": [
            "sepses_cwe:status"
          ],
          "range": "CweStatus",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "References",
          "description": "The external references the entry cites.",
          "close_mappings": [
            "sepses_cwe:hasReference"
          ],
          "range": "CweReference",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Mapping_Notes",
          "description": "Guidance on whether to map a real vulnerability to this entry.",
          "range": "CweMappingNotes",
          "required": true,
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Notes",
          "description": "Remarks on the entry that fit nowhere else.",
          "close_mappings": [
            "skos:note"
          ],
          "range": "CweNote",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Content_History",
          "description": "Who wrote the entry and how it has changed since.",
          "range": "CweContentHistory",
          "required": true,
          "inlined": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/cwe/CweEntry",
      "@type": "ClassDefinition"
    },
    {
      "name": "CweWeakness",
      "definition_uri": "https://w3id.org/lmodel/cwe/CweWeakness",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "WeaknessType",
          "@type": "Annotation"
        }
      ],
      "description": "A type of mistake or condition in software, firmware, hardware or a service that can leave a product open to attack.",
      "comments": [
        "The SPDX external reference type names a weakness as a target of a link, and an NVD weakness names one as the cause of a vulnerability, so both are related."
      ],
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_entries",
      "see_also": [
        "https://cwe.mitre.org/documents/glossary/index.html#Weakness"
      ],
      "close_mappings": [
        "sepses_cwe:CWE",
        "schema:DefinedTerm",
        "skos:Concept"
      ],
      "related_mappings": [
        "spdx_core:ExternalRefType/cwe",
        "nist_nvd:NvdWeakness"
      ],
      "is_a": "CweEntry",
      "slots": [
        "cweEntry__ID",
        "cweEntry__Name",
        "cweEntry__Status",
        "cweEntry__References",
        "cweEntry__Mapping_Notes",
        "cweEntry__Notes",
        "cweEntry__Content_History",
        "cweWeakness__Abstraction",
        "cweWeakness__Structure",
        "cweWeakness__Diagram",
        "cweWeakness__Description",
        "cweWeakness__Extended_Description",
        "cweWeakness__Technical_Nuance",
        "cweWeakness__Dimensions",
        "cweWeakness__Related_Weaknesses",
        "cweWeakness__Weakness_Ordinalities",
        "cweWeakness__Applicable_Platforms",
        "cweWeakness__Background_Details",
        "cweWeakness__Alternate_Terms",
        "cweWeakness__Modes_Of_Introduction",
        "cweWeakness__Exploitation_Factors",
        "cweWeakness__Likelihood_Of_Exploit",
        "cweWeakness__Common_Consequences",
        "cweWeakness__Detection_Methods",
        "cweWeakness__Potential_Mitigations",
        "cweWeakness__Demonstrative_Examples",
        "cweWeakness__Observed_Examples",
        "cweWeakness__Functional_Areas",
        "cweWeakness__Affected_Resources",
        "cweWeakness__Taxonomy_Mappings",
        "cweWeakness__Related_Attack_Patterns"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Abstraction",
          "description": "How far the weakness is described in general terms or tied to a specific product.",
          "exact_mappings": [
            "sepses_cwe:abstraction"
          ],
          "range": "CweAbstraction",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Structure",
          "description": "Whether the weakness stands alone or is made up of others.",
          "exact_mappings": [
            "sepses_cwe:structure"
          ],
          "range": "CweStructure",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Diagram",
          "description": "The path on MITRE's site of a diagram of the weakness.",
          "@type": "SlotDefinition"
        },
        {
          "name": "Description",
          "description": "A sentence or two that define the weakness.",
          "close_mappings": [
            "dcterms:description",
            "schema:description",
            "skos:definition"
          ],
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Extended_Description",
          "description": "More about the weakness than its short description gives.",
          "exact_mappings": [
            "sepses_cwe:extendedDescription"
          ],
          "range": "cwe_structured_text",
          "@type": "SlotDefinition"
        },
        {
          "name": "Technical_Nuance",
          "description": "Finer technical detail that helps tell this weakness from close relatives.",
          "range": "cwe_structured_text",
          "@type": "SlotDefinition"
        },
        {
          "name": "Dimensions",
          "description": "The aspects of the weakness that this entry centres on.",
          "range": "CweDimension",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Related_Weaknesses",
          "description": "How this weakness relates to others in the list.",
          "close_mappings": [
            "sepses_cwe:hasRelatedWeakness"
          ],
          "related_mappings": [
            "skos:semanticRelation"
          ],
          "range": "CweRelatedWeakness",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Weakness_Ordinalities",
          "description": "Whether the weakness tends to be a first cause or the result of another.",
          "range": "CweWeaknessOrdinality",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Applicable_Platforms",
          "description": "The languages, systems, architectures and technologies where the weakness can appear.",
          "close_mappings": [
            "sepses_cwe:hasApplicablePlatform"
          ],
          "range": "CweApplicablePlatforms",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Background_Details",
          "description": "Background that helps a reader but does not describe the weakness itself.",
          "close_mappings": [
            "sepses_cwe:backgroundDetail"
          ],
          "range": "cwe_structured_text",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Alternate_Terms",
          "description": "Other names people use for the weakness.",
          "range": "CweAlternateTerm",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Modes_Of_Introduction",
          "description": "How and when the weakness can get into a product.",
          "close_mappings": [
            "sepses_cwe:hasModeOfIntroduction"
          ],
          "range": "CweIntroduction",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Exploitation_Factors",
          "description": "Conditions that make exploiting the weakness more likely.",
          "range": "cwe_structured_text",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Likelihood_Of_Exploit",
          "description": "How likely it is that the weakness gets exploited.",
          "exact_mappings": [
            "sepses_cwe:likelihoodOfExploit"
          ],
          "range": "CweLikelihood",
          "@type": "SlotDefinition"
        },
        {
          "name": "Common_Consequences",
          "description": "What can follow when the weakness is exploited.",
          "close_mappings": [
            "sepses_cwe:hasCommonConsequence"
          ],
          "range": "CweConsequence",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Detection_Methods",
          "description": "Ways of finding the weakness, with what each is good for.",
          "close_mappings": [
            "sepses_cwe:hasDetectionMethod"
          ],
          "range": "CweDetectionMethod",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Potential_Mitigations",
          "description": "Ways of preventing the weakness or reducing what it can do.",
          "close_mappings": [
            "sepses_cwe:hasPotentialMitigation"
          ],
          "range": "CweMitigation",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Demonstrative_Examples",
          "description": "Worked examples of how the weakness looks in code.",
          "range": "CweDemonstrativeExample",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Observed_Examples",
          "description": "Real cases of the weakness, usually CVE records.",
          "range": "CweObservedExample",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Functional_Areas",
          "description": "The parts of a product where the weakness tends to appear.",
          "range": "CweFunctionalArea",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Affected_Resources",
          "description": "The system resources that exploiting the weakness can affect.",
          "range": "CweResource",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Taxonomy_Mappings",
          "description": "Links to entries of other taxonomies.",
          "range": "CweTaxonomyMapping",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Related_Attack_Patterns",
          "description": "Attack patterns that may apply where the weakness is present.",
          "close_mappings": [
            "sepses_cwe:hasCAPEC"
          ],
          "range": "CweRelatedAttackPattern",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/cwe/CweWeakness",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "Abstraction",
                "equals_string": "Compound",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "Structure",
                "none_of": [
                  {
                    "equals_string": "Simple",
                    "@type": "AnonymousSlotExpression"
                  }
                ],
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "A compound weakness is a chain or a composite.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "Structure",
                "equals_string": "Chain",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "Abstraction",
                "equals_string": "Compound",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "A chain is a compound weakness.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "Structure",
                "equals_string": "Composite",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "Abstraction",
                "equals_string": "Compound",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "A composite is a compound weakness.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "CweGrouping",
      "definition_uri": "https://w3id.org/lmodel/cwe/CweGrouping",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "GroupingType",
          "@type": "Annotation"
        }
      ],
      "description": "A set of weaknesses gathered by something they share, for browsing and not for mapping real vulnerabilities to. Schema versions before 8.0 called it a category.",
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_entries",
      "close_mappings": [
        "skos:Collection"
      ],
      "is_a": "CweEntry",
      "slots": [
        "cweEntry__ID",
        "cweEntry__Name",
        "cweEntry__Status",
        "cweEntry__References",
        "cweEntry__Mapping_Notes",
        "cweEntry__Notes",
        "cweEntry__Content_History",
        "cweGrouping__Summary",
        "cweGrouping__Relationships",
        "cweGrouping__Taxonomy_Mappings"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Summary",
          "description": "What the grouped weaknesses have in common.",
          "close_mappings": [
            "dcterms:description"
          ],
          "range": "cwe_structured_text",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Relationships",
          "description": "The entries this grouping holds.",
          "range": "CweRelationships",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Taxonomy_Mappings",
          "description": "Links to entries of other taxonomies.",
          "range": "CweTaxonomyMapping",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/cwe/CweGrouping",
      "@type": "ClassDefinition"
    },
    {
      "name": "CweView",
      "definition_uri": "https://w3id.org/lmodel/cwe/CweView",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "ViewType",
          "@type": "Annotation"
        }
      ],
      "description": "A way of looking at the catalogue, as a subset of its entries seen from one standpoint.",
      "comments": [
        "A graph view arranges concepts as a scheme does, but a slice is a flat list, so the SKOS concept scheme is only related."
      ],
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_entries",
      "see_also": [
        "https://cwe.mitre.org/documents/glossary/index.html#View"
      ],
      "related_mappings": [
        "skos:ConceptScheme"
      ],
      "is_a": "CweEntry",
      "slots": [
        "cweEntry__ID",
        "cweEntry__Name",
        "cweEntry__Status",
        "cweEntry__References",
        "cweEntry__Mapping_Notes",
        "cweEntry__Notes",
        "cweEntry__Content_History",
        "cweView__Type",
        "cweView__Objective",
        "cweView__Audience",
        "cweView__Members",
        "cweView__Filter"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Type",
          "description": "How the view selects and arranges its entries.",
          "range": "CweViewType",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Objective",
          "description": "What the view is for.",
          "close_mappings": [
            "dcterms:description"
          ],
          "range": "cwe_structured_text",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Audience",
          "description": "The people who may find the view useful, and why.",
          "range": "CweStakeholder",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Members",
          "description": "The entries a view names one by one, when it is not selected by a filter.",
          "range": "CweRelationships",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Filter",
          "description": "The XPath expression that selects the entries of an implicit slice.",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/cwe/CweView",
      "@type": "ClassDefinition"
    },
    {
      "name": "CweRelatedWeakness",
      "definition_uri": "https://w3id.org/lmodel/cwe/CweRelatedWeakness",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "RelatedWeaknessesType/Related_Weakness",
          "@type": "Annotation"
        }
      ],
      "description": "A link from a weakness to another weakness, in one view.",
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_entries",
      "close_mappings": [
        "sepses_cwe:RelatedWeakness"
      ],
      "slots": [
        "cweRelatedWeakness__Nature",
        "cweRelatedWeakness__CWE_ID",
        "cweRelatedWeakness__View_ID",
        "cweRelatedWeakness__Chain_ID",
        "cweRelatedWeakness__Ordinal",
        "cweRelatedWeakness__Dimensions"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Nature",
          "description": "How the two weaknesses relate.",
          "exact_mappings": [
            "sepses_cwe:relatedWeaknessNature"
          ],
          "range": "CweRelatedNature",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "CWE_ID",
          "description": "The weakness at the other end of the link.",
          "exact_mappings": [
            "sepses_cwe:relatedCWE"
          ],
          "range": "CweWeakness",
          "required": true,
          "pattern": "^[1-9][0-9]*$",
          "@type": "SlotDefinition"
        },
        {
          "name": "View_ID",
          "description": "The view in which the link holds.",
          "exact_mappings": [
            "sepses_cwe:relatedWeaknessViewId"
          ],
          "range": "CweView",
          "required": true,
          "pattern": "^[1-9][0-9]*$",
          "@type": "SlotDefinition"
        },
        {
          "name": "Chain_ID",
          "description": "The named chain that the link belongs to.",
          "range": "CweWeakness",
          "pattern": "^[1-9][0-9]*$",
          "@type": "SlotDefinition"
        },
        {
          "name": "Ordinal",
          "description": "Marks this as the link to prefer in the view.",
          "exact_mappings": [
            "sepses_cwe:relatedWeaknessOrdinal"
          ],
          "range": "CweOrdinal",
          "@type": "SlotDefinition"
        },
        {
          "name": "Dimensions",
          "description": "The aspects in which the two weaknesses differ.",
          "range": "CweDimension",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/cwe/CweRelatedWeakness",
      "@type": "ClassDefinition"
    },
