{
  "name": "cwe",
  "annotations": [
    {
      "tag": "xsd_version",
      "value": "8.0"
    },
    {
      "tag": "xsd_namespace",
      "value": "http://cwe.mitre.org/cwe-8"
    },
    {
      "tag": "xsd_date",
      "value": "2026-10-28"
    }
  ],
  "description": "A LinkML model of the Common Weakness Enumeration, the catalogue of software and hardware weakness types that The MITRE Corporation publishes for the CWE Program. It renders the catalogue's XML Schema with its own element names and values, so the whole catalogue validates with both unchanged.",
  "title": "Common Weakness Enumeration (CWE) List and Schema",
  "comments": [
    "The version is the edition of the CWE List that the schema renders, which is the first edition under XML Schema 8.0. upstream/ holds both files unchanged, tests/test_coverage.py holds the schema to the XSD, and scripts/check_upstream_release.py reports when either moves.",
    "The file behind the cwe_schema_latest.xsd link is an earlier copy of 8.0, which the catalogue breaks in 69 places. The source above is the file the catalogue itself names, and it validates with no error."
  ],
  "source": "https://cwe.mitre.org/data/xsd/cwe_schema_v8.0.xsd",
  "see_also": [
    "https://lmodel.github.io/cwe",
    "https://cwe.mitre.org/"
  ],
  "keywords": [
    "weakness",
    "CWE",
    "root cause mapping",
    "software weakness",
    "hardware weakness",
    "secure coding"
  ],
  "id": "https://w3id.org/lmodel/cwe",
  "version": "5.0",
  "imports": [
    "linkml:types",
    "./cwe_core",
    "./cwe_entries"
  ],
  "license": "Apache-2.0",
  "prefixes": [
    {
      "prefix_prefix": "cwe",
      "prefix_reference": "https://w3id.org/lmodel/cwe/"
    },
    {
      "prefix_prefix": "linkml",
      "prefix_reference": "https://w3id.org/linkml/"
    },
    {
      "prefix_prefix": "schema",
      "prefix_reference": "http://schema.org/"
    },
    {
      "prefix_prefix": "skos",
      "prefix_reference": "http://www.w3.org/2004/02/skos/core#"
    },
    {
      "prefix_prefix": "wd",
      "prefix_reference": "http://www.wikidata.org/entity/"
    }
  ],
  "default_prefix": "cwe",
  "default_range": "string",
  "types": [
    {
      "name": "string",
      "definition_uri": "https://w3id.org/linkml/String",
      "description": "A character string",
      "notes": [
        "In RDF serializations, a slot with range of string is treated as a literal or type xsd:string. If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"string\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:Text"
      ],
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "@type": "TypeDefinition"
    },
    {
      "name": "integer",
      "definition_uri": "https://w3id.org/linkml/Integer",
      "description": "An integer",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"integer\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:Integer"
      ],
      "base": "int",
      "uri": "http://www.w3.org/2001/XMLSchema#integer",
      "@type": "TypeDefinition"
    },
    {
      "name": "boolean",
      "definition_uri": "https://w3id.org/linkml/Boolean",
      "description": "A binary (true or false) value",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"boolean\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:Boolean"
      ],
      "base": "Bool",
      "uri": "http://www.w3.org/2001/XMLSchema#boolean",
      "repr": "bool",
      "@type": "TypeDefinition"
    },
    {
      "name": "float",
      "definition_uri": "https://w3id.org/linkml/Float",
      "description": "A real number that conforms to the xsd:float specification",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"float\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:Float"
      ],
      "base": "float",
      "uri": "http://www.w3.org/2001/XMLSchema#float",
      "@type": "TypeDefinition"
    },
    {
      "name": "double",
      "definition_uri": "https://w3id.org/linkml/Double",
      "description": "A real number that conforms to the xsd:double specification",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"double\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "close_mappings": [
        "schema:Float"
      ],
      "base": "float",
      "uri": "http://www.w3.org/2001/XMLSchema#double",
      "@type": "TypeDefinition"
    },
    {
      "name": "decimal",
      "definition_uri": "https://w3id.org/linkml/Decimal",
      "description": "A real number with arbitrary precision that conforms to the xsd:decimal specification",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"decimal\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "broad_mappings": [
        "schema:Number"
      ],
      "base": "Decimal",
      "uri": "http://www.w3.org/2001/XMLSchema#decimal",
      "@type": "TypeDefinition"
    },
    {
      "name": "time",
      "definition_uri": "https://w3id.org/linkml/Time",
      "description": "A time object represents a (local) time of day, independent of any particular day",
      "notes": [
        "URI is dateTime because OWL reasoners do not work with straight date or time",
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"time\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:Time"
      ],
      "base": "XSDTime",
      "uri": "http://www.w3.org/2001/XMLSchema#time",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "date",
      "definition_uri": "https://w3id.org/linkml/Date",
      "description": "a date (year, month and day) in an idealized calendar",
      "notes": [
        "URI is dateTime because OWL reasoners don't work with straight date or time",
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"date\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:Date"
      ],
      "base": "XSDDate",
      "uri": "http://www.w3.org/2001/XMLSchema#date",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "datetime",
      "definition_uri": "https://w3id.org/linkml/Datetime",
      "description": "The combination of a date and time",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"datetime\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:DateTime"
      ],
      "base": "XSDDateTime",
      "uri": "http://www.w3.org/2001/XMLSchema#dateTime",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "date_or_datetime",
      "definition_uri": "https://w3id.org/linkml/DateOrDatetime",
      "description": "Either a date or a datetime",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"date_or_datetime\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "str",
      "uri": "https://w3id.org/linkml/DateOrDatetime",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "uriorcurie",
      "definition_uri": "https://w3id.org/linkml/Uriorcurie",
      "description": "a URI or a CURIE",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"uriorcurie\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "URIorCURIE",
      "uri": "http://www.w3.org/2001/XMLSchema#anyURI",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "curie",
      "definition_uri": "https://w3id.org/linkml/Curie",
      "conforms_to": "https://www.w3.org/TR/curie/",
      "description": "a compact URI",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"curie\"."
      ],
      "comments": [
        "in RDF serializations this MUST be expanded to a URI",
        "in non-RDF serializations MAY be serialized as the compact representation"
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "Curie",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "uri",
      "definition_uri": "https://w3id.org/linkml/Uri",
      "conforms_to": "https://www.ietf.org/rfc/rfc3987.txt",
      "description": "a complete URI",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"uri\"."
      ],
      "comments": [
        "in RDF serializations a slot with range of uri is treated as a literal or type xsd:anyURI unless it is an identifier or a reference to an identifier, in which case it is translated directly to a node"
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "close_mappings": [
        "schema:URL"
      ],
      "base": "URI",
      "uri": "http://www.w3.org/2001/XMLSchema#anyURI",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "ncname",
      "definition_uri": "https://w3id.org/linkml/Ncname",
      "description": "Prefix part of CURIE",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"ncname\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "NCName",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "objectidentifier",
      "definition_uri": "https://w3id.org/linkml/Objectidentifier",
      "description": "A URI or CURIE that represents an object in the model.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"objectidentifier\"."
      ],
      "comments": [
        "Used for inheritance and type checking"
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "ElementIdentifier",
      "uri": "http://www.w3.org/ns/shex#iri",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "nodeidentifier",
      "definition_uri": "https://w3id.org/linkml/Nodeidentifier",
      "description": "A URI, CURIE or BNODE that represents a node in a model.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"nodeidentifier\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "NodeIdentifier",
      "uri": "http://www.w3.org/ns/shex#nonLiteral",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "jsonpointer",
      "definition_uri": "https://w3id.org/linkml/Jsonpointer",
      "conforms_to": "https://datatracker.ietf.org/doc/html/rfc6901",
      "description": "A string encoding a JSON Pointer. The value of the string MUST conform to JSON Point syntax and SHOULD dereference to a valid object within the current instance document when encoded in tree form.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"jsonpointer\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "jsonpath",
      "definition_uri": "https://w3id.org/linkml/Jsonpath",
      "conforms_to": "https://www.ietf.org/archive/id/draft-goessner-dispatch-jsonpath-00.html",
      "description": "A string encoding a JSON Path. The value of the string MUST conform to JSON Point syntax and SHOULD dereference to zero or more valid objects within the current instance document when encoded in tree form.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"jsonpath\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "sparqlpath",
      "definition_uri": "https://w3id.org/linkml/Sparqlpath",
      "conforms_to": "https://www.w3.org/TR/sparql11-query/#propertypaths",
      "description": "A string encoding a SPARQL Property Path. The value of the string MUST conform to SPARQL syntax and SHOULD dereference to zero or more valid objects within the current instance document when encoded as RDF.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"sparqlpath\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "cwe_entry_id",
      "definition_uri": "https://w3id.org/lmodel/cwe/CweEntryId",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "xs:integer",
          "@type": "Annotation"
        }
      ],
      "description": "The number that identifies an entry of the CWE List, written as text, such as 79.",
      "comments": [
        "The XSD types it as an integer. It stays a string because LinkML's RDF dumper needs an identifier it can expand, and the catalogue's XML holds text anyway."
      ],
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_core",
      "typeof": "string",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "pattern": "^[1-9][0-9]*$",
      "@type": "TypeDefinition"
    },
    {
      "name": "cwe_capec_id",
      "definition_uri": "https://w3id.org/lmodel/cwe/CweCapecId",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "xs:integer",
          "@type": "Annotation"
        }
      ],
      "description": "The number of an attack pattern in the CAPEC list, written as text, such as 63.",
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_core",
      "typeof": "string",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "pattern": "^[1-9][0-9]*$",
      "@type": "TypeDefinition"
    },
    {
      "name": "cwe_reference_id",
      "definition_uri": "https://w3id.org/lmodel/cwe/CweReferenceId",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "xs:string",
          "@type": "Annotation"
        }
      ],
      "description": "The identifier of an external reference in the catalogue, such as REF-1.",
      "comments": [
        "The XSD types it as a string with no pattern. CWE 5.0 writes REF and a number on all but one, whose identifier is the bare number 1300."
      ],
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_core",
      "typeof": "string",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "@type": "TypeDefinition"
    },
    {
      "name": "cwe_structured_text",
      "definition_uri": "https://w3id.org/lmodel/cwe/CweStructuredText",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "StructuredTextType",
          "@type": "Annotation"
        }
      ],
      "description": "Text that may hold XHTML markup, kept as a well-formed fragment without the namespace prefix and with its special characters escaped.",
      "comments": [
        "A consumer that shows this text as HTML must sanitize it first, since it can quote attack strings."
      ],
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_core",
      "typeof": "string",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "@type": "TypeDefinition"
    },
    {
      "name": "cwe_publication_year",
      "definition_uri": "https://w3id.org/lmodel/cwe/CwePublicationYear",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "xs:gYear",
          "@type": "Annotation"
        }
      ],
      "description": "A year in XML Schema's form, such as 2021.",
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_core",
      "typeof": "string",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#gYear",
      "pattern": "^-?[0-9]{4,}(Z|[+-][0-9]{2}:[0-9]{2})?$",
      "@type": "TypeDefinition"
    },
    {
      "name": "cwe_publication_month",
      "definition_uri": "https://w3id.org/lmodel/cwe/CwePublicationMonth",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "xs:gMonth",
          "@type": "Annotation"
        }
      ],
      "description": "A month in XML Schema's form, two hyphens and two digits, such as --03.",
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_core",
      "typeof": "string",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#gMonth",
      "pattern": "^--(0[1-9]|1[0-2])(Z|[+-][0-9]{2}:[0-9]{2})?$",
      "@type": "TypeDefinition"
    },
    {
      "name": "cwe_publication_day",
      "definition_uri": "https://w3id.org/lmodel/cwe/CwePublicationDay",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "xs:gDay",
          "@type": "Annotation"
        }
      ],
      "description": "A day of the month in XML Schema's form, three hyphens and two digits, such as ---06.",
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_core",
      "typeof": "string",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#gDay",
      "pattern": "^---(0[1-9]|[12][0-9]|3[01])(Z|[+-][0-9]{2}:[0-9]{2})?$",
      "@type": "TypeDefinition"
    }
  ],
  "enums": [
    {
      "name": "CweAbstraction",
      "definition_uri": "https://w3id.org/lmodel/cwe/CweAbstraction",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "AbstractionEnumeration"
        }
      ],
      "description": "How far a weakness is described in general terms or tied to a specific product or resource.",
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_core",
      "permissible_values": [
        {
          "text": "Pillar",
          "description": "The most general level, a theme that the weaknesses under it share."
        },
        {
          "text": "Class",
          "description": "A very general weakness, usually independent of any language or technology."
        },
        {
          "text": "Base",
          "description": "A weakness general enough to apply widely and detailed enough to find or prevent it."
        },
        {
          "text": "Variant",
          "description": "A weakness tied to a particular language, technology or kind of product."
        },
        {
          "text": "Compound",
          "description": "An entry that ties two or more weaknesses together, as a chain or a composite."
        }
      ]
    },
    {
      "name": "CweAlternateTermRole",
      "definition_uri": "https://w3id.org/lmodel/cwe/CweAlternateTermRole",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "AlternateTermRoleEnumeration"
        }
      ],
      "description": "The part an alternate term plays when people talk about a weakness.",
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_core",
      "permissible_values": [
        {
          "text": "Abbreviation"
        },
        {
          "text": "Acronym"
        },
        {
          "text": "Alternate-Spelling"
        },
        {
          "text": "Attack-Focused"
        },
        {
          "text": "Impact-Oriented"
        },
        {
          "text": "Multi-Weakness"
        },
        {
          "text": "Multiple-Interpretation"
        },
        {
          "text": "Common-Name"
        },
        {
          "text": "Discouraged"
        },
        {
          "text": "Legacy"
        },
        {
          "text": "Other"
        }
      ]
    },
    {
      "name": "CweArchitectureClass",
      "definition_uri": "https://w3id.org/lmodel/cwe/CweArchitectureClass",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "ArchitectureClassEnumeration"
        }
      ],
      "description": "A broad family of hardware architectures.",
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_core",
      "permissible_values": [
        {
          "text": "Embedded"
        },
        {
          "text": "Microcomputer"
        },
        {
          "text": "Workstation"
        },
        {
          "text": "Not Architecture-Specific",
          "description": "The weakness can appear on many architectures."
        }
      ]
    },
    {
      "name": "CweArchitectureName",
      "definition_uri": "https://w3id.org/lmodel/cwe/CweArchitectureName",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "ArchitectureNameEnumeration"
        }
      ],
      "description": "A named hardware architecture.",
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_core",
      "permissible_values": [
        {
          "text": "Alpha"
        },
        {
          "text": "ARM"
        },
        {
          "text": "Itanium"
        },
        {
          "text": "Power Architecture"
        },
        {
          "text": "SPARC"
        },
        {
          "text": "x86"
        },
        {
          "text": "Other"
        }
      ]
    },
    {
      "name": "CweDetectionMethodName",
      "definition_uri": "https://w3id.org/lmodel/cwe/CweDetectionMethodName",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "DetectionMethodEnumeration"
        }
      ],
      "description": "A way of finding a weakness.",
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_core",
      "permissible_values": [
        {
          "text": "Automated Analysis"
        },
        {
          "text": "Automated Dynamic Analysis"
        },
        {
          "text": "Automated Static Analysis"
        },
        {
          "text": "Automated Static Analysis - Source Code"
        },
        {
          "text": "Automated Static Analysis - Binary or Bytecode"
        },
        {
          "text": "Fuzzing"
        },
        {
          "text": "Manual Analysis"
        },
        {
          "text": "Manual Dynamic Analysis"
        },
        {
          "text": "Manual Static Analysis"
        },
        {
          "text": "Manual Static Analysis - Source Code"
        },
        {
          "text": "Manual Static Analysis - Binary or Bytecode"
        },
        {
          "text": "White Box"
        },
        {
          "text": "Black Box"
        },
        {
          "text": "Architecture or Design Review"
        },
        {
          "text": "Dynamic Analysis with Manual Results Interpretation"
        },
        {
          "text": "Dynamic Analysis with Automated Results Interpretation"
        },
        {
          "text": "Formal Verification"
        },
        {
          "text": "Simulation / Emulation"
        },
        {
          "text": "Other"
        }
      ]
    },
    {
      "name": "CweDetectionEffectiveness",
      "definition_uri": "https://w3id.org/lmodel/cwe/CweDetectionEffectiveness",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "DetectionEffectivenessEnumeration"
        }
      ],
      "description": "How well a detection method finds a weakness.",
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_core",
      "permissible_values": [
        {
          "text": "High",
          "description": "It finds the weakness often and with few false reports."
        },
        {
          "text": "Moderate",
          "description": "It works in several situations but misses some forms or gives some false reports."
        },
        {
          "text": "SOAR Partial",
          "description": "The State Of the Art Report rates it as cost-effective for part of the job."
        },
        {
          "text": "Opportunistic",
          "description": "It does not aim at this weakness and finds it only by the way."
        },
        {
          "text": "Limited",
          "description": "It helps only in some situations."
        },
        {
          "text": "None",
          "description": "It does not find the weakness."
        }
      ]
    },
    {
      "name": "CweEffectiveness",
      "definition_uri": "https://w3id.org/lmodel/cwe/CweEffectiveness",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "EffectivenessEnumeration"
        }
      ],
      "description": "How well a mitigation prevents a weakness.",
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_core",
      "permissible_values": [
        {
          "text": "High",
          "description": "It often removes the weakness altogether."
        },
        {
          "text": "Moderate",
          "description": "It prevents several forms of the weakness but does not cover them all."
        },
        {
          "text": "Limited",
          "description": "It helps only in some situations or against some forms of the weakness."
        },
        {
          "text": "Incidental",
          "description": "It protects by chance and cannot be relied on."
        },
        {
          "text": "Discouraged Common Practice",
          "description": "A habit people often follow that does not work well enough to recommend."
        },
        {
          "text": "Defense in Depth",
          "description": "It adds a layer of protection and does not remove the weakness by itself."
        },
        {
          "text": "None",
          "description": "It does not prevent the weakness."
        }
      ]
    },
