      "slot_uri": "https://w3id.org/lmodel/cwe/Description",
      "alias": "Description",
      "owner": "CweStakeholder",
      "domain_of": [
        "CweStakeholder"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "cweMember__CWE_ID",
      "description": "The entry at the other end of the link.",
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_entries",
      "slot_uri": "https://w3id.org/lmodel/cwe/CWE_ID",
      "alias": "CWE_ID",
