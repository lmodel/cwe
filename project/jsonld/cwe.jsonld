      "alias": "View_ID",
      "owner": "CweMember",
      "domain_of": [
        "CweMember"
      ],
      "range": "CweView",
      "required": true,
      "pattern": "^[1-9][0-9]*$",
      "@type": "SlotDefinition"
    },
    {
      "name": "cweMember__Dimensions",
      "description": "The aspects in which the two entries differ.",
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_entries",
      "slot_uri": "https://w3id.org/lmodel/cwe/Dimensions",
      "alias": "Dimensions",
      "owner": "CweMember",
      "domain_of": [
        "CweMember"
      ],
      "range": "CweDimension",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "cweRelationships__Member_Of",
