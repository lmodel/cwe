      "slot_uri": "https://w3id.org/lmodel/cwe/Reasons",
      "alias": "Reasons",
      "owner": "CweMappingNotes",
      "domain_of": [
        "CweMappingNotes"
      ],
      "range": "CweMappingReason",
      "required": true,
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
