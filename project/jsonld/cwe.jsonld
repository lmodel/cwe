        {
          "name": "Phase",
          "description": "A life cycle stage where the method applies.",
          "range": "CwePhase",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Custom_Phase",
          "description": "A stage from the life cycle of a field such as hardware or AI.",
          "range": "CweCustomPhase",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Description",
          "description": "How the method applies to this weakness.",
          "exact_mappings": [
            "sepses_cwe:detectionDescription"
          ],
          "range": "cwe_structured_text",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Effectiveness",
          "description": "How well the method finds the weakness.",
          "exact_mappings": [
            "sepses_cwe:detectionEffectiveness"
          ],
          "range": "CweDetectionEffectiveness",
          "@type": "SlotDefinition"
        },
        {
          "name": "Effectiveness_Notes",
          "description": "The strengths and limits of the method here.",
          "exact_mappings": [
            "sepses_cwe:detectionEffectivenessNote"
          ],
          "range": "cwe_structured_text",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/cwe/CweDetectionMethod",
      "@type": "ClassDefinition"
    },
    {
      "name": "CweMitigation",
      "definition_uri": "https://w3id.org/lmodel/cwe/CweMitigation",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "PotentialMitigationsType/Mitigation",
          "@type": "Annotation"
        }
      ],
      "description": "One way of preventing a weakness or reducing what it can do.",
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_entries",
      "close_mappings": [
        "sepses_cwe:PotentialMitigation"
      ],
      "slots": [
        "cweMitigation__Mitigation_ID",
        "cweMitigation__Phase",
        "cweMitigation__Custom_Phase",
        "cweMitigation__Strategy",
        "cweMitigation__Description",
        "cweMitigation__Effectiveness",
        "cweMitigation__Effectiveness_Notes"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Mitigation_ID",
          "description": "An identifier that lets entries share this text, such as MIT-5.",
          "@type": "SlotDefinition"
        },
        {
          "name": "Phase",
          "description": "A life cycle stage where the mitigation applies.",
          "close_mappings": [
            "sepses_cwe:mitigationPhase"
          ],
          "range": "CwePhase",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Custom_Phase",
          "description": "A stage from the life cycle of a field such as hardware or AI.",
          "range": "CweCustomPhase",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Strategy",
          "description": "The general approach the mitigation follows.",
          "range": "CweMitigationStrategy",
          "@type": "SlotDefinition"
        },
        {
          "name": "Description",
          "description": "What to do, with its strengths and limits.",
          "exact_mappings": [
            "sepses_cwe:mitigationDescription"
          ],
          "range": "cwe_structured_text",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Effectiveness",
          "description": "How well the mitigation prevents the weakness.",
          "exact_mappings": [
            "sepses_cwe:mitigationEffectiveness"
          ],
          "range": "CweEffectiveness",
          "@type": "SlotDefinition"
        },
        {
          "name": "Effectiveness_Notes",
          "description": "The strengths and limits of the mitigation here.",
          "exact_mappings": [
            "sepses_cwe:mitigationEffectivenessNote"
          ],
          "range": "cwe_structured_text",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/cwe/CweMitigation",
      "@type": "ClassDefinition"
    },
    {
      "name": "CweDemonstrativeExample",
      "definition_uri": "https://w3id.org/lmodel/cwe/CweDemonstrativeExample",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "DemonstrativeExamplesType/Demonstrative_Example",
          "@type": "Annotation"
        }
      ],
      "description": "A worked example of how a weakness looks in code.",
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_entries",
      "slots": [
        "cweDemonstrativeExample__Demonstrative_Example_ID",
        "cweDemonstrativeExample__Title_Text",
        "cweDemonstrativeExample__Intro_Text",
        "cweDemonstrativeExample__Entries"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Demonstrative_Example_ID",
          "description": "An identifier that lets entries share this example, such as DX-221.",
          "@type": "SlotDefinition"
        },
        {
          "name": "Title_Text",
          "description": "A title for the example.",
          "@type": "SlotDefinition"
        },
        {
          "name": "Intro_Text",
          "description": "The setting of the code, and what it is trying to do.",
          "range": "cwe_structured_text",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Entries",
          "description": "The example's prose and code, in the order they are meant to be read.",
          "comments": [
            "The XSD gives this list no name, because it writes a repeating choice of two elements. The name is the one the CWE REST API uses, and it is the one key here that is not in the XSD."
          ],
          "range": "CweExampleEntry",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/cwe/CweDemonstrativeExample",
      "@type": "ClassDefinition"
    },
    {
      "name": "CweExampleEntry",
      "definition_uri": "https://w3id.org/lmodel/cwe/CweExampleEntry",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "DemonstrativeExamplesType/Demonstrative_Example#choice",
          "@type": "Annotation"
        }
      ],
      "description": "One step of a worked example, either some prose or some code.",
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_entries",
      "slots": [
        "cweExampleEntry__Body_Text",
        "cweExampleEntry__Example_Code"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Body_Text",
          "description": "Prose that explains the code around it.",
          "range": "cwe_structured_text",
          "@type": "SlotDefinition"
        },
        {
          "name": "Example_Code",
          "description": "A block of code.",
          "range": "CweExampleCode",
          "inlined": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/cwe/CweExampleEntry",
      "exactly_one_of": [
        {
          "slot_conditions": [
            {
              "name": "Body_Text",
              "required": true,
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        },
        {
          "slot_conditions": [
            {
              "name": "Example_Code",
              "required": true,
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "CweExampleCode",
      "definition_uri": "https://w3id.org/lmodel/cwe/CweExampleCode",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "StructuredCodeType",
          "@type": "Annotation"
        }
      ],
      "description": "A block of code in a worked example.",
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_entries",
      "slots": [
        "cweExampleCode__Nature",
        "cweExampleCode__Language",
        "cweExampleCode__Value"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Nature",
          "description": "What the code shows.",
          "range": "CweCodeNature",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Language",
          "description": "The language of the code.",
          "range": "CweLanguageName",
          "@type": "SlotDefinition"
        },
        {
          "name": "Value",
          "annotations": [
            {
              "tag": "xsd_text_of",
              "value": "StructuredTextType",
              "@type": "Annotation"
            }
          ],
          "description": "The code, as an XHTML fragment with its special characters escaped.",
          "range": "cwe_structured_text",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/cwe/CweExampleCode",
      "@type": "ClassDefinition"
    },
    {
      "name": "CweObservedExample",
      "definition_uri": "https://w3id.org/lmodel/cwe/CweObservedExample",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "ObservedExampleType/Observed_Example",
          "@type": "Annotation"
        }
      ],
      "description": "A real case of a weakness, usually a CVE record.",
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_entries",
      "slots": [
        "cweObservedExample__Reference",
        "cweObservedExample__Description",
        "cweObservedExample__Link",
        "cweObservedExample__Rationale"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Reference",
          "description": "The identifier of the case, such as a CVE identifier.",
          "comments": [
            "In CWE 5.0 it holds a CVE identifier in 3173 of 3183 cases and an external reference such as [REF-1100] in the rest, so lmodel/cve's cveId is only related."
          ],
          "related_mappings": [
            "cve:cveId"
          ],
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Description",
          "description": "What went wrong in that case, as it bears on the weakness.",
          "range": "cwe_structured_text",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Link",
          "description": "An address with more about the case.",
          "range": "uri",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Rationale",
          "description": "A hint at why this case was chosen.",
          "range": "CweObservedExampleRationale",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/cwe/CweObservedExample",
      "@type": "ClassDefinition"
    },
    {
      "name": "CweRelatedAttackPattern",
      "definition_uri": "https://w3id.org/lmodel/cwe/CweRelatedAttackPattern",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "RelatedAttackPatternsType/Related_Attack_Pattern",
          "@type": "Annotation"
        }
      ],
      "description": "A pointer from a weakness to an attack pattern in the CAPEC list.",
      "comments": [
        "CAPEC holds the same link from its own side. CWE 5.0 and CAPEC 3.9 each name the same 1212 pairs, which tests/test_catalogue.py holds, so the two classes are the two ends of one link and the mapping is related."
      ],
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_entries",
      "related_mappings": [
        "capec:CapecRelatedWeakness"
      ],
      "slots": [
        "cweRelatedAttackPattern__CAPEC_ID"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "CAPEC_ID",
          "description": "The number of the attack pattern in the CAPEC list.",
          "related_mappings": [
            "capec:CapecAttackPattern"
          ],
          "range": "cwe_capec_id",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/cwe/CweRelatedAttackPattern",
      "@type": "ClassDefinition"
    },
    {
      "name": "CweStakeholder",
      "definition_uri": "https://w3id.org/lmodel/cwe/CweStakeholder",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "AudienceType/Stakeholder",
          "@type": "Annotation"
        }
      ],
      "description": "A group of people who may find a view useful.",
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_entries",
      "slots": [
        "cweStakeholder__Type",
        "cweStakeholder__Description"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Type",
          "description": "The group.",
          "range": "CweStakeholderType",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Description",
          "description": "What in the view this group may find useful.",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/cwe/CweStakeholder",
      "@type": "ClassDefinition"
    },
    {
      "name": "CweMember",
      "definition_uri": "https://w3id.org/lmodel/cwe/CweMember",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "MemberType",
          "@type": "Annotation"
        }
      ],
      "description": "A link from a grouping or a view to an entry it holds or belongs to, in one view.",
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_entries",
      "slots": [
        "cweMember__CWE_ID",
        "cweMember__View_ID",
        "cweMember__Dimensions"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "CWE_ID",
          "description": "The entry at the other end of the link.",
          "range": "CweEntry",
          "required": true,
          "pattern": "^[1-9][0-9]*$",
          "@type": "SlotDefinition"
        },
        {
          "name": "View_ID",
          "description": "The view in which the link holds.",
          "range": "CweView",
          "required": true,
          "pattern": "^[1-9][0-9]*$",
          "@type": "SlotDefinition"
        },
        {
          "name": "Dimensions",
          "description": "The aspects in which the two entries differ.",
          "range": "CweDimension",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/cwe/CweMember",
      "@type": "ClassDefinition"
    },
    {
      "name": "CweRelationships",
      "definition_uri": "https://w3id.org/lmodel/cwe/CweRelationships",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "RelationshipsType",
          "@type": "Annotation"
        }
      ],
      "description": "The entries that a grouping or a view holds or belongs to.",
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_entries",
      "slots": [
        "cweRelationships__Member_Of",
        "cweRelationships__Has_Member"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Member_Of",
          "description": "An entry that holds this one.",
          "range": "CweMember",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Has_Member",
          "description": "An entry that this one holds.",
          "range": "CweMember",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/cwe/CweRelationships",
      "any_of": [
        {
          "slot_conditions": [
            {
              "name": "Member_Of",
              "required": true,
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        },
        {
          "slot_conditions": [
            {
              "name": "Has_Member",
              "required": true,
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "CweMappingNotes",
      "definition_uri": "https://w3id.org/lmodel/cwe/CweMappingNotes",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "MappingNotesType",
          "@type": "Annotation"
        }
      ],
      "description": "Guidance on whether to map a real vulnerability to an entry, and on what to use instead.",
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_entries",
      "slots": [
        "cweMappingNotes__Usage",
        "cweMappingNotes__Rationale",
        "cweMappingNotes__Comments",
        "cweMappingNotes__Reasons",
        "cweMappingNotes__Suggestions"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Usage",
          "description": "Whether the entry may be used for mapping.",
          "exact_mappings": [
            "sepses_cwe:mappingUsage"
          ],
          "range": "CweUsage",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Rationale",
          "description": "Why the entry has that usage.",
          "range": "cwe_structured_text",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Comments",
          "description": "More advice for someone mapping to the entry.",
          "range": "cwe_structured_text",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Reasons",
          "description": "Short labels that sum up the usage.",
          "range": "CweMappingReason",
          "required": true,
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "Suggestions",
          "description": "Other weaknesses that may suit the mapping better.",
          "range": "CweMappingSuggestion",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/cwe/CweMappingNotes",
      "@type": "ClassDefinition"
    },
    {
      "name": "CweMappingReason",
      "definition_uri": "https://w3id.org/lmodel/cwe/CweMappingReason",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "ReasonsType/Reason",
          "@type": "Annotation"
        }
      ],
      "description": "One short label that sums up the usage of an entry.",
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_entries",
      "slots": [
        "cweMappingReason__Type"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Type",
          "description": "The label.",
          "range": "CweReason",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/cwe/CweMappingReason",
      "@type": "ClassDefinition"
    },
    {
      "name": "CweMappingSuggestion",
      "definition_uri": "https://w3id.org/lmodel/cwe/CweMappingSuggestion",
      "annotations": [
        {
          "tag": "xsd_type",
          "value": "SuggestionsType/Suggestion",
          "@type": "Annotation"
        }
      ],
      "description": "A weakness that may suit a mapping better than this entry.",
      "from_schema": "https://w3id.org/lmodel/cwe/cwe_entries",
      "slots": [
        "cweMappingSuggestion__CWE_ID",
        "cweMappingSuggestion__Comment"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "CWE_ID",
          "description": "The suggested weakness.",
          "range": "CweWeakness",
          "required": true,
          "pattern": "^[1-9][0-9]*$",
          "@type": "SlotDefinition"
        },
        {
          "name": "Comment",
          "description": "When the suggestion applies.",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/cwe/CweMappingSuggestion",
      "@type": "ClassDefinition"
    }
  ],
