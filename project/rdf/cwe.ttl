<https://w3id.org/lmodel/cwe/cwe_capec_id> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/cwe/cwe_core"^^xsd:anyURI ;
	linkml:annotations _:c14n45 ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/cwe/CweCapecId"^^xsd:anyURI ;
	linkml:description "The number of an attack pattern in the CAPEC list, written as text, such as 63." ;
	linkml:pattern "^[1-9][0-9]*$" ;
	linkml:typeof <https://w3id.org/lmodel/cwe/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/cwe/cwe_entry_id> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/cwe/cwe_core"^^xsd:anyURI ;
	skos:note "The XSD types it as an integer. It stays a string because LinkML's RDF dumper needs an identifier it can expand, and the catalogue's XML holds text anyway." ;
	linkml:annotations _:c14n31 ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/cwe/CweEntryId"^^xsd:anyURI ;
	linkml:description "The number that identifies an entry of the CWE List, written as text, such as 79." ;
	linkml:pattern "^[1-9][0-9]*$" ;
	linkml:typeof <https://w3id.org/lmodel/cwe/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/cwe/cwe_publication_day> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/cwe/cwe_core"^^xsd:anyURI ;
	linkml:annotations _:c14n127 ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/cwe/CwePublicationDay"^^xsd:anyURI ;
	linkml:description "A day of the month in XML Schema's form, three hyphens and two digits, such as ---06." ;
	linkml:pattern "^---(0[1-9]|[12][0-9]|3[01])(Z|[+-][0-9]{2}:[0-9]{2})?$" ;
	linkml:typeof <https://w3id.org/lmodel/cwe/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#gDay"^^xsd:anyURI .
<https://w3id.org/lmodel/cwe/cwe_publication_month> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/cwe/cwe_core"^^xsd:anyURI ;
	linkml:annotations _:c14n24 ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/cwe/CwePublicationMonth"^^xsd:anyURI ;
	linkml:description "A month in XML Schema's form, two hyphens and two digits, such as --03." ;
	linkml:pattern "^--(0[1-9]|1[0-2])(Z|[+-][0-9]{2}:[0-9]{2})?$" ;
	linkml:typeof <https://w3id.org/lmodel/cwe/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#gMonth"^^xsd:anyURI .
<https://w3id.org/lmodel/cwe/cwe_publication_year> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/cwe/cwe_core"^^xsd:anyURI ;
	linkml:annotations _:c14n79 ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/cwe/CwePublicationYear"^^xsd:anyURI ;
	linkml:description "A year in XML Schema's form, such as 2021." ;
	linkml:pattern "^-?[0-9]{4,}(Z|[+-][0-9]{2}:[0-9]{2})?$" ;
	linkml:typeof <https://w3id.org/lmodel/cwe/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#gYear"^^xsd:anyURI .
<https://w3id.org/lmodel/cwe/cwe_reference_id> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/cwe/cwe_core"^^xsd:anyURI ;
	skos:note "The XSD types it as a string with no pattern. CWE 5.0 writes REF and a number on all but one, whose identifier is the bare number 1300." ;
	linkml:annotations _:c14n43 ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/cwe/CweReferenceId"^^xsd:anyURI ;
	linkml:description "The identifier of an external reference in the catalogue, such as REF-1." ;
	linkml:typeof <https://w3id.org/lmodel/cwe/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/cwe/cwe_structured_text> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/cwe/cwe_core"^^xsd:anyURI ;
	skos:note "A consumer that shows this text as HTML must sanitize it first, since it can quote attack strings." ;
	linkml:annotations _:c14n72 ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/cwe/CweStructuredText"^^xsd:anyURI ;
	linkml:description "Text that may hold XHTML markup, kept as a well-formed fragment without the namespace prefix and with its special characters escaped." ;
	linkml:typeof <https://w3id.org/lmodel/cwe/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
