	skos:closeMatch "http://w3id.org/sepses/vocab/ref/cwe#hasCAPEC"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/cwe/cwe_entries"^^xsd:anyURI ;
	skos:prefLabel "Related_Attack_Patterns" ;
