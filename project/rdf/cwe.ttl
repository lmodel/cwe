	linkml:permissible_values <https://w3id.org/lmodel/cwe/AI/ML> , <https://w3id.org/lmodel/cwe/Accelerator%20Hardware> , <https://w3id.org/lmodel/cwe/Analog%20and%20Mixed%20Signal%20Hardware> , <https://w3id.org/lmodel/cwe/Audio/Video%20Hardware> , <https://w3id.org/lmodel/cwe/Bus/Interface%20Hardware> , <https://w3id.org/lmodel/cwe/Clock/Counter%20Hardware> , <https://w3id.org/lmodel/cwe/Communication%20Hardware> , <https://w3id.org/lmodel/cwe/Controller%20Hardware> , <https://w3id.org/lmodel/cwe/Database%20Server> , <https://w3id.org/lmodel/cwe/Memory%20Hardware> , <https://w3id.org/lmodel/cwe/Microcontroller%20Hardware> , <https://w3id.org/lmodel/cwe/Network%20on%20Chip%20Hardware> , <https://w3id.org/lmodel/cwe/Other> , <https://w3id.org/lmodel/cwe/Power%20Management%20Hardware> , <https://w3id.org/lmodel/cwe/Processor%20Hardware> , <https://w3id.org/lmodel/cwe/Security%20Hardware> , <https://w3id.org/lmodel/cwe/Sensor%20Hardware> , <https://w3id.org/lmodel/cwe/Storage%20Hardware> , <https://w3id.org/lmodel/cwe/Test/Debug%20Hardware> , <https://w3id.org/lmodel/cwe/Web%20Server> .
<https://w3id.org/lmodel/cwe/CweTechnologyPlatform> a linkml:ClassDefinition ;
	skos:inScheme "https://w3id.org/lmodel/cwe/cwe_entries"^^xsd:anyURI ;
	linkml:annotations _:c14n84 ;
	linkml:attributes <https://w3id.org/lmodel/cwe/Class> , <https://w3id.org/lmodel/cwe/Name> , <https://w3id.org/lmodel/cwe/Note> , <https://w3id.org/lmodel/cwe/Prevalence> ;
	linkml:class_uri "https://w3id.org/lmodel/cwe/CweTechnologyPlatform"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/cwe/CweTechnologyPlatform"^^xsd:anyURI ;
	linkml:description "A technology where a weakness can appear, named or by its family." ;
	linkml:slot_usage _:c14n140 ;
	linkml:slots <https://w3id.org/lmodel/cwe/cweTechnologyPlatform__Class> , <https://w3id.org/lmodel/cwe/cweTechnologyPlatform__Name> , <https://w3id.org/lmodel/cwe/cweTechnologyPlatform__Note> , <https://w3id.org/lmodel/cwe/cweTechnologyPlatform__Prevalence> .
<https://w3id.org/lmodel/cwe/CweUsage> skos:inScheme "https://w3id.org/lmodel/cwe/cwe_core"^^xsd:anyURI ;
	linkml:annotations _:c14n58 ;
	linkml:definition_uri "https://w3id.org/lmodel/cwe/CweUsage"^^xsd:anyURI ;
	linkml:description "Whether an entry may be used when mapping a real vulnerability to its root cause." ;
	linkml:permissible_values <https://w3id.org/lmodel/cwe/Allowed-with-Review> , <https://w3id.org/lmodel/cwe/Allowed> , <https://w3id.org/lmodel/cwe/Discouraged> , <https://w3id.org/lmodel/cwe/Prohibited> .
<https://w3id.org/lmodel/cwe/CweView> a linkml:ClassDefinition ;
	rdfs:seeAlso "https://cwe.mitre.org/documents/glossary/index.html#View"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/cwe/cwe_entries"^^xsd:anyURI ;
	skos:note "A graph view arranges concepts as a scheme does, but a slice is a flat list, so the SKOS concept scheme is only related." ;
	skos:relatedMatch "skos:ConceptScheme"^^xsd:anyURI ;
	linkml:annotations _:c14n73 ;
	linkml:attributes <https://w3id.org/lmodel/cwe/Audience> , <https://w3id.org/lmodel/cwe/Filter> , <https://w3id.org/lmodel/cwe/Members> , <https://w3id.org/lmodel/cwe/Objective> , <https://w3id.org/lmodel/cwe/Type> ;
	linkml:class_uri "https://w3id.org/lmodel/cwe/CweView"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/cwe/CweView"^^xsd:anyURI ;
	linkml:description "A way of looking at the catalogue, as a subset of its entries seen from one standpoint." ;
	linkml:is_a <https://w3id.org/lmodel/cwe/CweEntry> ;
	linkml:slot_usage _:c14n47 ;
	linkml:slots <https://w3id.org/lmodel/cwe/cweEntry__Content_History> , <https://w3id.org/lmodel/cwe/cweEntry__ID> , <https://w3id.org/lmodel/cwe/cweEntry__Mapping_Notes> , <https://w3id.org/lmodel/cwe/cweEntry__Name> , <https://w3id.org/lmodel/cwe/cweEntry__Notes> , <https://w3id.org/lmodel/cwe/cweEntry__References> , <https://w3id.org/lmodel/cwe/cweEntry__Status> , <https://w3id.org/lmodel/cwe/cweView__Audience> , <https://w3id.org/lmodel/cwe/cweView__Filter> , <https://w3id.org/lmodel/cwe/cweView__Members> , <https://w3id.org/lmodel/cwe/cweView__Objective> , <https://w3id.org/lmodel/cwe/cweView__Type> .
<https://w3id.org/lmodel/cwe/CweViewType> skos:inScheme "https://w3id.org/lmodel/cwe/cwe_core"^^xsd:anyURI ;
	linkml:annotations _:c14n100 ;
	linkml:definition_uri "https://w3id.org/lmodel/cwe/CweViewType"^^xsd:anyURI ;
	linkml:description "How a view selects and arranges its entries." ;
	linkml:permissible_values <https://w3id.org/lmodel/cwe/Explicit> , <https://w3id.org/lmodel/cwe/Graph> , <https://w3id.org/lmodel/cwe/Implicit> .
<https://w3id.org/lmodel/cwe/CweWeakness> a linkml:ClassDefinition ;
	rdfs:seeAlso "https://cwe.mitre.org/documents/glossary/index.html#Weakness"^^xsd:anyURI ;
	skos:closeMatch "schema:DefinedTerm"^^xsd:anyURI , "sepses_cwe:CWE"^^xsd:anyURI , "skos:Concept"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/cwe/cwe_entries"^^xsd:anyURI ;
	skos:note "The SPDX external reference type names a weakness as a target of a link, and an NVD weakness names one as the cause of a vulnerability, so both are related." ;
	skos:relatedMatch "nist_nvd:NvdWeakness"^^xsd:anyURI , "spdx_core:ExternalRefType/cwe"^^xsd:anyURI ;
	sh:rule _:c14n107 , _:c14n26 , _:c14n95 ;
	linkml:annotations _:c14n46 ;
	linkml:attributes <https://w3id.org/lmodel/cwe/Abstraction> , <https://w3id.org/lmodel/cwe/Affected_Resources> , <https://w3id.org/lmodel/cwe/Alternate_Terms> , <https://w3id.org/lmodel/cwe/Applicable_Platforms> , <https://w3id.org/lmodel/cwe/Background_Details> , <https://w3id.org/lmodel/cwe/Common_Consequences> , <https://w3id.org/lmodel/cwe/Demonstrative_Examples> , <https://w3id.org/lmodel/cwe/Description> , <https://w3id.org/lmodel/cwe/Detection_Methods> , <https://w3id.org/lmodel/cwe/Diagram> , <https://w3id.org/lmodel/cwe/Dimensions> , <https://w3id.org/lmodel/cwe/Exploitation_Factors> , <https://w3id.org/lmodel/cwe/Extended_Description> , <https://w3id.org/lmodel/cwe/Functional_Areas> , <https://w3id.org/lmodel/cwe/Likelihood_Of_Exploit> , <https://w3id.org/lmodel/cwe/Modes_Of_Introduction> , <https://w3id.org/lmodel/cwe/Observed_Examples> , <https://w3id.org/lmodel/cwe/Potential_Mitigations> , <https://w3id.org/lmodel/cwe/Related_Attack_Patterns> , <https://w3id.org/lmodel/cwe/Related_Weaknesses> , <https://w3id.org/lmodel/cwe/Structure> , <https://w3id.org/lmodel/cwe/Taxonomy_Mappings> , <https://w3id.org/lmodel/cwe/Technical_Nuance> , <https://w3id.org/lmodel/cwe/Weakness_Ordinalities> ;
	linkml:class_uri "https://w3id.org/lmodel/cwe/CweWeakness"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/cwe/CweWeakness"^^xsd:anyURI ;
	linkml:description "A type of mistake or condition in software, firmware, hardware or a service that can leave a product open to attack." ;
	linkml:is_a <https://w3id.org/lmodel/cwe/CweEntry> ;
	linkml:slot_usage _:c14n114 ;
	linkml:slots <https://w3id.org/lmodel/cwe/cweEntry__Content_History> , <https://w3id.org/lmodel/cwe/cweEntry__ID> , <https://w3id.org/lmodel/cwe/cweEntry__Mapping_Notes> , <https://w3id.org/lmodel/cwe/cweEntry__Name> , <https://w3id.org/lmodel/cwe/cweEntry__Notes> , <https://w3id.org/lmodel/cwe/cweEntry__References> , <https://w3id.org/lmodel/cwe/cweEntry__Status> , <https://w3id.org/lmodel/cwe/cweWeakness__Abstraction> , <https://w3id.org/lmodel/cwe/cweWeakness__Affected_Resources> , <https://w3id.org/lmodel/cwe/cweWeakness__Alternate_Terms> , <https://w3id.org/lmodel/cwe/cweWeakness__Applicable_Platforms> , <https://w3id.org/lmodel/cwe/cweWeakness__Background_Details> , <https://w3id.org/lmodel/cwe/cweWeakness__Common_Consequences> , <https://w3id.org/lmodel/cwe/cweWeakness__Demonstrative_Examples> , <https://w3id.org/lmodel/cwe/cweWeakness__Description> , <https://w3id.org/lmodel/cwe/cweWeakness__Detection_Methods> , <https://w3id.org/lmodel/cwe/cweWeakness__Diagram> , <https://w3id.org/lmodel/cwe/cweWeakness__Dimensions> , <https://w3id.org/lmodel/cwe/cweWeakness__Exploitation_Factors> , <https://w3id.org/lmodel/cwe/cweWeakness__Extended_Description> , <https://w3id.org/lmodel/cwe/cweWeakness__Functional_Areas> , <https://w3id.org/lmodel/cwe/cweWeakness__Likelihood_Of_Exploit> , <https://w3id.org/lmodel/cwe/cweWeakness__Modes_Of_Introduction> , <https://w3id.org/lmodel/cwe/cweWeakness__Observed_Examples> , <https://w3id.org/lmodel/cwe/cweWeakness__Potential_Mitigations> , <https://w3id.org/lmodel/cwe/cweWeakness__Related_Attack_Patterns> , <https://w3id.org/lmodel/cwe/cweWeakness__Related_Weaknesses> , <https://w3id.org/lmodel/cwe/cweWeakness__Structure> , <https://w3id.org/lmodel/cwe/cweWeakness__Taxonomy_Mappings> , <https://w3id.org/lmodel/cwe/cweWeakness__Technical_Nuance> , <https://w3id.org/lmodel/cwe/cweWeakness__Weakness_Ordinalities> .
<https://w3id.org/lmodel/cwe/CweWeaknessCatalog> a linkml:ClassDefinition ;
	skos:closeMatch "schema:DefinedTermSet"^^xsd:anyURI , "skos:ConceptScheme"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/cwe"^^xsd:anyURI ;
	skos:note "Wikidata's item is the catalogue in general and this class is one release of it, so the item is related." ;
	skos:relatedMatch "wd:Q2682392"^^xsd:anyURI ;
	linkml:annotations _:c14n101 ;
	linkml:attributes <https://w3id.org/lmodel/cwe/Date> , <https://w3id.org/lmodel/cwe/External_References> , <https://w3id.org/lmodel/cwe/Groupings> , <https://w3id.org/lmodel/cwe/Name> , <https://w3id.org/lmodel/cwe/Version> , <https://w3id.org/lmodel/cwe/Views> , <https://w3id.org/lmodel/cwe/Weaknesses> ;
	linkml:class_uri "https://w3id.org/lmodel/cwe/CweWeaknessCatalog"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/cwe/CweWeaknessCatalog"^^xsd:anyURI ;
	linkml:description "One release of the CWE List, with all its entries and the sources they cite." ;
	linkml:slot_usage _:c14n59 ;
	linkml:slots <https://w3id.org/lmodel/cwe/cweWeaknessCatalog__Date> , <https://w3id.org/lmodel/cwe/cweWeaknessCatalog__External_References> , <https://w3id.org/lmodel/cwe/cweWeaknessCatalog__Groupings> , <https://w3id.org/lmodel/cwe/cweWeaknessCatalog__Name> , <https://w3id.org/lmodel/cwe/cweWeaknessCatalog__Version> , <https://w3id.org/lmodel/cwe/cweWeaknessCatalog__Views> , <https://w3id.org/lmodel/cwe/cweWeaknessCatalog__Weaknesses> ;
	linkml:tree_root true .
<https://w3id.org/lmodel/cwe/CweWeaknessOrdinality> a linkml:ClassDefinition ;
	skos:inScheme "https://w3id.org/lmodel/cwe/cwe_entries"^^xsd:anyURI ;
	linkml:annotations _:c14n14 ;
	linkml:attributes <https://w3id.org/lmodel/cwe/Description> , <https://w3id.org/lmodel/cwe/Ordinality> ;
	linkml:class_uri "https://w3id.org/lmodel/cwe/CweWeaknessOrdinality"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/cwe/CweWeaknessOrdinality"^^xsd:anyURI ;
	linkml:description "Whether a weakness tends to be a first cause or the result of another." ;
	linkml:slot_usage _:c14n157 ;
	linkml:slots <https://w3id.org/lmodel/cwe/cweWeaknessOrdinality__Description> , <https://w3id.org/lmodel/cwe/cweWeaknessOrdinality__Ordinality> .
<https://w3id.org/lmodel/cwe/Date> a linkml:SlotDefinition ;
	linkml:description "The date of this release." , "The date the name stopped being used." ;
	linkml:range <https://w3id.org/lmodel/cwe/date> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Defense%20in%20Depth> linkml:description "It adds a layer of protection and does not remove the weakness by itself." .
<https://w3id.org/lmodel/cwe/Demonstrative_Example_ID> a linkml:SlotDefinition ;
	linkml:description "An identifier that lets entries share this example, such as DX-221." .
<https://w3id.org/lmodel/cwe/Demonstrative_Examples> a linkml:SlotDefinition ;
	linkml:description "Worked examples of how the weakness looks in code." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweDemonstrativeExample> .
<https://w3id.org/lmodel/cwe/Deprecated> linkml:description "Taken out of CWE, usually because it duplicated another entry or was made by mistake." .
<https://w3id.org/lmodel/cwe/Description> a linkml:SlotDefinition ;
	skos:closeMatch "dcterms:description"^^xsd:anyURI , "schema:description"^^xsd:anyURI , "skos:definition"^^xsd:anyURI ;
	skos:exactMatch "sepses_cwe:detectionDescription"^^xsd:anyURI , "sepses_cwe:mitigationDescription"^^xsd:anyURI ;
	linkml:description "A sentence or two that define the weakness." , "How the method applies to this weakness." , "The setting in which the weakness takes this position." , "What in the view this group may find useful." , "What to do, with its strengths and limits." , "What went wrong in that case, as it bears on the weakness." , "When and how the name is used." ;
	linkml:range <https://w3id.org/lmodel/cwe/cwe_structured_text> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Detection_Method_ID> a linkml:SlotDefinition ;
	linkml:description "An identifier that lets entries share this text, such as DM-14." .
<https://w3id.org/lmodel/cwe/Detection_Methods> a linkml:SlotDefinition ;
	skos:closeMatch "sepses_cwe:hasDetectionMethod"^^xsd:anyURI ;
	linkml:description "Ways of finding the weakness, with what each is good for." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweDetectionMethod> .
<https://w3id.org/lmodel/cwe/Diagram> a linkml:SlotDefinition ;
	linkml:description "The path on MITRE's site of a diagram of the weakness." .
<https://w3id.org/lmodel/cwe/Dimensions> a linkml:SlotDefinition ;
	linkml:description "The aspects in which the two entries differ." , "The aspects in which the two weaknesses differ." , "The aspects of the weakness that this entry centres on." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweDimension> .
<https://w3id.org/lmodel/cwe/Discouraged%20Common%20Practice> linkml:description "A habit people often follow that does not work well enough to recommend." .
<https://w3id.org/lmodel/cwe/Discouraged> linkml:description "It should not be used for mapping." .
<https://w3id.org/lmodel/cwe/Domain> a linkml:SlotDefinition ;
	linkml:description "The field whose life cycle the stage belongs to." ;
	linkml:equals_string "AI" , "Hardware" ;
	linkml:range <https://w3id.org/lmodel/cwe/CweCustomPhaseDomain> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Draft> linkml:description "Its important elements are filled in and readable, though it may still have problems." .
<https://w3id.org/lmodel/cwe/Early-Publication> linkml:description "One of the earliest examples recognised as showing this weakness." , "One of the first publications to explain the weakness or how it is exploited." .
<https://w3id.org/lmodel/cwe/Edition> a linkml:SlotDefinition ;
	skos:closeMatch "schema:bookEdition"^^xsd:anyURI ;
	skos:exactMatch "sepses_cwe:referenceEdition"^^xsd:anyURI ;
	linkml:description "The edition of the source." .
<https://w3id.org/lmodel/cwe/Effectiveness> a linkml:SlotDefinition ;
	skos:exactMatch "sepses_cwe:detectionEffectiveness"^^xsd:anyURI , "sepses_cwe:mitigationEffectiveness"^^xsd:anyURI ;
	linkml:description "How well the method finds the weakness." , "How well the mitigation prevents the weakness." ;
	linkml:range <https://w3id.org/lmodel/cwe/CweDetectionEffectiveness> , <https://w3id.org/lmodel/cwe/CweEffectiveness> .
<https://w3id.org/lmodel/cwe/Effectiveness_Notes> a linkml:SlotDefinition ;
	skos:exactMatch "sepses_cwe:detectionEffectivenessNote"^^xsd:anyURI , "sepses_cwe:mitigationEffectivenessNote"^^xsd:anyURI ;
	linkml:description "The strengths and limits of the method here." , "The strengths and limits of the mitigation here." ;
	linkml:range <https://w3id.org/lmodel/cwe/cwe_structured_text> .
<https://w3id.org/lmodel/cwe/Entries> a linkml:SlotDefinition ;
	skos:note "The XSD gives this list no name, because it writes a repeating choice of two elements. The name is the one the CWE REST API uses, and it is the one key here that is not in the XSD." ;
	linkml:description "The example's prose and code, in the order they are meant to be read." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweExampleEntry> .
<https://w3id.org/lmodel/cwe/Entry_ID> a linkml:SlotDefinition ;
	linkml:description "The identifier of the entry in the other taxonomy." .
<https://w3id.org/lmodel/cwe/Entry_Name> a linkml:SlotDefinition ;
	linkml:description "The name of the entry in the other taxonomy." .
<https://w3id.org/lmodel/cwe/Example> linkml:description "It gives more detail on an example in the entry, and may be where the example came from." .
<https://w3id.org/lmodel/cwe/Example_Code> a linkml:SlotDefinition ;
	linkml:description "A block of code." ;
	linkml:inlined true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweExampleCode> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Explicit> linkml:description "A flat list whose members are named one by one." .
<https://w3id.org/lmodel/cwe/Exploitation_Factors> a linkml:SlotDefinition ;
	linkml:description "Conditions that make exploiting the weakness more likely." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/cwe_structured_text> .
<https://w3id.org/lmodel/cwe/Extended_Description> a linkml:SlotDefinition ;
	skos:exactMatch "sepses_cwe:extendedDescription"^^xsd:anyURI ;
	linkml:description "More about the weakness than its short description gives." ;
	linkml:range <https://w3id.org/lmodel/cwe/cwe_structured_text> .
<https://w3id.org/lmodel/cwe/External_Reference_ID> a linkml:SlotDefinition ;
	linkml:description "The external reference being cited." ;
	linkml:range <https://w3id.org/lmodel/cwe/CweExternalReference> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/External_References> a linkml:SlotDefinition ;
	linkml:description "The sources that the entries cite." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweExternalReference> .
<https://w3id.org/lmodel/cwe/F%23> dcterms:title "F sharp" .
<https://w3id.org/lmodel/cwe/Feedback> linkml:description "Feedback on the entry." .
<https://w3id.org/lmodel/cwe/Filter> a linkml:SlotDefinition ;
	linkml:description "The XPath expression that selects the entries of an implicit slice." .
<https://w3id.org/lmodel/cwe/Functional_Areas> a linkml:SlotDefinition ;
	linkml:description "The parts of a product where the weakness tends to appear." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweFunctionalArea> .
<https://w3id.org/lmodel/cwe/Good> linkml:description "Code that avoids the weakness." .
<https://w3id.org/lmodel/cwe/Graph> linkml:description "A hierarchy of entries from one point of view." .
<https://w3id.org/lmodel/cwe/Groupings> a linkml:SlotDefinition ;
	linkml:description "The grouping entries." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweGrouping> .
<https://w3id.org/lmodel/cwe/Has_Member> a linkml:SlotDefinition ;
	linkml:description "An entry that this one holds." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweMember> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/High> linkml:description "It finds the weakness often and with few false reports." , "It often removes the weakness altogether." .
<https://w3id.org/lmodel/cwe/ID> a linkml:SlotDefinition ;
	skos:closeMatch "schema:termCode"^^xsd:anyURI , "wdt:P3624"^^xsd:anyURI ;
	skos:note "Wikidata's P3624 holds this number for a weakness, without the CWE- prefix. lmodel/cve's cweId and lmodel/kev-catalog's cwes write the same number with the prefix, as CWE-79, so they are related." ;
	skos:relatedMatch "cve:cweId"^^xsd:anyURI , "kev_catalog:cwes"^^xsd:anyURI ;
	linkml:description "The number that identifies the entry across the whole list." ;
	linkml:identifier true ;
	linkml:range <https://w3id.org/lmodel/cwe/cwe_entry_id> .
<https://w3id.org/lmodel/cwe/Impact> a linkml:SlotDefinition ;
	skos:closeMatch "sepses_cwe:consequenceImpact"^^xsd:anyURI ;
	linkml:description "What an attacker can achieve." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweTechnicalImpact> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Implicit> linkml:description "A flat list that a filter selects." .
<https://w3id.org/lmodel/cwe/Imprecise> linkml:description "The two match only loosely." .
<https://w3id.org/lmodel/cwe/Incidental> linkml:description "It protects by chance and cannot be relied on." .
<https://w3id.org/lmodel/cwe/Incomplete> linkml:description "Some important elements are missing and its quality is not assured." .
<https://w3id.org/lmodel/cwe/Indirect> linkml:description "A quality problem that makes other weaknesses easier to introduce or harder to find." .
<https://w3id.org/lmodel/cwe/Influential/Newsworthy> linkml:description "A publication that drew attention or shaped how people see the weakness." , "An example that drew attention or shaped how people see this weakness." .
<https://w3id.org/lmodel/cwe/Informative> linkml:description "Background that shows neither good nor bad code." .
<https://w3id.org/lmodel/cwe/Intro_Text> a linkml:SlotDefinition ;
	linkml:description "The setting of the code, and what it is trying to do." ;
	linkml:range <https://w3id.org/lmodel/cwe/cwe_structured_text> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Language> a linkml:SlotDefinition ;
	linkml:description "A programming language, or a family of them." , "The language of the code." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweLanguageName> , <https://w3id.org/lmodel/cwe/CweLanguagePlatform> .
<https://w3id.org/lmodel/cwe/Likelihood> a linkml:SlotDefinition ;
	linkml:description "How likely this consequence is beside the others." ;
	linkml:range <https://w3id.org/lmodel/cwe/CweLikelihood> .
<https://w3id.org/lmodel/cwe/Likelihood_Of_Exploit> a linkml:SlotDefinition ;
	skos:exactMatch "sepses_cwe:likelihoodOfExploit"^^xsd:anyURI ;
	linkml:description "How likely it is that the weakness gets exploited." ;
	linkml:range <https://w3id.org/lmodel/cwe/CweLikelihood> .
<https://w3id.org/lmodel/cwe/Limited> linkml:description "It helps only in some situations or against some forms of the weakness." , "It helps only in some situations." .
<https://w3id.org/lmodel/cwe/Link> a linkml:SlotDefinition ;
	linkml:description "An address with more about the case." ;
	linkml:range <https://w3id.org/lmodel/cwe/uri> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Maintenance> linkml:description "Work the entry still needs, such as sharper concepts or better relationships." .
<https://w3id.org/lmodel/cwe/Manual/Man%20Pages> linkml:description "Technical reference material that gives background and is not about the weakness itself." .
<https://w3id.org/lmodel/cwe/Mapping_Fit> a linkml:SlotDefinition ;
	linkml:description "How closely the two entries match." ;
	linkml:range <https://w3id.org/lmodel/cwe/CweMappingFit> .
<https://w3id.org/lmodel/cwe/Mapping_Notes> a linkml:SlotDefinition ;
	linkml:description "Guidance on whether to map a real vulnerability to this entry." ;
	linkml:inlined true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweMappingNotes> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Media_Type> a linkml:SlotDefinition ;
	linkml:description "A form the source takes." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweReferenceMediaType> .
<https://w3id.org/lmodel/cwe/Member_Of> a linkml:SlotDefinition ;
	linkml:description "An entry that holds this one." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweMember> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Members> a linkml:SlotDefinition ;
	linkml:description "The entries a view names one by one, when it is not selected by a filter." ;
	linkml:inlined true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweRelationships> .
<https://w3id.org/lmodel/cwe/Method> a linkml:SlotDefinition ;
	skos:exactMatch "sepses_cwe:detectionMethod"^^xsd:anyURI ;
	linkml:description "The way of finding the weakness." ;
	linkml:range <https://w3id.org/lmodel/cwe/CweDetectionMethodName> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Minimal-Registration> linkml:description "A reader must register, at no cost, to read it." .
<https://w3id.org/lmodel/cwe/Mitigation-Based> linkml:description "It proposes ways to reduce or remove weaknesses across a whole system." .
<https://w3id.org/lmodel/cwe/Mitigation> linkml:description "A way of addressing the weakness." .
<https://w3id.org/lmodel/cwe/Mitigation_ID> a linkml:SlotDefinition ;
	linkml:description "An identifier that lets entries share this text, such as MIT-5." .
<https://w3id.org/lmodel/cwe/Moderate> linkml:description "It prevents several forms of the weakness but does not cover them all." , "It works in several situations but misses some forms or gives some false reports." .
<https://w3id.org/lmodel/cwe/Modes_Of_Introduction> a linkml:SlotDefinition ;
	skos:closeMatch "sepses_cwe:hasModeOfIntroduction"^^xsd:anyURI ;
	linkml:description "How and when the weakness can get into a product." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweIntroduction> .
<https://w3id.org/lmodel/cwe/Modification> a linkml:SlotDefinition ;
	skos:closeMatch "sepses_cwe:hasModificationHistory"^^xsd:anyURI , "skos:changeNote"^^xsd:anyURI ;
	linkml:description "A change made to the entry." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweModification> .
<https://w3id.org/lmodel/cwe/Modification_Comment> a linkml:SlotDefinition ;
	skos:exactMatch "sepses_cwe:modificationComment"^^xsd:anyURI ;
	linkml:description "What changed." ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Modification_Date> a linkml:SlotDefinition ;
	skos:exactMatch "sepses_cwe:modificationDate"^^xsd:anyURI ;
	linkml:description "The date of the change." ;
	linkml:range <https://w3id.org/lmodel/cwe/date> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Modification_Importance> a linkml:SlotDefinition ;
	linkml:description "How much the change matters to people who rely on the entry." ;
	linkml:range <https://w3id.org/lmodel/cwe/CweImportance> .
<https://w3id.org/lmodel/cwe/Modification_Name> a linkml:SlotDefinition ;
	skos:exactMatch "sepses_cwe:modificationName"^^xsd:anyURI ;
	linkml:description "The person who made or suggested the change." .
<https://w3id.org/lmodel/cwe/Modification_Organization> a linkml:SlotDefinition ;
	skos:exactMatch "sepses_cwe:modificationOrganization"^^xsd:anyURI ;
	linkml:description "The organization that person belongs to." .
<https://w3id.org/lmodel/cwe/Modification_ReleaseDate> a linkml:SlotDefinition ;
	linkml:description "The release date of that version." ;
	linkml:range <https://w3id.org/lmodel/cwe/date> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Modification_Version> a linkml:SlotDefinition ;
	linkml:description "The first CWE version that held the change." ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Name> a linkml:SlotDefinition ;
	skos:closeMatch "schema:name"^^xsd:anyURI , "skos:prefLabel"^^xsd:anyURI ;
	linkml:description "The name of the architecture." , "The name of the catalogue, which is CWE." , "The name of the entry." , "The name of the language." , "The name of the operating system." , "The name of the technology." ;
	linkml:range <https://w3id.org/lmodel/cwe/CweArchitectureName> , <https://w3id.org/lmodel/cwe/CweLanguageName> , <https://w3id.org/lmodel/cwe/CweOperatingSystemName> , <https://w3id.org/lmodel/cwe/CweTechnologyName> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Nature> a linkml:SlotDefinition ;
	skos:exactMatch "sepses_cwe:relatedWeaknessNature"^^xsd:anyURI ;
	linkml:description "How the two weaknesses relate." , "What the code shows." ;
	linkml:range <https://w3id.org/lmodel/cwe/CweCodeNature> , <https://w3id.org/lmodel/cwe/CweRelatedNature> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/None> linkml:description "Anybody on the internet can read it for free." , "It does not find the weakness." , "It does not prevent the weakness." .
<https://w3id.org/lmodel/cwe/Not%20Architecture-Specific> linkml:description "The weakness can appear on many architectures." .
<https://w3id.org/lmodel/cwe/Not%20Language-Specific> linkml:description "The weakness can appear in many languages." .
<https://w3id.org/lmodel/cwe/Not%20OS-Specific> linkml:description "The weakness can appear on many operating systems." .
<https://w3id.org/lmodel/cwe/Not%20Technology-Specific> linkml:description "The weakness can appear in many technologies." .
<https://w3id.org/lmodel/cwe/Note> a linkml:SlotDefinition ;
	skos:closeMatch "sepses_cwe:consequenceNote"^^xsd:anyURI , "sepses_cwe:modeOfIntroductionNote"^^xsd:anyURI ;
	linkml:description "A remark on the consequence." , "A remark on this platform." , "The usual way this happens." ;
	linkml:range <https://w3id.org/lmodel/cwe/cwe_structured_text> .
<https://w3id.org/lmodel/cwe/Notes> a linkml:SlotDefinition ;
	skos:closeMatch "skos:note"^^xsd:anyURI ;
	linkml:description "Remarks on the entry that fit nowhere else." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweNote> .
<https://w3id.org/lmodel/cwe/Objective> a linkml:SlotDefinition ;
	skos:closeMatch "dcterms:description"^^xsd:anyURI ;
	linkml:description "What the view is for." ;
	linkml:range <https://w3id.org/lmodel/cwe/cwe_structured_text> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Observed_Examples> a linkml:SlotDefinition ;
	linkml:description "Real cases of the weakness, usually CVE records." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweObservedExample> .
<https://w3id.org/lmodel/cwe/Obsolete> linkml:description "Still correct but no longer relevant, usually because a newer entry replaced it." .
<https://w3id.org/lmodel/cwe/Operating_System> a linkml:SlotDefinition ;
	linkml:description "An operating system, or a family of them." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweOperatingSystemPlatform> .
<https://w3id.org/lmodel/cwe/Opportunistic> linkml:description "It does not aim at this weakness and finds it only by the way." .
<https://w3id.org/lmodel/cwe/Ordinal> a linkml:SlotDefinition ;
	skos:exactMatch "sepses_cwe:relatedWeaknessOrdinal"^^xsd:anyURI ;
	linkml:description "Marks this as the link to prefer in the view." ;
	linkml:range <https://w3id.org/lmodel/cwe/CweOrdinal> .
<https://w3id.org/lmodel/cwe/Ordinality> a linkml:SlotDefinition ;
	skos:exactMatch "sepses_cwe:weaknessOrdinality"^^xsd:anyURI ;
	linkml:description "The position in the sequence of causes." ;
	linkml:range <https://w3id.org/lmodel/cwe/CweOrdinality> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Other> linkml:description "Anything useful that fits no other type." , "Some other format, which may be harder for some readers to use." .
<https://w3id.org/lmodel/cwe/Overlaps> linkml:description "The two weaknesses share some ground, which CWE would rather avoid." .
<https://w3id.org/lmodel/cwe/ParentOf> skos:closeMatch "skos:narrower"^^xsd:anyURI ;
	linkml:description "The related weakness is more specific than this one." .
<https://w3id.org/lmodel/cwe/PeerOf> skos:relatedMatch "skos:related"^^xsd:anyURI ;
	linkml:description "The two are similar in a way that no other nature fits." .
<https://w3id.org/lmodel/cwe/Perspective> linkml:description "The two look at the same matter from different angles." .
<https://w3id.org/lmodel/cwe/Phase> a linkml:SlotDefinition ;
	skos:closeMatch "sepses_cwe:mitigationPhase"^^xsd:anyURI , "sepses_cwe:modeOfIntroductionPhase"^^xsd:anyURI ;
	linkml:description "A life cycle stage where the method applies." , "A life cycle stage where the mitigation applies." , "A life cycle stage where the weakness can get in." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CwePhase> .
<https://w3id.org/lmodel/cwe/Pillar> linkml:description "The most general level, a theme that the weaknesses under it share." .
<https://w3id.org/lmodel/cwe/Potential_Mitigations> a linkml:SlotDefinition ;
	skos:closeMatch "sepses_cwe:hasPotentialMitigation"^^xsd:anyURI ;
	linkml:description "Ways of preventing the weakness or reducing what it can do." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweMitigation> .
<https://w3id.org/lmodel/cwe/Prevalence> a linkml:SlotDefinition ;
	linkml:description "How regularly the weakness applies here." ;
	linkml:range <https://w3id.org/lmodel/cwe/CwePrevalence> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Previous_Entry_Name> a linkml:SlotDefinition ;
	linkml:description "A name the entry used to have." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CwePreviousEntryName> .
<https://w3id.org/lmodel/cwe/Primary> linkml:description "The relationship to follow first in that view." , "The weakness exists without depending on another one." .
<https://w3id.org/lmodel/cwe/Prohibited> linkml:description "It must not be used for mapping." .
<https://w3id.org/lmodel/cwe/Proprietary-Subscription> linkml:description "Only paying subscribers can read it." .
<https://w3id.org/lmodel/cwe/Publication> a linkml:SlotDefinition ;
	linkml:description "The journal, conference or other publication that holds the source." .
<https://w3id.org/lmodel/cwe/Publication_Day> a linkml:SlotDefinition ;
	skos:exactMatch "sepses_cwe:referencePublicationDay"^^xsd:anyURI ;
	linkml:description "The day of the month the source came out." ;
	linkml:range <https://w3id.org/lmodel/cwe/cwe_publication_day> .
<https://w3id.org/lmodel/cwe/Publication_Month> a linkml:SlotDefinition ;
	skos:exactMatch "sepses_cwe:referencePublicationMonth"^^xsd:anyURI ;
	linkml:description "The month the source came out." ;
	linkml:range <https://w3id.org/lmodel/cwe/cwe_publication_month> .
<https://w3id.org/lmodel/cwe/Publication_Year> a linkml:SlotDefinition ;
	skos:exactMatch "sepses_cwe:referencePublicationYear"^^xsd:anyURI ;
	linkml:description "The year the source came out." ;
	linkml:range <https://w3id.org/lmodel/cwe/cwe_publication_year> .
<https://w3id.org/lmodel/cwe/Publisher> a linkml:SlotDefinition ;
	skos:closeMatch "dcterms:publisher"^^xsd:anyURI ;
	skos:exactMatch "sepses_cwe:referencePublisher"^^xsd:anyURI ;
	linkml:description "Who published the source." .
<https://w3id.org/lmodel/cwe/Rationale> a linkml:SlotDefinition ;
	linkml:description "A hint at why the source was cited." , "A hint at why this case was chosen." , "Why the entry has that usage." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweObservedExampleRationale> , <https://w3id.org/lmodel/cwe/CweReferenceRationale> , <https://w3id.org/lmodel/cwe/cwe_structured_text> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Reasons> a linkml:SlotDefinition ;
	linkml:description "Short labels that sum up the usage." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweMappingReason> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Reference> a linkml:SlotDefinition ;
	skos:note "In CWE 5.0 it holds a CVE identifier in 3173 of 3183 cases and an external reference such as [REF-1100] in the rest, so lmodel/cve's cveId is only related." ;
	skos:relatedMatch "cve:cveId"^^xsd:anyURI ;
	linkml:description "The identifier of the case, such as a CVE identifier." ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Reference_ID> a linkml:SlotDefinition ;
	linkml:description "The identifier entries use to cite this source." ;
	linkml:identifier true ;
	linkml:range <https://w3id.org/lmodel/cwe/cwe_reference_id> .
<https://w3id.org/lmodel/cwe/References> a linkml:SlotDefinition ;
	skos:closeMatch "sepses_cwe:hasReference"^^xsd:anyURI ;
	linkml:description "The external references the entry cites." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweReference> .
<https://w3id.org/lmodel/cwe/Related_Attack_Patterns> a linkml:SlotDefinition ;
	skos:closeMatch "sepses_cwe:hasCAPEC"^^xsd:anyURI ;
	linkml:description "Attack patterns that may apply where the weakness is present." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweRelatedAttackPattern> .
<https://w3id.org/lmodel/cwe/Related_Weaknesses> a linkml:SlotDefinition ;
	skos:closeMatch "sepses_cwe:hasRelatedWeakness"^^xsd:anyURI ;
	skos:relatedMatch "skos:semanticRelation"^^xsd:anyURI ;
	linkml:description "How this weakness relates to others in the list." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweRelatedWeakness> .
<https://w3id.org/lmodel/cwe/Relationship> linkml:description "More detail on how the entry relates to others." .
<https://w3id.org/lmodel/cwe/Relationships> a linkml:SlotDefinition ;
	linkml:description "The entries this grouping holds." ;
	linkml:inlined true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweRelationships> .
<https://w3id.org/lmodel/cwe/ReleaseDate> a linkml:SlotDefinition ;
	linkml:description "The release date of that version." ;
	linkml:range <https://w3id.org/lmodel/cwe/date> .
<https://w3id.org/lmodel/cwe/Removed> linkml:description "It has been taken down and may have no other copy." .
<https://w3id.org/lmodel/cwe/RequiredBy> linkml:description "For composites only: the related composite needs this weakness to be present." .
<https://w3id.org/lmodel/cwe/Requires> linkml:description "For composites only: this composite needs the related weakness to be present." .
<https://w3id.org/lmodel/cwe/Research%20Gap> linkml:description "A topic researchers have not yet explored enough." .
<https://w3id.org/lmodel/cwe/Result> linkml:description "What running the code produces." .
<https://w3id.org/lmodel/cwe/Resultant> linkml:description "The weakness exists only because another one is present." .
<https://w3id.org/lmodel/cwe/Role> a linkml:SlotDefinition ;
	linkml:description "The part the name plays when people talk about the weakness." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweAlternateTermRole> .
<https://w3id.org/lmodel/cwe/SOAR%20Partial> linkml:description "The State Of the Art Report rates it as cost-effective for part of the job." .
<https://w3id.org/lmodel/cwe/Scope> a linkml:SlotDefinition ;
	skos:closeMatch "sepses_cwe:consequenceScope"^^xsd:anyURI ;
	linkml:description "A security property the consequence violates." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweScope> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Section> a linkml:SlotDefinition ;
	linkml:description "The section or page of the source that this citation means." .
<https://w3id.org/lmodel/cwe/Secure-Development-Rules> linkml:description "It points to formal rules or guides for developing securely." .
<https://w3id.org/lmodel/cwe/Simple> linkml:description "One weakness whose exploitation does not depend on another." .
<https://w3id.org/lmodel/cwe/Stable> linkml:description "Its important elements have been checked and are not expected to change much." .
<https://w3id.org/lmodel/cwe/StartsWith> linkml:description "For a named chain only: the related weakness is where the chain begins." .
<https://w3id.org/lmodel/cwe/Status> a linkml:SlotDefinition ;
	skos:exactMatch "sepses_cwe:status"^^xsd:anyURI ;
	linkml:description "How far the entry has come and how much it can be trusted." ;
	linkml:range <https://w3id.org/lmodel/cwe/CweStatus> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Strategy> a linkml:SlotDefinition ;
	linkml:description "The general approach the mitigation follows." ;
	linkml:range <https://w3id.org/lmodel/cwe/CweMitigationStrategy> .
<https://w3id.org/lmodel/cwe/Structure> a linkml:SlotDefinition ;
	skos:exactMatch "sepses_cwe:structure"^^xsd:anyURI ;
	linkml:description "Whether the weakness stands alone or is made up of others." ;
	linkml:equals_string "Chain" , "Composite" ;
	linkml:none_of _:c14n33 ;
	linkml:range <https://w3id.org/lmodel/cwe/CweStructure> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Submission> a linkml:SlotDefinition ;
	skos:closeMatch "sepses_cwe:hasSubmissionHistory"^^xsd:anyURI ;
	linkml:description "The original submission of the entry, or each of several." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweSubmission> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Submission_Comment> a linkml:SlotDefinition ;
	linkml:description "A remark on the submission." .
<https://w3id.org/lmodel/cwe/Submission_Date> a linkml:SlotDefinition ;
	skos:exactMatch "sepses_cwe:submissionDate"^^xsd:anyURI ;
	linkml:description "The date of the submission." ;
	linkml:range <https://w3id.org/lmodel/cwe/date> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Submission_Name> a linkml:SlotDefinition ;
	skos:exactMatch "sepses_cwe:submissionName"^^xsd:anyURI ;
	linkml:description "A person or group who submitted the entry." ;
	linkml:multivalued true ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Submission_Organization> a linkml:SlotDefinition ;
	skos:exactMatch "sepses_cwe:submissionOrganization"^^xsd:anyURI ;
	linkml:description "The organization the submitter belongs to." ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Submission_ReleaseDate> a linkml:SlotDefinition ;
	linkml:description "The release date of that version." ;
	linkml:range <https://w3id.org/lmodel/cwe/date> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Submission_Version> a linkml:SlotDefinition ;
	linkml:description "The first CWE version that held the submission." ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Suggestions> a linkml:SlotDefinition ;
	linkml:description "Other weaknesses that may suit the mapping better." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweMappingSuggestion> .
<https://w3id.org/lmodel/cwe/Summary> a linkml:SlotDefinition ;
	skos:closeMatch "dcterms:description"^^xsd:anyURI ;
	linkml:description "What the grouped weaknesses have in common." ;
	linkml:range <https://w3id.org/lmodel/cwe/cwe_structured_text> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Taxonomy_Mappings> a linkml:SlotDefinition ;
	linkml:description "Links to entries of other taxonomies." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweTaxonomyMapping> .
<https://w3id.org/lmodel/cwe/Taxonomy_Name> a linkml:SlotDefinition ;
	linkml:description "The other taxonomy." ;
	linkml:range <https://w3id.org/lmodel/cwe/CweTaxonomyName> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Technical_Nuance> a linkml:SlotDefinition ;
	linkml:description "Finer technical detail that helps tell this weakness from close relatives." ;
	linkml:range <https://w3id.org/lmodel/cwe/cwe_structured_text> .
<https://w3id.org/lmodel/cwe/Technology> a linkml:SlotDefinition ;
	linkml:description "A technology, or a family of them." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweTechnologyPlatform> .
<https://w3id.org/lmodel/cwe/Term> a linkml:SlotDefinition ;
	skos:closeMatch "skos:altLabel"^^xsd:anyURI ;
	linkml:description "The name." ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Terminology> linkml:description "A discussion of the words used for the weakness." .
<https://w3id.org/lmodel/cwe/Text> linkml:description "Plain text or a format that is easy to parse, as HTML with no scripts is." .
<https://w3id.org/lmodel/cwe/Theoretical> linkml:description "The weakness described in the terms of vulnerability theory." .
<https://w3id.org/lmodel/cwe/Title> a linkml:SlotDefinition ;
	skos:exactMatch "dcterms:title"^^xsd:anyURI , "sepses_cwe:referenceTitle"^^xsd:anyURI ;
	linkml:description "The title of the source." ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Title_Text> a linkml:SlotDefinition ;
	linkml:description "A title for the example." .
<https://w3id.org/lmodel/cwe/Type> a linkml:SlotDefinition ;
	linkml:description "How the view selects and arranges its entries." , "The group." , "The kind of aspect, such as a behaviour or a resource." , "The label." , "What the note is about." , "Whether the contribution was feedback or content." ;
	linkml:range <https://w3id.org/lmodel/cwe/CweContributionType> , <https://w3id.org/lmodel/cwe/CweDimensionType> , <https://w3id.org/lmodel/cwe/CweNoteType> , <https://w3id.org/lmodel/cwe/CweReason> , <https://w3id.org/lmodel/cwe/CweStakeholderType> , <https://w3id.org/lmodel/cwe/CweViewType> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/URL> a linkml:SlotDefinition ;
	skos:closeMatch "schema:url"^^xsd:anyURI ;
	skos:exactMatch "sepses_cwe:referenceUrl"^^xsd:anyURI ;
	skos:note "One entry of CWE 5.0, REF-1068, holds the word Original here, which the XSD's anyURI admits." ;
	linkml:description "An address where the source can be read." ;
	linkml:range <https://w3id.org/lmodel/cwe/uri> .
<https://w3id.org/lmodel/cwe/URL_Date> a linkml:SlotDefinition ;
	linkml:description "The date on which the address was last seen to work." ;
	linkml:range <https://w3id.org/lmodel/cwe/date> .
<https://w3id.org/lmodel/cwe/Unknown> linkml:description "Nobody knows how likely it is." .
<https://w3id.org/lmodel/cwe/Usable> linkml:description "It has had close review and its critical elements have been checked." .
<https://w3id.org/lmodel/cwe/Usage> a linkml:SlotDefinition ;
	skos:exactMatch "sepses_cwe:mappingUsage"^^xsd:anyURI ;
	linkml:description "Whether the entry may be used for mapping." ;
	linkml:range <https://w3id.org/lmodel/cwe/CweUsage> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Value> a linkml:SlotDefinition ;
	linkml:annotations _:c14n161 , _:c14n162 , _:c14n165 , _:c14n166 , _:c14n37 ;
	linkml:any_of _:c14n13 , _:c14n77 ;
	linkml:description "The aspect itself, such as Generation or Page." , "The code, as an XHTML fragment with its special characters escaped." , "The earlier name." , "The stage." , "The text of the note." ;
	linkml:equals_string_in "Component Interaction" , "Data Collection" , "Decommissioning" , "Device / System Integration" , "Device Configuration & Personalization" , "Field Operations & Sustainment" , "Fine-tuning" , "Hardware Architecture" , "Hardware Manufacturing" , "Hardware Microarchitecture" , "Hardware Requirements" , "Implementation & Physical Design" , "Output Processing" , "Post-Manufacturing Validation" , "Pre-Manufacturing Verification" , "Prompting" , "Re-training / Feedback" , "Reuse" , "Testing" , "Tokenization" , "Training" ;
	linkml:range <https://w3id.org/lmodel/cwe/cwe_structured_text> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Variant> linkml:description "A weakness tied to a particular language, technology or kind of product." .
<https://w3id.org/lmodel/cwe/Version> a linkml:SlotDefinition ;
	linkml:description "The CWE version in which the name changed." , "The CWE version the note belongs to." , "The version of the operating system." , "The version of this release." ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Video> linkml:description "A recording with pictures, such as a conference talk." .
<https://w3id.org/lmodel/cwe/View_ID> a linkml:SlotDefinition ;
	skos:exactMatch "sepses_cwe:relatedWeaknessViewId"^^xsd:anyURI ;
	linkml:description "The view in which the link holds." ;
	linkml:pattern "^[1-9][0-9]*$" ;
	linkml:range <https://w3id.org/lmodel/cwe/CweView> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Views> a linkml:SlotDefinition ;
	linkml:description "The view entries." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweView> .
<https://w3id.org/lmodel/cwe/Weakness_Ordinalities> a linkml:SlotDefinition ;
	linkml:description "Whether the weakness tends to be a first cause or the result of another." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweWeaknessOrdinality> .
<https://w3id.org/lmodel/cwe/Weaknesses> a linkml:SlotDefinition ;
	linkml:description "The weakness entries." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweWeakness> .
<https://w3id.org/lmodel/cwe/boolean> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"boolean\"." ;
	skos:exactMatch "schema:Boolean"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "Bool" ;
	linkml:definition_uri "https://w3id.org/linkml/Boolean"^^xsd:anyURI ;
	linkml:description "A binary (true or false) value" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "bool" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI .
<https://w3id.org/lmodel/cwe/curie> dcterms:conformsTo "https://www.w3.org/TR/curie/" ;
	a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"curie\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	skos:note "in RDF serializations this MUST be expanded to a URI" , "in non-RDF serializations MAY be serialized as the compact representation" ;
	linkml:base "Curie" ;
	linkml:definition_uri "https://w3id.org/linkml/Curie"^^xsd:anyURI ;
	linkml:description "a compact URI" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/cwe/cwe> dcterms:license "Apache-2.0" ;
	dcterms:source "https://cwe.mitre.org/data/xsd/cwe_schema_v8.0.xsd"^^xsd:anyURI ;
	dcterms:title "Common Weakness Enumeration (CWE) List and Schema" ;
	pav:version "5.0" ;
	schema1:keywords "CWE" , "hardware weakness" , "root cause mapping" , "secure coding" , "software weakness" , "weakness" ;
	a linkml:SchemaDefinition ;
	rdfs:seeAlso "https://cwe.mitre.org/"^^xsd:anyURI , "https://lmodel.github.io/cwe"^^xsd:anyURI ;
	skos:note "The file behind the cwe_schema_latest.xsd link is an earlier copy of 8.0, which the catalogue breaks in 69 places. The source above is the file the catalogue itself names, and it validates with no error." , "The version is the edition of the CWE List that the schema renders, which is the first edition under XML Schema 8.0. upstream/ holds both files unchanged, tests/test_coverage.py holds the schema to the XSD, and scripts/check_upstream_release.py reports when either moves." ;
