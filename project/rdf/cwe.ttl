<https://w3id.org/lmodel/cwe/19%20Deadly%20Sins> dcterms:title "Nineteen Deadly Sins" .
<https://w3id.org/lmodel/cwe/7%20Pernicious%20Kingdoms> dcterms:title "Seven Pernicious Kingdoms" .
<https://w3id.org/lmodel/cwe/Abstraction> a linkml:SlotDefinition ;
	skos:exactMatch "sepses_cwe:abstraction"^^xsd:anyURI ;
	linkml:description "How far the weakness is described in general terms or tied to a specific product." ;
	linkml:equals_string "Compound" ;
	linkml:range <https://w3id.org/lmodel/cwe/CweAbstraction> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Access_Restrictions> a linkml:SlotDefinition ;
	linkml:description "What stands between a reader and the source." ;
	linkml:range <https://w3id.org/lmodel/cwe/CweReferenceAccessRestriction> .
<https://w3id.org/lmodel/cwe/Affected_Resources> a linkml:SlotDefinition ;
	linkml:description "The system resources that exploiting the weakness can affect." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweResource> .
<https://w3id.org/lmodel/cwe/Allowed-with-Review> linkml:description "It may be used for mapping only in limited situations and after careful review." .
<https://w3id.org/lmodel/cwe/Allowed> linkml:description "It may be used for mapping." .
<https://w3id.org/lmodel/cwe/Alt_URL> a linkml:SlotDefinition ;
	linkml:description "Another address of the source, usually one with fewer restrictions." ;
	linkml:range <https://w3id.org/lmodel/cwe/uri> .
<https://w3id.org/lmodel/cwe/Alt_URL_Date> a linkml:SlotDefinition ;
	linkml:description "The date on which the other address was last seen to work." ;
	linkml:range <https://w3id.org/lmodel/cwe/date> .
<https://w3id.org/lmodel/cwe/Alternate_Terms> a linkml:SlotDefinition ;
	linkml:description "Other names people use for the weakness." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweAlternateTerm> .
<https://w3id.org/lmodel/cwe/Applicable%20Platform> linkml:description "More detail on the platforms the entry lists." .
<https://w3id.org/lmodel/cwe/Applicable_Platforms> a linkml:SlotDefinition ;
	skos:closeMatch "sepses_cwe:hasApplicablePlatform"^^xsd:anyURI ;
	linkml:description "The languages, systems, architectures and technologies where the weakness can appear." ;
	linkml:inlined true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweApplicablePlatforms> .
<https://w3id.org/lmodel/cwe/Architecture> a linkml:SlotDefinition ;
	linkml:description "A hardware architecture, or a family of them." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweArchitecturePlatform> .
<https://w3id.org/lmodel/cwe/Attack> linkml:description "An attack against the code." .
<https://w3id.org/lmodel/cwe/Audience> a linkml:SlotDefinition ;
	linkml:description "The people who may find the view useful, and why." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweStakeholder> .
<https://w3id.org/lmodel/cwe/Audio> linkml:description "A recording with sound and no pictures." .
<https://w3id.org/lmodel/cwe/Author> a linkml:SlotDefinition ;
	skos:closeMatch "dcterms:creator"^^xsd:anyURI ;
	skos:exactMatch "sepses_cwe:referenceAuthor"^^xsd:anyURI ;
	linkml:description "A person or group who wrote the source." ;
	linkml:multivalued true .
<https://w3id.org/lmodel/cwe/Background_Details> a linkml:SlotDefinition ;
	skos:closeMatch "sepses_cwe:backgroundDetail"^^xsd:anyURI ;
	linkml:description "Background that helps a reader but does not describe the weakness itself." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/cwe_structured_text> .
<https://w3id.org/lmodel/cwe/Bad> linkml:description "Code that has the weakness." .
<https://w3id.org/lmodel/cwe/Base> linkml:description "A weakness general enough to apply widely and detailed enough to find or prevent it." .
<https://w3id.org/lmodel/cwe/Body_Text> a linkml:SlotDefinition ;
	linkml:description "Prose that explains the code around it." ;
	linkml:range <https://w3id.org/lmodel/cwe/cwe_structured_text> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/C%23> dcterms:title "C sharp" .
<https://w3id.org/lmodel/cwe/C%2B%2B> dcterms:title "C plus plus" .
<https://w3id.org/lmodel/cwe/CAPEC_ID> a linkml:SlotDefinition ;
	skos:relatedMatch "capec:CapecAttackPattern"^^xsd:anyURI ;
	linkml:description "The number of the attack pattern in the CAPEC list." ;
	linkml:range <https://w3id.org/lmodel/cwe/cwe_capec_id> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/CPE_ID> a linkml:SlotDefinition ;
	linkml:description "The Common Platform Enumeration name of the operating system." .
<https://w3id.org/lmodel/cwe/CWE%20More%20Abstract> linkml:description "The CWE entry is more general than the other." .
<https://w3id.org/lmodel/cwe/CWE%20More%20Specific> linkml:description "The CWE entry is narrower than the other." .
<https://w3id.org/lmodel/cwe/CWE_ID> a linkml:SlotDefinition ;
	skos:exactMatch "sepses_cwe:relatedCWE"^^xsd:anyURI ;
	linkml:description "The entry at the other end of the link." , "The suggested weakness." , "The weakness at the other end of the link." ;
	linkml:pattern "^[1-9][0-9]*$" ;
	linkml:range <https://w3id.org/lmodel/cwe/CweEntry> , <https://w3id.org/lmodel/cwe/CweWeakness> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/CanAlsoBe> linkml:description "In some settings this weakness may be seen as the related one, with neither being a parent of the other." .
<https://w3id.org/lmodel/cwe/CanFollow> linkml:description "In a chain, the related weakness can come before this one." .
<https://w3id.org/lmodel/cwe/CanPrecede> linkml:description "In a chain, the related weakness can come after this one." .
<https://w3id.org/lmodel/cwe/Chain> linkml:description "Several weaknesses that must be reached one after another to give a vulnerability." .
<https://w3id.org/lmodel/cwe/Chain_ID> a linkml:SlotDefinition ;
	linkml:description "The named chain that the link belongs to." ;
	linkml:pattern "^[1-9][0-9]*$" ;
	linkml:range <https://w3id.org/lmodel/cwe/CweWeakness> .
<https://w3id.org/lmodel/cwe/ChildOf> skos:closeMatch "skos:broader"^^xsd:anyURI ;
	linkml:description "The related weakness is more general than this one." .
<https://w3id.org/lmodel/cwe/Class> a linkml:SlotDefinition ;
	linkml:description "A very general weakness, usually independent of any language or technology." , "The family of architectures." , "The family of languages." , "The family of operating systems." , "The family of technologies." ;
	linkml:range <https://w3id.org/lmodel/cwe/CweArchitectureClass> , <https://w3id.org/lmodel/cwe/CweLanguageClass> , <https://w3id.org/lmodel/cwe/CweOperatingSystemClass> , <https://w3id.org/lmodel/cwe/CweTechnologyClass> .
<https://w3id.org/lmodel/cwe/Comment> a linkml:SlotDefinition ;
	linkml:description "When the suggestion applies." ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Comments> a linkml:SlotDefinition ;
	linkml:description "More advice for someone mapping to the entry." ;
	linkml:range <https://w3id.org/lmodel/cwe/cwe_structured_text> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Common-Proprietary-Text> linkml:description "A widely used proprietary format for text, such as PDF or a word processor file." .
<https://w3id.org/lmodel/cwe/Common_Consequences> a linkml:SlotDefinition ;
	skos:closeMatch "sepses_cwe:hasCommonConsequence"^^xsd:anyURI ;
	linkml:description "What can follow when the weakness is exploited." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweConsequence> .
<https://w3id.org/lmodel/cwe/Composite> linkml:description "Several weaknesses that give a vulnerability only when they occur together." .
<https://w3id.org/lmodel/cwe/Compound> linkml:description "An entry that ties two or more weaknesses together, as a chain or a composite." .
<https://w3id.org/lmodel/cwe/Consequence_ID> a linkml:SlotDefinition ;
	linkml:description "An identifier for this consequence." .
<https://w3id.org/lmodel/cwe/Content> linkml:description "Content given to the entry." .
<https://w3id.org/lmodel/cwe/Content_History> a linkml:SlotDefinition ;
	linkml:description "Who wrote the entry and how it has changed since." ;
	linkml:inlined true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweContentHistory> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Contribution> a linkml:SlotDefinition ;
	linkml:description "Feedback or content that someone gave to the entry." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweContribution> .
<https://w3id.org/lmodel/cwe/Contribution_Comment> a linkml:SlotDefinition ;
	linkml:description "A remark on the contribution." .
<https://w3id.org/lmodel/cwe/Contribution_Date> a linkml:SlotDefinition ;
	linkml:description "The date of the contribution." ;
	linkml:range <https://w3id.org/lmodel/cwe/date> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Contribution_Name> a linkml:SlotDefinition ;
	linkml:description "A person or group who contributed." ;
	linkml:multivalued true .
<https://w3id.org/lmodel/cwe/Contribution_Organization> a linkml:SlotDefinition ;
	linkml:description "The organization the contributor belongs to." .
<https://w3id.org/lmodel/cwe/Contribution_ReleaseDate> a linkml:SlotDefinition ;
	linkml:description "The release date of that version." ;
	linkml:range <https://w3id.org/lmodel/cwe/date> ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Contribution_Version> a linkml:SlotDefinition ;
	linkml:description "The first CWE version that held the contribution." ;
	linkml:required true .
<https://w3id.org/lmodel/cwe/Critical> linkml:description "The change alters what the entry means or how it may be read." .
<https://w3id.org/lmodel/cwe/Custom_Phase> a linkml:SlotDefinition ;
	linkml:description "A stage from the life cycle of a field such as hardware or AI." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cwe/CweCustomPhase> .
