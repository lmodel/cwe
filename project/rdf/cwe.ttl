	linkml:range <https://w3id.org/lmodel/cwe/CweRelatedAttackPattern> ;
	linkml:slot_uri "https://w3id.org/lmodel/cwe/Related_Attack_Patterns"^^xsd:anyURI .
<https://w3id.org/lmodel/cwe/cweWeakness__Related_Weaknesses> a linkml:SlotDefinition ;
