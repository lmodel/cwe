            owl:onProperty cwe:date ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:version ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cwe:version ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty cwe:date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:version ] ;
    skos:definition "A previous name used for a CWE entry before a substantive rename (ContentHistoryType/Previous_Entry_Name in XSD)." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

