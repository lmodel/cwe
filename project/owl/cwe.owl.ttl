	skos:inScheme cwe:cwe_entries .
cwe:Intro_Text a owl:DatatypeProperty ;
	rdfs:label "Intro_Text" ;
	skos:definition "The setting of the code, and what it is trying to do." ;
	skos:inScheme cwe:cwe_entries .
cwe:Language a owl:ObjectProperty .
cwe:Likelihood a owl:ObjectProperty ;
	rdfs:label "Likelihood" ;
	skos:definition "How likely this consequence is beside the others." ;
	skos:inScheme cwe:cwe_entries .
cwe:Likelihood_Of_Exploit a owl:ObjectProperty ;
	rdfs:label "Likelihood_Of_Exploit" ;
	skos:definition "How likely it is that the weakness gets exploited." ;
	skos:exactMatch <http://w3id.org/sepses/vocab/ref/cwe#likelihoodOfExploit> ;
	skos:inScheme cwe:cwe_entries .
cwe:Link a owl:DatatypeProperty ;
	rdfs:label "Link" ;
	skos:definition "An address with more about the case." ;
	skos:inScheme cwe:cwe_entries .
cwe:Mapping_Fit a owl:ObjectProperty ;
	rdfs:label "Mapping_Fit" ;
	skos:definition "How closely the two entries match." ;
	skos:inScheme cwe:cwe_core .
cwe:Mapping_Notes a owl:ObjectProperty ;
	rdfs:label "Mapping_Notes" ;
	skos:definition "Guidance on whether to map a real vulnerability to this entry." ;
	skos:inScheme cwe:cwe_entries .
cwe:Media_Type a owl:ObjectProperty ;
	rdfs:label "Media_Type" ;
	skos:definition "A form the source takes." ;
	skos:inScheme cwe:cwe_core .
cwe:Member_Of a owl:ObjectProperty ;
	rdfs:label "Member_Of" ;
	skos:definition "An entry that holds this one." ;
	skos:inScheme cwe:cwe_entries .
cwe:Members a owl:ObjectProperty ;
	rdfs:label "Members" ;
	skos:definition "The entries a view names one by one, when it is not selected by a filter." ;
	skos:inScheme cwe:cwe_entries .
cwe:Method a owl:ObjectProperty ;
	rdfs:label "Method" ;
	skos:definition "The way of finding the weakness." ;
	skos:exactMatch <http://w3id.org/sepses/vocab/ref/cwe#detectionMethod> ;
	skos:inScheme cwe:cwe_entries .
cwe:Mitigation_ID a owl:DatatypeProperty ;
	rdfs:label "Mitigation_ID" ;
	skos:definition "An identifier that lets entries share this text, such as MIT-5." ;
	skos:inScheme cwe:cwe_entries .
cwe:Modes_Of_Introduction a owl:ObjectProperty ;
	rdfs:label "Modes_Of_Introduction" ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/cwe#hasModeOfIntroduction> ;
	skos:definition "How and when the weakness can get into a product." ;
	skos:inScheme cwe:cwe_entries .
cwe:Modification a owl:ObjectProperty ;
	rdfs:label "Modification" ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/cwe#hasModificationHistory> , skos:changeNote ;
	skos:definition "A change made to the entry." ;
	skos:inScheme cwe:cwe_core .
cwe:Modification_Comment a owl:DatatypeProperty ;
	rdfs:label "Modification_Comment" ;
	skos:definition "What changed." ;
	skos:exactMatch <http://w3id.org/sepses/vocab/ref/cwe#modificationComment> ;
	skos:inScheme cwe:cwe_core .
cwe:Modification_Date a owl:DatatypeProperty ;
	rdfs:label "Modification_Date" ;
	skos:definition "The date of the change." ;
	skos:exactMatch <http://w3id.org/sepses/vocab/ref/cwe#modificationDate> ;
	skos:inScheme cwe:cwe_core .
cwe:Modification_Importance a owl:ObjectProperty ;
	rdfs:label "Modification_Importance" ;
	skos:definition "How much the change matters to people who rely on the entry." ;
	skos:inScheme cwe:cwe_core .
cwe:Modification_Name a owl:DatatypeProperty ;
	rdfs:label "Modification_Name" ;
	skos:definition "The person who made or suggested the change." ;
	skos:exactMatch <http://w3id.org/sepses/vocab/ref/cwe#modificationName> ;
	skos:inScheme cwe:cwe_core .
cwe:Modification_Organization a owl:DatatypeProperty ;
	rdfs:label "Modification_Organization" ;
	skos:definition "The organization that person belongs to." ;
	skos:exactMatch <http://w3id.org/sepses/vocab/ref/cwe#modificationOrganization> ;
	skos:inScheme cwe:cwe_core .
cwe:Modification_ReleaseDate a owl:DatatypeProperty ;
	rdfs:label "Modification_ReleaseDate" ;
	skos:definition "The release date of that version." ;
	skos:inScheme cwe:cwe_core .
cwe:Modification_Version a owl:DatatypeProperty ;
	rdfs:label "Modification_Version" ;
	skos:definition "The first CWE version that held the change." ;
	skos:inScheme cwe:cwe_core .
cwe:Name a owl:DatatypeProperty , owl:ObjectProperty .
cwe:Nature a owl:ObjectProperty .
cwe:Note a owl:DatatypeProperty .
cwe:Notes a owl:ObjectProperty ;
	rdfs:label "Notes" ;
	skos:closeMatch skos:note ;
	skos:definition "Remarks on the entry that fit nowhere else." ;
	skos:inScheme cwe:cwe_entries .
cwe:Objective a owl:DatatypeProperty ;
	rdfs:label "Objective" ;
	skos:closeMatch dcterms:description ;
	skos:definition "What the view is for." ;
	skos:inScheme cwe:cwe_entries .
cwe:Observed_Examples a owl:ObjectProperty ;
	rdfs:label "Observed_Examples" ;
	skos:definition "Real cases of the weakness, usually CVE records." ;
	skos:inScheme cwe:cwe_entries .
cwe:Operating_System a owl:ObjectProperty ;
	rdfs:label "Operating_System" ;
	skos:definition "An operating system, or a family of them." ;
	skos:inScheme cwe:cwe_entries .
cwe:Ordinal a owl:ObjectProperty ;
	rdfs:label "Ordinal" ;
	skos:definition "Marks this as the link to prefer in the view." ;
	skos:exactMatch <http://w3id.org/sepses/vocab/ref/cwe#relatedWeaknessOrdinal> ;
	skos:inScheme cwe:cwe_entries .
cwe:Ordinality a owl:ObjectProperty ;
	rdfs:label "Ordinality" ;
	skos:definition "The position in the sequence of causes." ;
	skos:exactMatch <http://w3id.org/sepses/vocab/ref/cwe#weaknessOrdinality> ;
	skos:inScheme cwe:cwe_entries .
cwe:Phase a owl:ObjectProperty .
cwe:Potential_Mitigations a owl:ObjectProperty ;
	rdfs:label "Potential_Mitigations" ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/cwe#hasPotentialMitigation> ;
	skos:definition "Ways of preventing the weakness or reducing what it can do." ;
	skos:inScheme cwe:cwe_entries .
cwe:Prevalence a owl:ObjectProperty .
cwe:Previous_Entry_Name a owl:ObjectProperty ;
	rdfs:label "Previous_Entry_Name" ;
	skos:definition "A name the entry used to have." ;
	skos:inScheme cwe:cwe_core .
cwe:Publication a owl:DatatypeProperty ;
	rdfs:label "Publication" ;
	skos:definition "The journal, conference or other publication that holds the source." ;
	skos:inScheme cwe:cwe_core .
cwe:Publication_Day a owl:DatatypeProperty ;
	rdfs:label "Publication_Day" ;
	skos:definition "The day of the month the source came out." ;
	skos:exactMatch <http://w3id.org/sepses/vocab/ref/cwe#referencePublicationDay> ;
	skos:inScheme cwe:cwe_core .
cwe:Publication_Month a owl:DatatypeProperty ;
	rdfs:label "Publication_Month" ;
	skos:definition "The month the source came out." ;
	skos:exactMatch <http://w3id.org/sepses/vocab/ref/cwe#referencePublicationMonth> ;
	skos:inScheme cwe:cwe_core .
cwe:Publication_Year a owl:DatatypeProperty ;
	rdfs:label "Publication_Year" ;
	skos:definition "The year the source came out." ;
	skos:exactMatch <http://w3id.org/sepses/vocab/ref/cwe#referencePublicationYear> ;
	skos:inScheme cwe:cwe_core .
cwe:Publisher a owl:DatatypeProperty ;
	rdfs:label "Publisher" ;
	skos:closeMatch dcterms:publisher ;
	skos:definition "Who published the source." ;
	skos:exactMatch <http://w3id.org/sepses/vocab/ref/cwe#referencePublisher> ;
	skos:inScheme cwe:cwe_core .
cwe:Rationale a owl:DatatypeProperty , owl:ObjectProperty .
cwe:Reasons a owl:ObjectProperty ;
	rdfs:label "Reasons" ;
	skos:definition "Short labels that sum up the usage." ;
	skos:inScheme cwe:cwe_entries .
cwe:Reference a owl:DatatypeProperty ;
	rdfs:label "Reference" ;
	skos:definition "The identifier of the case, such as a CVE identifier." ;
	skos:inScheme cwe:cwe_entries ;
	skos:note "In CWE 5.0 it holds a CVE identifier in 3173 of 3183 cases and an external reference such as [REF-1100] in the rest, so lmodel/cve's cveId is only related." ;
	skos:relatedMatch <https://w3id.org/lmodel/cve/cveId> .
cwe:Reference_ID a owl:DatatypeProperty ;
	rdfs:label "Reference_ID" ;
	skos:definition "The identifier entries use to cite this source." ;
	skos:inScheme cwe:cwe_core .
cwe:References a owl:ObjectProperty ;
	rdfs:label "References" ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/cwe#hasReference> ;
	skos:definition "The external references the entry cites." ;
	skos:inScheme cwe:cwe_entries .
cwe:Related_Attack_Patterns a owl:ObjectProperty ;
	rdfs:label "Related_Attack_Patterns" ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/cwe#hasCAPEC> ;
	skos:definition "Attack patterns that may apply where the weakness is present." ;
	skos:inScheme cwe:cwe_entries .
cwe:Related_Weaknesses a owl:ObjectProperty ;
	rdfs:label "Related_Weaknesses" ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/cwe#hasRelatedWeakness> ;
	skos:definition "How this weakness relates to others in the list." ;
	skos:inScheme cwe:cwe_entries ;
	skos:relatedMatch skos:semanticRelation .
cwe:Relationships a owl:ObjectProperty ;
	rdfs:label "Relationships" ;
	skos:definition "The entries this grouping holds." ;
	skos:inScheme cwe:cwe_entries .
cwe:ReleaseDate a owl:DatatypeProperty ;
	rdfs:label "ReleaseDate" ;
	skos:definition "The release date of that version." ;
	skos:inScheme cwe:cwe_core .
cwe:Role a owl:ObjectProperty ;
	rdfs:label "Role" ;
	skos:definition "The part the name plays when people talk about the weakness." ;
	skos:inScheme cwe:cwe_entries .
cwe:Scope a owl:ObjectProperty ;
	rdfs:label "Scope" ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/cwe#consequenceScope> ;
	skos:definition "A security property the consequence violates." ;
	skos:inScheme cwe:cwe_entries .
cwe:Section a owl:DatatypeProperty ;
	rdfs:label "Section" ;
	skos:definition "The section or page of the source that this citation means." ;
	skos:inScheme cwe:cwe_core .
cwe:Status a owl:ObjectProperty ;
	rdfs:label "Status" ;
	skos:definition "How far the entry has come and how much it can be trusted." ;
	skos:exactMatch <http://w3id.org/sepses/vocab/ref/cwe#status> ;
	skos:inScheme cwe:cwe_entries .
cwe:Strategy a owl:ObjectProperty ;
	rdfs:label "Strategy" ;
	skos:definition "The general approach the mitigation follows." ;
	skos:inScheme cwe:cwe_entries .
cwe:Structure a owl:ObjectProperty ;
	rdfs:label "Structure" ;
	skos:definition "Whether the weakness stands alone or is made up of others." ;
	skos:exactMatch <http://w3id.org/sepses/vocab/ref/cwe#structure> ;
	skos:inScheme cwe:cwe_entries .
cwe:Submission a owl:ObjectProperty ;
	rdfs:label "Submission" ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/cwe#hasSubmissionHistory> ;
	skos:definition "The original submission of the entry, or each of several." ;
	skos:inScheme cwe:cwe_core .
cwe:Submission_Comment a owl:DatatypeProperty ;
	rdfs:label "Submission_Comment" ;
	skos:definition "A remark on the submission." ;
	skos:inScheme cwe:cwe_core .
cwe:Submission_Date a owl:DatatypeProperty ;
	rdfs:label "Submission_Date" ;
	skos:definition "The date of the submission." ;
	skos:exactMatch <http://w3id.org/sepses/vocab/ref/cwe#submissionDate> ;
	skos:inScheme cwe:cwe_core .
cwe:Submission_Name a owl:DatatypeProperty ;
	rdfs:label "Submission_Name" ;
	skos:definition "A person or group who submitted the entry." ;
	skos:exactMatch <http://w3id.org/sepses/vocab/ref/cwe#submissionName> ;
	skos:inScheme cwe:cwe_core .
cwe:Submission_Organization a owl:DatatypeProperty ;
	rdfs:label "Submission_Organization" ;
	skos:definition "The organization the submitter belongs to." ;
	skos:exactMatch <http://w3id.org/sepses/vocab/ref/cwe#submissionOrganization> ;
	skos:inScheme cwe:cwe_core .
cwe:Submission_ReleaseDate a owl:DatatypeProperty ;
	rdfs:label "Submission_ReleaseDate" ;
	skos:definition "The release date of that version." ;
	skos:inScheme cwe:cwe_core .
cwe:Submission_Version a owl:DatatypeProperty ;
	rdfs:label "Submission_Version" ;
	skos:definition "The first CWE version that held the submission." ;
	skos:inScheme cwe:cwe_core .
cwe:Suggestions a owl:ObjectProperty ;
	rdfs:label "Suggestions" ;
	skos:definition "Other weaknesses that may suit the mapping better." ;
	skos:inScheme cwe:cwe_entries .
cwe:Summary a owl:DatatypeProperty ;
	rdfs:label "Summary" ;
	skos:closeMatch dcterms:description ;
	skos:definition "What the grouped weaknesses have in common." ;
	skos:inScheme cwe:cwe_entries .
cwe:Taxonomy_Mappings a owl:ObjectProperty .
cwe:Taxonomy_Name a owl:ObjectProperty ;
	rdfs:label "Taxonomy_Name" ;
	skos:definition "The other taxonomy." ;
	skos:inScheme cwe:cwe_core .
cwe:Technical_Nuance a owl:DatatypeProperty ;
	rdfs:label "Technical_Nuance" ;
	skos:definition "Finer technical detail that helps tell this weakness from close relatives." ;
	skos:inScheme cwe:cwe_entries .
cwe:Technology a owl:ObjectProperty ;
	rdfs:label "Technology" ;
	skos:definition "A technology, or a family of them." ;
	skos:inScheme cwe:cwe_entries .
cwe:Term a owl:DatatypeProperty ;
	rdfs:label "Term" ;
	skos:closeMatch skos:altLabel ;
	skos:definition "The name." ;
	skos:inScheme cwe:cwe_entries .
cwe:Title a owl:DatatypeProperty ;
	rdfs:label "Title" ;
	skos:definition "The title of the source." ;
	skos:exactMatch dcterms:title , <http://w3id.org/sepses/vocab/ref/cwe#referenceTitle> ;
	skos:inScheme cwe:cwe_core .
cwe:Title_Text a owl:DatatypeProperty ;
	rdfs:label "Title_Text" ;
	skos:definition "A title for the example." ;
	skos:inScheme cwe:cwe_entries .
cwe:Type a owl:ObjectProperty .
cwe:URL a owl:DatatypeProperty ;
	rdfs:label "URL" ;
	skos:closeMatch schema1:url ;
	skos:definition "An address where the source can be read." ;
	skos:exactMatch <http://w3id.org/sepses/vocab/ref/cwe#referenceUrl> ;
	skos:inScheme cwe:cwe_core ;
	skos:note "One entry of CWE 5.0, REF-1068, holds the word Original here, which the XSD's anyURI admits." .
cwe:URL_Date a owl:DatatypeProperty ;
	rdfs:label "URL_Date" ;
	skos:definition "The date on which the address was last seen to work." ;
	skos:inScheme cwe:cwe_core .
cwe:Usage a owl:ObjectProperty ;
	rdfs:label "Usage" ;
	skos:definition "Whether the entry may be used for mapping." ;
	skos:exactMatch <http://w3id.org/sepses/vocab/ref/cwe#mappingUsage> ;
	skos:inScheme cwe:cwe_entries .
cwe:Value a owl:DatatypeProperty .
cwe:Version a owl:DatatypeProperty .
cwe:View_ID a owl:ObjectProperty .
cwe:Views a owl:ObjectProperty ;
	rdfs:label "Views" ;
	skos:definition "The view entries." ;
	skos:inScheme <https://w3id.org/lmodel/cwe> .
cwe:Weakness_Ordinalities a owl:ObjectProperty ;
	rdfs:label "Weakness_Ordinalities" ;
	skos:definition "Whether the weakness tends to be a first cause or the result of another." ;
	skos:inScheme cwe:cwe_entries .
cwe:Weaknesses a owl:ObjectProperty ;
	rdfs:label "Weaknesses" ;
	skos:definition "The weakness entries." ;
	skos:inScheme <https://w3id.org/lmodel/cwe> .
