	skos:inScheme cwe:cwe_entries .
cwe:Exploitation_Factors a owl:DatatypeProperty ;
	rdfs:label "Exploitation_Factors" ;
	skos:definition "Conditions that make exploiting the weakness more likely." ;
	skos:inScheme cwe:cwe_entries .
cwe:Extended_Description a owl:DatatypeProperty ;
	rdfs:label "Extended_Description" ;
	skos:definition "More about the weakness than its short description gives." ;
	skos:exactMatch <http://w3id.org/sepses/vocab/ref/cwe#extendedDescription> ;
	skos:inScheme cwe:cwe_entries .
