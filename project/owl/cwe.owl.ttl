cwe:taxonomy_mappings a owl:ObjectProperty ;
    rdfs:label "taxonomy_mappings" ;
    rdfs:range cwe:TaxonomyMapping ;
    skos:definition "Mappings to equivalent entries in external taxonomies." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:ArchitectureClass a owl:Class ;
    rdfs:label "ArchitectureClass" ;
    owl:unionOf ( <https://w3id.org/lmodel/cwe/ArchitectureClass#EMBEDDED> <https://w3id.org/lmodel/cwe/ArchitectureClass#MICROCOMPUTER> <https://w3id.org/lmodel/cwe/ArchitectureClass#WORKSTATION> <https://w3id.org/lmodel/cwe/ArchitectureClass#NOT_ARCHITECTURE_SPECIFIC> ) ;
    skos:definition "Class of processor architecture (ArchitectureClassEnumeration in XSD)." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> ;
    linkml:permissible_values <https://w3id.org/lmodel/cwe/ArchitectureClass#EMBEDDED>,
        <https://w3id.org/lmodel/cwe/ArchitectureClass#MICROCOMPUTER>,
        <https://w3id.org/lmodel/cwe/ArchitectureClass#NOT_ARCHITECTURE_SPECIFIC>,
        <https://w3id.org/lmodel/cwe/ArchitectureClass#WORKSTATION> .

cwe:CWEReference a owl:Class ;
    rdfs:label "CWEReference" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cwe:section ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:section ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:external_reference_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:external_reference_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cwe:external_reference_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:section ] ;
    skos:definition "Link from a CWE entry to an ExternalReference in the catalog (ReferencesType/Reference in XSD)." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:WeaknessOrdinalityLevel a owl:Class ;
    rdfs:label "WeaknessOrdinalityLevel" ;
    owl:unionOf ( <https://w3id.org/lmodel/cwe/WeaknessOrdinalityLevel#PRIMARY> <https://w3id.org/lmodel/cwe/WeaknessOrdinalityLevel#RESULTANT> <https://w3id.org/lmodel/cwe/WeaknessOrdinalityLevel#INDIRECT> ) ;
    skos:definition "Potential ordering relationship of a weakness relative to others (OrdinalityEnumeration in XSD)." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> ;
    linkml:permissible_values <https://w3id.org/lmodel/cwe/WeaknessOrdinalityLevel#INDIRECT>,
        <https://w3id.org/lmodel/cwe/WeaknessOrdinalityLevel#PRIMARY>,
        <https://w3id.org/lmodel/cwe/WeaknessOrdinalityLevel#RESULTANT> .

cwe:WeaknessStructure a owl:Class ;
    rdfs:label "WeaknessStructure" ;
    owl:unionOf ( <https://w3id.org/lmodel/cwe/WeaknessStructure#SIMPLE> <https://w3id.org/lmodel/cwe/WeaknessStructure#CHAIN> <https://w3id.org/lmodel/cwe/WeaknessStructure#COMPOSITE> ) ;
    skos:definition "Structural nature of a weakness (StructureEnumeration in XSD)." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> ;
    linkml:permissible_values <https://w3id.org/lmodel/cwe/WeaknessStructure#CHAIN>,
        <https://w3id.org/lmodel/cwe/WeaknessStructure#COMPOSITE>,
        <https://w3id.org/lmodel/cwe/WeaknessStructure#SIMPLE> .

cwe:CatalogMember a owl:Class ;
    rdfs:label "CatalogMember" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:view_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:cwe_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty cwe:view_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty cwe:cwe_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:cwe_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:view_id ] ;
    skos:definition "A Has_Member or Member_Of entry specifying a CWE ID and the View ID in which the membership holds (MemberType in XSD)." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

