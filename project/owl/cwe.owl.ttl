	rdfs:subClassOf cwe:CweAiPhase .
cwe:CweAiPhase\#Testing a owl:Class ;
	rdfs:label "Testing" ;
	rdfs:subClassOf cwe:CweAiPhase .
cwe:CweAiPhase\#Tokenization a owl:Class ;
