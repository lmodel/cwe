cwe:exploitation_factors a owl:DatatypeProperty ;
    rdfs:label "exploitation_factors" ;
    rdfs:range xsd:string ;
    skos:definition "Conditions that could increase the likelihood of exploit." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:external_references a owl:ObjectProperty ;
    rdfs:label "external_references" ;
    rdfs:range cwe:ExternalReference ;
    skos:definition "External references shared across CWE entries in this catalog." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:functional_areas a owl:ObjectProperty ;
    rdfs:label "functional_areas" ;
    rdfs:range cwe:FunctionalArea ;
    skos:definition "Functional areas in which this weakness is most likely to occur." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:has_member a owl:ObjectProperty ;
    rdfs:label "has_member" ;
    rdfs:range cwe:CatalogMember ;
    skos:definition "CWE entries that belong to this category or view." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:impacts a owl:ObjectProperty ;
    rdfs:label "impacts" ;
    rdfs:range cwe:TechnicalImpact ;
    skos:definition "Technical impacts that arise if the weakness is exploited." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:languages a owl:ObjectProperty ;
    rdfs:label "languages" ;
    rdfs:range cwe:LanguagePlatform ;
    skos:definition "Programming languages applicable to this weakness." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:member_of a owl:ObjectProperty ;
    rdfs:label "member_of" ;
    rdfs:range cwe:CatalogMember ;
    skos:definition "Views or categories that this entry belongs to." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:members a owl:ObjectProperty ;
    rdfs:label "members" ;
    rdfs:range cwe:CatalogMember ;
    skos:definition "Member entries for a CWE view." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:modes_of_introduction a owl:ObjectProperty ;
    rdfs:label "modes_of_introduction" ;
    rdfs:range cwe:ModeOfIntroduction ;
    skos:definition "Information about how and when this weakness may be introduced." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:modifications a owl:ObjectProperty ;
    rdfs:label "modifications" ;
    rdfs:range cwe:Modification ;
    skos:definition "Ordered list of modifications made to this entry." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:observations a owl:ObjectProperty ;
    rdfs:label "observations" ;
    rdfs:range cwe:NVDWeaknessObservation ;
    skos:definition "Weakness observations from NVD vulnerability detail pages." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:observed_examples a owl:ObjectProperty ;
    rdfs:label "observed_examples" ;
    rdfs:range cwe:ObservedExample ;
    skos:definition "Real-world instances of this weakness." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:operating_systems a owl:ObjectProperty ;
    rdfs:label "operating_systems" ;
    rdfs:range cwe:OSPlatform ;
    skos:definition "Operating systems applicable to this weakness." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:phases a owl:ObjectProperty ;
    rdfs:label "phases" ;
    rdfs:range cwe:LifecyclePhase ;
    skos:definition "Lifecycle phases during which a mitigation may be applied." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:potential_mitigations a owl:ObjectProperty ;
    rdfs:label "potential_mitigations" ;
    rdfs:range cwe:PotentialMitigation ;
    skos:definition "Potential mitigations associated with this weakness." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:previous_entry_names a owl:ObjectProperty ;
    rdfs:label "previous_entry_names" ;
    rdfs:range cwe:PreviousEntryName ;
    skos:definition "Previous names used for this entry before a substantive rename." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:reasons a owl:ObjectProperty ;
    rdfs:label "reasons" ;
    rdfs:range cwe:MappingReason ;
    skos:definition "Vocabulary summary of the mapping usage recommendation." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:related_attack_patterns a owl:DatatypeProperty ;
    rdfs:label "related_attack_patterns" ;
    rdfs:range xsd:integer ;
    skos:definition "CAPEC identifiers of attack patterns associated with this weakness." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:related_weaknesses a owl:ObjectProperty ;
    rdfs:label "related_weaknesses" ;
    rdfs:range cwe:RelatedWeakness ;
    skos:definition "Typed relationships to other CWE entries." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:scopes a owl:ObjectProperty ;
    rdfs:label "scopes" ;
    rdfs:range cwe:SecurityScope ;
    skos:definition "Security properties violated by this consequence." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:suggestions a owl:ObjectProperty ;
    rdfs:label "suggestions" ;
    rdfs:range cwe:MappingSuggestion ;
    skos:definition "Suggested alternative CWE entries for mapping." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:tags a owl:DatatypeProperty ;
    rdfs:label "tags" ;
    rdfs:range xsd:string ;
    skos:definition "Free-form tags for grouping and downstream filtering." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:technologies a owl:ObjectProperty ;
    rdfs:label "technologies" ;
    rdfs:range cwe:TechnologyPlatform ;
    skos:definition "Technologies applicable to this weakness." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:views a owl:ObjectProperty ;
    rdfs:label "views" ;
    rdfs:range cwe:View ;
    skos:definition "CWE views providing different perspectives on the catalog." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:weakness_ordinalities a owl:ObjectProperty ;
    rdfs:label "weakness_ordinalities" ;
    rdfs:range cwe:WeaknessOrdinality ;
    skos:definition "Potential ordering relationships of this weakness with others." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:weaknesses a owl:ObjectProperty ;
    rdfs:label "weaknesses" ;
    rdfs:range cwe:Weakness ;
    skos:definition "Canonical CWE weakness entries in this catalog snapshot." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:ContributionType a owl:Class ;
    rdfs:label "ContributionType" ;
    owl:unionOf ( <https://w3id.org/lmodel/cwe/ContributionType#CONTENT> <https://w3id.org/lmodel/cwe/ContributionType#FEEDBACK> ) ;
    skos:definition "Whether a contribution was donated content or general feedback." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> ;
    linkml:permissible_values <https://w3id.org/lmodel/cwe/ContributionType#CONTENT>,
        <https://w3id.org/lmodel/cwe/ContributionType#FEEDBACK> .

cwe:OrdinalQualifier a owl:Class ;
    rdfs:label "OrdinalQualifier" ;
    skos:definition "Marks a related-weakness relationship as the primary one for a given <Nature, CWE_ID, View_ID> triple (OrdinalEnumeration in XSD)." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> ;
    linkml:permissible_values <https://w3id.org/lmodel/cwe/OrdinalQualifier#PRIMARY> .

cwe:TaxonomyMapping a owl:Class ;
    rdfs:label "TaxonomyMapping" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:entry_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cwe:entry_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:taxonomy_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:TaxonomyName ;
            owl:onProperty cwe:taxonomy_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:entry_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:entry_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:taxonomy_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cwe:entry_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:entry_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:mapping_fit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:mapping_fit ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:TaxonomyMappingFit ;
            owl:onProperty cwe:mapping_fit ] ;
    skos:definition "A mapping from a CWE entry to an equivalent entry in an external taxonomy (TaxonomyMappingsType/Taxonomy_Mapping in XSD)." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:abstraction a owl:ObjectProperty ;
    rdfs:label "abstraction" ;
    rdfs:range cwe:WeaknessAbstraction ;
    skos:definition "CWE abstraction tier (e.g. Base or Variant)." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:applicable_platforms a owl:ObjectProperty ;
    rdfs:label "applicable_platforms" ;
    rdfs:range cwe:ApplicablePlatforms ;
    skos:definition "Languages, OS, architectures, and technologies where this weakness can appear." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:chain_id a owl:DatatypeProperty ;
    rdfs:label "chain_id" ;
    rdfs:range xsd:integer ;
    skos:definition "ID of a named chain for CanFollow/CanPrecede relationships." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:comment a owl:DatatypeProperty ;
    rdfs:label "comment" ;
    rdfs:range xsd:string ;
    skos:definition "Explanatory comment (e.g. on a mapping suggestion)." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:comments a owl:DatatypeProperty ;
    rdfs:label "comments" ;
    rdfs:range xsd:string ;
    skos:definition "Further clarification for the mapping notes reader." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:consequence_id a owl:DatatypeProperty ;
    rdfs:label "consequence_id" ;
    rdfs:range xsd:string ;
    skos:definition "Unique identifier for a common consequence (e.g. CC-1)." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:contribution_comment a owl:DatatypeProperty ;
    rdfs:label "contribution_comment" ;
    rdfs:range xsd:string ;
    skos:definition "Comment related to the contribution." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:contribution_date a owl:DatatypeProperty ;
    rdfs:label "contribution_date" ;
    rdfs:range xsd:date ;
    skos:definition "Date of the contribution." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:contribution_name a owl:DatatypeProperty ;
    rdfs:label "contribution_name" ;
    rdfs:range xsd:string ;
    skos:definition "Name of the contributor." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:contribution_organization a owl:DatatypeProperty ;
    rdfs:label "contribution_organization" ;
    rdfs:range xsd:string ;
    skos:definition "Organization of the contributor." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:contribution_release_date a owl:DatatypeProperty ;
    rdfs:label "contribution_release_date" ;
    rdfs:range xsd:date ;
    skos:definition "Release date of the CWE version containing the contribution." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:contribution_version a owl:DatatypeProperty ;
    rdfs:label "contribution_version" ;
    rdfs:range xsd:string ;
    skos:definition "CWE version in which the contribution first appeared." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:cpe_id a owl:DatatypeProperty ;
    rdfs:label "cpe_id" ;
    rdfs:range xsd:string ;
    skos:definition "CPE identifier for a platform." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:demonstrative_example_id a owl:DatatypeProperty ;
    rdfs:label "demonstrative_example_id" ;
    rdfs:range xsd:string ;
    skos:definition "Unique identifier for a demonstrative example (e.g. DX-1)." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:detection_method_id a owl:DatatypeProperty ;
    rdfs:label "detection_method_id" ;
    rdfs:range xsd:string ;
    skos:definition "Unique identifier for a detection method entry (e.g. DM-1)." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:diagram a owl:DatatypeProperty ;
    rdfs:label "diagram" ;
    rdfs:range xsd:string ;
    skos:definition "Optional diagram filename or reference associated with the entry." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:edition a owl:DatatypeProperty ;
    rdfs:label "edition" ;
    rdfs:range xsd:string ;
    skos:definition "Edition of the material being referenced." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:entry_id a owl:DatatypeProperty ;
    rdfs:label "entry_id" ;
    rdfs:range xsd:string ;
    skos:definition "ID of the entry in the external taxonomy." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:entry_name a owl:DatatypeProperty ;
    rdfs:label "entry_name" ;
    rdfs:range xsd:string ;
    skos:definition "Name of the entry in the external taxonomy." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:extended_description a owl:DatatypeProperty ;
    rdfs:label "extended_description" ;
    rdfs:range xsd:string ;
    skos:definition "Extended description providing additional details beyond the core concept." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:external_reference_id a owl:DatatypeProperty ;
    rdfs:label "external_reference_id" ;
    rdfs:range xsd:string ;
    skos:definition "Identifier of the ExternalReference being linked to (e.g. REF-1)." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:filter a owl:DatatypeProperty ;
    rdfs:label "filter" ;
    rdfs:range xsd:string ;
    skos:definition "XSL query identifying members of an implicit slice view." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:intro_text a owl:DatatypeProperty ;
    rdfs:label "intro_text" ;
    rdfs:range xsd:string ;
    skos:definition "Context and setting for the demonstrative example." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:language a owl:ObjectProperty ;
    rdfs:label "language" ;
    rdfs:range cwe:ProgrammingLanguage ;
    skos:definition "Programming language for a code example or platform context." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:likelihood a owl:ObjectProperty ;
    rdfs:label "likelihood" ;
    rdfs:range cwe:LikelihoodLevel ;
    skos:definition "Likelihood of this specific consequence." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:likelihood_of_exploit a owl:ObjectProperty ;
    rdfs:label "likelihood_of_exploit" ;
    rdfs:range cwe:LikelihoodLevel ;
    skos:definition "Qualitative likelihood that the weakness can be exploited." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:link a owl:DatatypeProperty ;
    rdfs:label "link" ;
    rdfs:range xsd:anyURI ;
    skos:definition "URL providing more information about the observed example." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:mapping_fit a owl:ObjectProperty ;
    rdfs:label "mapping_fit" ;
    rdfs:range cwe:TaxonomyMappingFit ;
    skos:definition "How close the CWE entry is to the mapped taxonomy entry." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:method a owl:DatatypeProperty ;
    rdfs:label "method" ;
    rdfs:range xsd:string ;
    skos:definition "Detection method (range narrowed per class via slot_usage)." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:mitigation_id a owl:DatatypeProperty ;
    rdfs:label "mitigation_id" ;
    rdfs:range xsd:string ;
    skos:definition "Unique identifier for a potential mitigation (e.g. MIT-1)." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:modification_comment a owl:DatatypeProperty ;
    rdfs:label "modification_comment" ;
    rdfs:range xsd:string ;
    skos:definition "Comment describing what was changed." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:modification_date a owl:DatatypeProperty ;
    rdfs:label "modification_date" ;
    rdfs:range xsd:date ;
    skos:definition "Date on which the modification was made." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:modification_importance a owl:ObjectProperty ;
    rdfs:label "modification_importance" ;
    rdfs:range cwe:ContentImportance ;
    skos:definition "Importance level of this modification." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:modification_name a owl:DatatypeProperty ;
    rdfs:label "modification_name" ;
    rdfs:range xsd:string ;
    skos:definition "Name of the person who made the modification." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:modification_organization a owl:DatatypeProperty ;
    rdfs:label "modification_organization" ;
    rdfs:range xsd:string ;
    skos:definition "Organization of the modifier." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:modification_release_date a owl:DatatypeProperty ;
    rdfs:label "modification_release_date" ;
    rdfs:range xsd:date ;
    skos:definition "Release date of the CWE version containing the modification." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:modification_version a owl:DatatypeProperty ;
    rdfs:label "modification_version" ;
    rdfs:range xsd:string ;
    skos:definition "CWE version in which the modification first appeared." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:objective a owl:DatatypeProperty ;
    rdfs:label "objective" ;
    rdfs:range xsd:string ;
    skos:definition "Perspective from which a view has been constructed." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:observation_id a owl:DatatypeProperty ;
    rdfs:label "observation_id" ;
    rdfs:range xsd:string ;
    skos:definition "Identifier for an NVD weakness observation row." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:observed_in_cve a owl:DatatypeProperty ;
    rdfs:label "observed_in_cve" ;
    rdfs:range xsd:string ;
    skos:definition "CVE identifier where this weakness observation appears." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:ordinal a owl:ObjectProperty ;
    rdfs:label "ordinal" ;
    rdfs:range cwe:OrdinalQualifier ;
    skos:definition "Set to \"Primary\" for the primary ChildOf relationship in the given view." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:ordinality a owl:ObjectProperty ;
    rdfs:label "ordinality" ;
    rdfs:range cwe:WeaknessOrdinalityLevel ;
    skos:definition "Ordinality level (Primary, Resultant, or Indirect)." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:phase a owl:ObjectProperty ;
    rdfs:label "phase" ;
    rdfs:range cwe:LifecyclePhase ;
    skos:definition "Lifecycle phase for introduction or mitigation." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:publication a owl:DatatypeProperty ;
    rdfs:label "publication" ;
    rdfs:range xsd:string ;
    skos:definition "Name of the magazine or journal." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:publication_day a owl:DatatypeProperty ;
    rdfs:label "publication_day" ;
    rdfs:range xsd:string ;
    skos:definition "Day of publication in ---DD format." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:publication_month a owl:DatatypeProperty ;
    rdfs:label "publication_month" ;
    rdfs:range xsd:string ;
    skos:definition "Month of publication in --MM format." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:publication_year a owl:DatatypeProperty ;
    rdfs:label "publication_year" ;
    rdfs:range xsd:string ;
    skos:definition "Year of publication in YYYY format." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:publisher a owl:DatatypeProperty ;
    rdfs:label "publisher" ;
    rdfs:range xsd:string ;
    skos:definition "Publisher of the referenced material." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:rationale a owl:DatatypeProperty ;
    rdfs:label "rationale" ;
    rdfs:range xsd:string ;
    skos:definition "Context for the mapping usage designation." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:reference a owl:DatatypeProperty ;
    rdfs:label "reference" ;
    rdfs:range xsd:string ;
    skos:definition "Identifier for a real-world example (e.g. CVE-2005-1951)." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:reference_id a owl:DatatypeProperty ;
    rdfs:label "reference_id" ;
    rdfs:range xsd:string ;
    skos:definition "Globally unique identifier for an external reference (e.g. REF-1)." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:relationships a owl:ObjectProperty ;
    rdfs:label "relationships" ;
    rdfs:range cwe:Relationship ;
    skos:definition "Membership relationships for a CWE category." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:reported_by a owl:ObjectProperty ;
    rdfs:label "reported_by" ;
    rdfs:range cwe:WeaknessSource ;
    skos:definition "Source label for the weakness row (e.g. NIST, ASSIGNER)." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:section a owl:DatatypeProperty ;
    rdfs:label "section" ;
    rdfs:range xsd:string ;
    skos:definition "Section title or page number specific to this use of the reference." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:strategy a owl:ObjectProperty ;
    rdfs:label "strategy" ;
    rdfs:range cwe:MitigationStrategy ;
    skos:definition "General protection strategy to which a mitigation contributes." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:structure a owl:ObjectProperty ;
    rdfs:label "structure" ;
    rdfs:range cwe:WeaknessStructure ;
    skos:definition "Structural nature of the weakness (Simple, Chain, or Composite)." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:submission a owl:ObjectProperty ;
    rdfs:label "submission" ;
    rdfs:range cwe:Submission ;
    skos:definition "Initial submission information for this entry." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:submission_comment a owl:DatatypeProperty ;
    rdfs:label "submission_comment" ;
    rdfs:range xsd:string ;
    skos:definition "Optional comment related to the submission." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:submission_date a owl:DatatypeProperty ;
    rdfs:label "submission_date" ;
    rdfs:range xsd:date ;
    skos:definition "Date on which this entry was submitted." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:submission_name a owl:DatatypeProperty ;
    rdfs:label "submission_name" ;
    rdfs:range xsd:string ;
    skos:definition "Name of the person who submitted this entry." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:submission_organization a owl:DatatypeProperty ;
    rdfs:label "submission_organization" ;
    rdfs:range xsd:string ;
    skos:definition "Organization of the submitter." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:submission_release_date a owl:DatatypeProperty ;
    rdfs:label "submission_release_date" ;
    rdfs:range xsd:date ;
    skos:definition "Release date of the CWE version that added this entry." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:submission_version a owl:DatatypeProperty ;
    rdfs:label "submission_version" ;
    rdfs:range xsd:string ;
    skos:definition "CWE version in which this entry was first added." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:summary a owl:DatatypeProperty ;
    rdfs:label "summary" ;
    rdfs:range xsd:string ;
    skos:definition "Key points that define a category." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:taxonomy_name a owl:ObjectProperty ;
    rdfs:label "taxonomy_name" ;
    rdfs:range cwe:TaxonomyName ;
    skos:definition "Name of the external taxonomy to which the mapping is made." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:term a owl:DatatypeProperty ;
    rdfs:label "term" ;
    rdfs:range xsd:string ;
    skos:definition "An alternate term by which this weakness may be known." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:title a owl:DatatypeProperty ;
    rdfs:label "title" ;
    rdfs:range xsd:string ;
    skos:definition "Descriptive title for a reference or catalog element." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:title_text a owl:DatatypeProperty ;
    rdfs:label "title_text" ;
    rdfs:range xsd:string ;
    skos:definition "Optional title for a demonstrative example." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:url a owl:DatatypeProperty ;
    rdfs:label "url" ;
    rdfs:range xsd:anyURI ;
    skos:definition "URL pointing to the reference resource." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:url_date a owl:DatatypeProperty ;
    rdfs:label "url_date" ;
    rdfs:range xsd:date ;
    skos:definition "Date when the URL was last validated to exist." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:usage a owl:ObjectProperty ;
    rdfs:label "usage" ;
    rdfs:range cwe:MappingUsage ;
    skos:definition "Whether this CWE entry is supported for mapping." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:weakness a owl:ObjectProperty ;
    rdfs:label "weakness" ;
    rdfs:range cwe:Weakness ;
    skos:definition "Referenced CWE entry for this observation." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:CWEViewType a owl:Class ;
    rdfs:label "CWEViewType" ;
    owl:unionOf ( <https://w3id.org/lmodel/cwe/CWEViewType#GRAPH> <https://w3id.org/lmodel/cwe/CWEViewType#EXPLICIT> <https://w3id.org/lmodel/cwe/CWEViewType#IMPLICIT> ) ;
    skos:definition "Type of CWE view (ViewTypeEnumeration in XSD)." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> ;
    linkml:permissible_values <https://w3id.org/lmodel/cwe/CWEViewType#EXPLICIT>,
        <https://w3id.org/lmodel/cwe/CWEViewType#GRAPH>,
        <https://w3id.org/lmodel/cwe/CWEViewType#IMPLICIT> .

cwe:ContentHistory a owl:Class ;
    rdfs:label "ContentHistory" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:submission ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:submission ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:previous_entry_names ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:Modification ;
            owl:onProperty cwe:modifications ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:modifications ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:Contribution ;
            owl:onProperty cwe:contributions ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:Submission ;
            owl:onProperty cwe:submission ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:contributions ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:PreviousEntryName ;
            owl:onProperty cwe:previous_entry_names ] ;
    skos:definition "Tracks the original author and subsequent modifications (ContentHistoryType in XSD)." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:ContentImportance a owl:Class ;
    rdfs:label "ContentImportance" ;
    owl:unionOf ( <https://w3id.org/lmodel/cwe/ContentImportance#NORMAL> <https://w3id.org/lmodel/cwe/ContentImportance#CRITICAL> ) ;
    skos:definition "Importance level of a content modification (ImportanceEnumeration in XSD)." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> ;
    linkml:permissible_values <https://w3id.org/lmodel/cwe/ContentImportance#CRITICAL>,
        <https://w3id.org/lmodel/cwe/ContentImportance#NORMAL> .

cwe:MappingNotes a owl:Class ;
    rdfs:label "MappingNotes" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:comments ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:MappingUsage ;
            owl:onProperty cwe:usage ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:rationale ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cwe:rationale ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:reasons ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:suggestions ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:rationale ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:usage ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:usage ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cwe:comments ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:MappingSuggestion ;
            owl:onProperty cwe:suggestions ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:MappingReason ;
            owl:onProperty cwe:reasons ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:comments ] ;
    skos:definition "Guidance for when and whether to map an issue to a CWE entry (MappingNotesType in XSD). Required on every Weakness, Category, and View." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:Note a owl:Class ;
    rdfs:label "Note" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cwe:content ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:content ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:content ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:NoteType ;
            owl:onProperty cwe:type ] ;
    skos:definition "Additional commentary about a CWE entry (NotesType/Note in XSD)." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

