cwe:class_ a owl:DatatypeProperty ;
    rdfs:label "class_" ;
    rdfs:range xsd:string ;
    skos:definition "Class or category of a platform (narrowed per class via slot_usage)." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:prevalence a owl:ObjectProperty ;
    rdfs:label "prevalence" ;
    rdfs:range cwe:PlatformPrevalence ;
    skos:definition "Regularity with which a weakness applies to this platform." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:type a owl:DatatypeProperty ;
    rdfs:label "type" ;
    rdfs:range xsd:string ;
    skos:definition "Type discriminator (narrowed per class via slot_usage)." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

