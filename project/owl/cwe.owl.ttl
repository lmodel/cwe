@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix cwe: <https://w3id.org/lmodel/cwe/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix pav: <http://purl.org/pav/> .
@prefix schema1: <http://schema.org/> .
xsd:gDay a rdfs:Datatype ;
	owl:equivalentClass _:c14n659 .
xsd:gMonth a rdfs:Datatype ;
	owl:equivalentClass _:c14n506 .
xsd:gYear a rdfs:Datatype ;
	owl:equivalentClass _:c14n190 .
xsd:string a rdfs:Datatype ;
	owl:equivalentClass _:c14n1044 , _:c14n1047 .
<https://w3id.org/lmodel/cwe.owl.ttl> dcterms:license "Apache-2.0" ;
	dcterms:source <https://cwe.mitre.org/data/xsd/cwe_schema_v8.0.xsd> ;
	dcterms:title "Common Weakness Enumeration (CWE) List and Schema" ;
	pav:version "5.0" ;
	schema1:keywords "CWE" , "hardware weakness" , "root cause mapping" , "secure coding" , "software weakness" , "weakness" ;
	a owl:Ontology ;
	rdfs:label "cwe" ;
	rdfs:seeAlso <https://cwe.mitre.org/> , <https://lmodel.github.io/cwe> ;
	skos:definition "A LinkML model of the Common Weakness Enumeration, the catalogue of software and hardware weakness types that The MITRE Corporation publishes for the CWE Program. It renders the catalogue's XML Schema with its own element names and values, so the whole catalogue validates with both unchanged." ;
	skos:note "The file behind the cwe_schema_latest.xsd link is an earlier copy of 8.0, which the catalogue breaks in 69 places. The source above is the file the catalogue itself names, and it validates with no error." , "The version is the edition of the CWE List that the schema renders, which is the first edition under XML Schema 8.0. upstream/ holds both files unchanged, tests/test_coverage.py holds the schema to the XSD, and scripts/check_upstream_release.py reports when either moves." ;
	cwe:xsd_date "2026-10-28" ;
	cwe:xsd_namespace "http://cwe.mitre.org/cwe-8" ;
	cwe:xsd_version "8.0" .
cwe:Abstraction a owl:ObjectProperty ;
	rdfs:label "Abstraction" ;
	skos:definition "How far the weakness is described in general terms or tied to a specific product." ;
	skos:exactMatch <http://w3id.org/sepses/vocab/ref/cwe#abstraction> ;
	skos:inScheme cwe:cwe_entries .
cwe:Access_Restrictions a owl:ObjectProperty ;
	rdfs:label "Access_Restrictions" ;
	skos:definition "What stands between a reader and the source." ;
	skos:inScheme cwe:cwe_core .
cwe:Affected_Resources a owl:ObjectProperty ;
	rdfs:label "Affected_Resources" ;
	skos:definition "The system resources that exploiting the weakness can affect." ;
	skos:inScheme cwe:cwe_entries .
cwe:Alt_URL a owl:DatatypeProperty ;
	rdfs:label "Alt_URL" ;
	skos:definition "Another address of the source, usually one with fewer restrictions." ;
	skos:inScheme cwe:cwe_core .
cwe:Alt_URL_Date a owl:DatatypeProperty ;
	rdfs:label "Alt_URL_Date" ;
	skos:definition "The date on which the other address was last seen to work." ;
	skos:inScheme cwe:cwe_core .
cwe:Alternate_Terms a owl:ObjectProperty ;
	rdfs:label "Alternate_Terms" ;
	skos:definition "Other names people use for the weakness." ;
	skos:inScheme cwe:cwe_entries .
cwe:Applicable_Platforms a owl:ObjectProperty ;
	rdfs:label "Applicable_Platforms" ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/cwe#hasApplicablePlatform> ;
	skos:definition "The languages, systems, architectures and technologies where the weakness can appear." ;
	skos:inScheme cwe:cwe_entries .
cwe:Architecture a owl:ObjectProperty ;
	rdfs:label "Architecture" ;
	skos:definition "A hardware architecture, or a family of them." ;
	skos:inScheme cwe:cwe_entries .
cwe:Audience a owl:ObjectProperty ;
	rdfs:label "Audience" ;
	skos:definition "The people who may find the view useful, and why." ;
	skos:inScheme cwe:cwe_entries .
cwe:Author a owl:DatatypeProperty ;
	rdfs:label "Author" ;
	skos:closeMatch dcterms:creator ;
	skos:definition "A person or group who wrote the source." ;
	skos:exactMatch <http://w3id.org/sepses/vocab/ref/cwe#referenceAuthor> ;
	skos:inScheme cwe:cwe_core .
cwe:Background_Details a owl:DatatypeProperty ;
	rdfs:label "Background_Details" ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/cwe#backgroundDetail> ;
	skos:definition "Background that helps a reader but does not describe the weakness itself." ;
	skos:inScheme cwe:cwe_entries .
cwe:Body_Text a owl:DatatypeProperty ;
	rdfs:label "Body_Text" ;
	skos:definition "Prose that explains the code around it." ;
	skos:inScheme cwe:cwe_entries .
cwe:CAPEC_ID a owl:DatatypeProperty ;
	rdfs:label "CAPEC_ID" ;
	skos:definition "The number of the attack pattern in the CAPEC list." ;
	skos:inScheme cwe:cwe_entries .
cwe:CPE_ID a owl:DatatypeProperty ;
	rdfs:label "CPE_ID" ;
	skos:definition "The Common Platform Enumeration name of the operating system." ;
	skos:inScheme cwe:cwe_entries .
cwe:CWE_ID a owl:ObjectProperty .
cwe:Chain_ID a owl:ObjectProperty ;
	rdfs:label "Chain_ID" ;
	skos:definition "The named chain that the link belongs to." ;
	skos:inScheme cwe:cwe_entries .
cwe:Class a owl:ObjectProperty .
cwe:Comment a owl:DatatypeProperty ;
	rdfs:label "Comment" ;
	skos:definition "When the suggestion applies." ;
	skos:inScheme cwe:cwe_entries .
cwe:Comments a owl:DatatypeProperty ;
	rdfs:label "Comments" ;
	skos:definition "More advice for someone mapping to the entry." ;
	skos:inScheme cwe:cwe_entries .
cwe:Common_Consequences a owl:ObjectProperty ;
	rdfs:label "Common_Consequences" ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/cwe#hasCommonConsequence> ;
	skos:definition "What can follow when the weakness is exploited." ;
	skos:inScheme cwe:cwe_entries .
cwe:Consequence_ID a owl:DatatypeProperty ;
	rdfs:label "Consequence_ID" ;
	skos:definition "An identifier for this consequence." ;
	skos:inScheme cwe:cwe_entries .
cwe:Content_History a owl:ObjectProperty ;
	rdfs:label "Content_History" ;
	skos:definition "Who wrote the entry and how it has changed since." ;
	skos:inScheme cwe:cwe_entries .
cwe:Contribution a owl:ObjectProperty ;
	rdfs:label "Contribution" ;
	skos:definition "Feedback or content that someone gave to the entry." ;
	skos:inScheme cwe:cwe_core .
cwe:Contribution_Comment a owl:DatatypeProperty ;
	rdfs:label "Contribution_Comment" ;
	skos:definition "A remark on the contribution." ;
	skos:inScheme cwe:cwe_core .
cwe:Contribution_Date a owl:DatatypeProperty ;
	rdfs:label "Contribution_Date" ;
	skos:definition "The date of the contribution." ;
	skos:inScheme cwe:cwe_core .
cwe:Contribution_Name a owl:DatatypeProperty ;
	rdfs:label "Contribution_Name" ;
	skos:definition "A person or group who contributed." ;
	skos:inScheme cwe:cwe_core .
cwe:Contribution_Organization a owl:DatatypeProperty ;
	rdfs:label "Contribution_Organization" ;
	skos:definition "The organization the contributor belongs to." ;
	skos:inScheme cwe:cwe_core .
cwe:Contribution_ReleaseDate a owl:DatatypeProperty ;
	rdfs:label "Contribution_ReleaseDate" ;
	skos:definition "The release date of that version." ;
	skos:inScheme cwe:cwe_core .
cwe:Contribution_Version a owl:DatatypeProperty ;
	rdfs:label "Contribution_Version" ;
	skos:definition "The first CWE version that held the contribution." ;
	skos:inScheme cwe:cwe_core .
cwe:Custom_Phase a owl:ObjectProperty .
cwe:CweAbstraction\#Base a owl:Class ;
	rdfs:label "Base" ;
	rdfs:subClassOf cwe:CweAbstraction ;
	skos:definition "A weakness general enough to apply widely and detailed enough to find or prevent it." .
cwe:CweAbstraction\#Class a owl:Class ;
	rdfs:label "Class" ;
	rdfs:subClassOf cwe:CweAbstraction ;
	skos:definition "A very general weakness, usually independent of any language or technology." .
cwe:CweAbstraction\#Compound a owl:Class ;
	rdfs:label "Compound" ;
	rdfs:subClassOf cwe:CweAbstraction ;
	skos:definition "An entry that ties two or more weaknesses together, as a chain or a composite." .
cwe:CweAbstraction\#Pillar a owl:Class ;
	rdfs:label "Pillar" ;
	rdfs:subClassOf cwe:CweAbstraction ;
	skos:definition "The most general level, a theme that the weaknesses under it share." .
cwe:CweAbstraction\#Variant a owl:Class ;
	rdfs:label "Variant" ;
	rdfs:subClassOf cwe:CweAbstraction ;
	skos:definition "A weakness tied to a particular language, technology or kind of product." .
cwe:CweAbstraction a owl:Class ;
	rdfs:label "CweAbstraction" ;
	owl:unionOf _:c14n892 ;
	skos:definition "How far a weakness is described in general terms or tied to a specific product or resource." ;
	skos:inScheme cwe:cwe_core ;
	linkml:permissible_values cwe:CweAbstraction\#Base , cwe:CweAbstraction\#Class , cwe:CweAbstraction\#Compound , cwe:CweAbstraction\#Pillar , cwe:CweAbstraction\#Variant ;
	cwe:xsd_type "AbstractionEnumeration" .
cwe:CweAiPhase\#Component\%20Interaction a owl:Class ;
	rdfs:label "Component Interaction" ;
	rdfs:subClassOf cwe:CweAiPhase .
cwe:CweAiPhase\#Data\%20Collection a owl:Class ;
	rdfs:label "Data Collection" ;
	rdfs:subClassOf cwe:CweAiPhase .
