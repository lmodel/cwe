	skos:closeMatch schema1:DefinedTermSet , skos:ConceptScheme ;
	skos:definition "One release of the CWE List, with all its entries and the sources they cite." ;
	skos:inScheme <https://w3id.org/lmodel/cwe> ;
	skos:note "Wikidata's item is the catalogue in general and this class is one release of it, so the item is related." ;
