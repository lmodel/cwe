cwe:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:range xsd:string ;
    skos:altLabel "label" ;
    skos:definition "Short human-readable name or title for this entity." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

