	skos:definition "The sources that the entries cite." ;
	skos:inScheme <https://w3id.org/lmodel/cwe> .
cwe:Filter a owl:DatatypeProperty ;
	rdfs:label "Filter" ;
	skos:definition "The XPath expression that selects the entries of an implicit slice." ;
	skos:inScheme cwe:cwe_entries .
cwe:Functional_Areas a owl:ObjectProperty ;
	rdfs:label "Functional_Areas" ;
	skos:definition "The parts of a product where the weakness tends to appear." ;
	skos:inScheme cwe:cwe_entries .
cwe:Groupings a owl:ObjectProperty ;
	rdfs:label "Groupings" ;
	skos:definition "The grouping entries." ;
	skos:inScheme <https://w3id.org/lmodel/cwe> .
cwe:Has_Member a owl:ObjectProperty ;
	rdfs:label "Has_Member" ;
	skos:definition "An entry that this one holds." ;
	skos:inScheme cwe:cwe_entries .
cwe:ID a owl:DatatypeProperty ;
	rdfs:label "ID" ;
	skos:closeMatch schema1:termCode , <http://www.wikidata.org/prop/direct/P3624> ;
	skos:definition "The number that identifies the entry across the whole list." ;
	skos:inScheme cwe:cwe_entries ;
	skos:note "Wikidata's P3624 holds this number for a weakness, without the CWE- prefix. lmodel/cve's cweId and lmodel/kev-catalog's cwes write the same number with the prefix, as CWE-79, so they are related." ;
	skos:relatedMatch <https://w3id.org/lmodel/cve/cweId> , <https://w3id.org/lmodel/kev-catalog/cwes> .
cwe:Impact a owl:ObjectProperty ;
	rdfs:label "Impact" ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/cwe#consequenceImpact> ;
