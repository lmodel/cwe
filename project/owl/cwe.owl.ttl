cwe:RelatedWeakness a owl:Class ;
    rdfs:label "RelatedWeakness" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty cwe:chain_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:WeaknessRelationNature ;
            owl:onProperty cwe:nature ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:ordinal ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:view_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:chain_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty cwe:view_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:chain_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:nature ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:OrdinalQualifier ;
            owl:onProperty cwe:ordinal ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:nature ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty cwe:cwe_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:cwe_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:ordinal ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:view_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:cwe_id ] ;
    skos:definition "Typed directional relationship from one CWE entry to another (RelatedWeaknessesType/Related_Weakness in XSD)." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:Relationship a owl:Class ;
    rdfs:label "Relationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:has_member ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:member_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:CatalogMember ;
            owl:onProperty cwe:has_member ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:CatalogMember ;
            owl:onProperty cwe:member_of ] ;
    skos:definition "Container for category membership relationships (RelationshipsType in XSD). Holds Has_Member and optionally Member_Of lists." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

