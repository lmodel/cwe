	rdfs:subClassOf cwe:CweAiPhase .
cwe:CweAiPhase\#Training a owl:Class ;
	rdfs:label "Training" ;
	rdfs:subClassOf cwe:CweAiPhase .
cwe:CweAiPhase a owl:Class ;
	rdfs:label "CweAiPhase" ;
	owl:unionOf _:c14n491 ;
	skos:definition "A stage of the life cycle of an artificial intelligence system." ;
	skos:inScheme cwe:cwe_core ;
	linkml:permissible_values cwe:CweAiPhase\#Component\%20Interaction , cwe:CweAiPhase\#Data\%20Collection , cwe:CweAiPhase\#Fine-tuning , cwe:CweAiPhase\#Output\%20Processing , cwe:CweAiPhase\#Prompting , cwe:CweAiPhase\#Re-training\%20\%2F\%20Feedback , cwe:CweAiPhase\#Testing , cwe:CweAiPhase\#Tokenization , cwe:CweAiPhase\#Training ;
	cwe:xsd_type "AIPhaseEnumeration" .
