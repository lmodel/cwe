	skos:closeMatch schema1:DefinedTerm , <http://w3id.org/sepses/vocab/ref/cwe#CWE> , skos:Concept ;
	skos:definition "A type of mistake or condition in software, firmware, hardware or a service that can leave a product open to attack." ;
	skos:inScheme cwe:cwe_entries ;
