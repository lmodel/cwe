@prefix WIKIDATA: <https://www.wikidata.org/wiki/> .
@prefix cwe: <https://w3id.org/lmodel/cwe/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/lmodel/cwe.owl.ttl> a owl:Ontology ;
    rdfs:label "cwe" ;
    dct:license "Apache-2.0" ;
    dct:source <https://cwe.mitre.org/data/downloads.html> ;
    dct:title "cwe" ;
    pav:version "7.3" ;
    rdfs:seeAlso <https://cwe.mitre.org/data/index.html>,
        <https://lmodel.github.io/cwe>,
        <https://nvd.nist.gov/> ;
    skos:definition """MITRE Common Weakness Enumeration (CWE) LinkML Schema.

Self-contained schema covering the full MITRE CWE XSD: weakness entries,
categories, views, external references, and NVD weakness observations (CWE-ID,
CWE Name, Source).""" ;
    cwe:source_columns "CWE-ID,CWE Name,Source" ;
    cwe:xsd_namespace "http://cwe.mitre.org/cwe-7" ;
    cwe:xsd_schema_version "7.3" .

cwe:WeaknessCatalog a owl:Class ;
    rdfs:label "WeaknessCatalog" ;
    rdfs:seeAlso <https://cwe.mitre.org/data/downloads.html> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:weaknesses ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:external_references ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:categories ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cwe:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty cwe:date ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:version ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:View ;
            owl:onProperty cwe:views ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:NVDWeaknessObservation ;
            owl:onProperty cwe:observations ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:observations ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:Category ;
            owl:onProperty cwe:categories ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:ExternalReference ;
            owl:onProperty cwe:external_references ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:Weakness ;
            owl:onProperty cwe:weaknesses ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:views ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cwe:version ] ;
    skos:definition "Top-level container for a CWE catalog snapshot (Weakness_Catalog in XSD). Holds weakness entries, categories, views, external references, and NVD weakness observations." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

<https://w3id.org/lmodel/cwe/OrdinalQualifier#PRIMARY> a owl:Class ;
    rdfs:label "PRIMARY" ;
    rdfs:subClassOf cwe:OrdinalQualifier ;
    skos:definition "Primary ChildOf relationship for this weakness in the given view." .

<https://w3id.org/lmodel/cwe/AffectedResource#CPU> a owl:Class ;
    rdfs:label "CPU" ;
    rdfs:subClassOf cwe:AffectedResource .

<https://w3id.org/lmodel/cwe/AffectedResource#FILE_OR_DIRECTORY> a owl:Class ;
    rdfs:label "FILE_OR_DIRECTORY" ;
    rdfs:subClassOf cwe:AffectedResource .

<https://w3id.org/lmodel/cwe/AffectedResource#MEMORY> a owl:Class ;
    rdfs:label "MEMORY" ;
    rdfs:subClassOf cwe:AffectedResource .

<https://w3id.org/lmodel/cwe/AffectedResource#OTHER> a owl:Class ;
    rdfs:label "OTHER" ;
    rdfs:subClassOf cwe:AffectedResource .

<https://w3id.org/lmodel/cwe/AffectedResource#SYSTEM_PROCESS> a owl:Class ;
    rdfs:label "SYSTEM_PROCESS" ;
    rdfs:subClassOf cwe:AffectedResource .

cwe:AlternateTerm a owl:Class ;
    rdfs:label "AlternateTerm" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:term ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cwe:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cwe:term ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:term ] ;
    skos:definition "Another name by which this weakness may be known (AlternateTermsType/Alternate_Term in XSD)." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:ApplicablePlatforms a owl:Class ;
    rdfs:label "ApplicablePlatforms" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cwe:TechnologyPlatform ;
            owl:onProperty cwe:technologies ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:architectures ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:technologies ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:ArchitecturePlatform ;
            owl:onProperty cwe:architectures ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:LanguagePlatform ;
            owl:onProperty cwe:languages ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:operating_systems ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:languages ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:OSPlatform ;
            owl:onProperty cwe:operating_systems ] ;
    skos:definition "Languages, operating systems, architectures, and technologies where a weakness could appear (ApplicablePlatformsType in XSD)." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

<https://w3id.org/lmodel/cwe/ArchitectureClass#EMBEDDED> a owl:Class ;
    rdfs:label "EMBEDDED" ;
    rdfs:subClassOf cwe:ArchitectureClass .

<https://w3id.org/lmodel/cwe/ArchitectureClass#MICROCOMPUTER> a owl:Class ;
    rdfs:label "MICROCOMPUTER" ;
    rdfs:subClassOf cwe:ArchitectureClass .

<https://w3id.org/lmodel/cwe/ArchitectureClass#NOT_ARCHITECTURE_SPECIFIC> a owl:Class ;
    rdfs:label "NOT_ARCHITECTURE_SPECIFIC" ;
    rdfs:subClassOf cwe:ArchitectureClass .

<https://w3id.org/lmodel/cwe/ArchitectureClass#WORKSTATION> a owl:Class ;
    rdfs:label "WORKSTATION" ;
    rdfs:subClassOf cwe:ArchitectureClass .

<https://w3id.org/lmodel/cwe/ArchitectureName#ALPHA> a owl:Class ;
    rdfs:label "ALPHA" ;
    rdfs:subClassOf cwe:ArchitectureName .

<https://w3id.org/lmodel/cwe/ArchitectureName#ARM> a owl:Class ;
    rdfs:label "ARM" ;
    rdfs:subClassOf cwe:ArchitectureName .

<https://w3id.org/lmodel/cwe/ArchitectureName#ITANIUM> a owl:Class ;
    rdfs:label "ITANIUM" ;
    rdfs:subClassOf cwe:ArchitectureName .

<https://w3id.org/lmodel/cwe/ArchitectureName#OTHER> a owl:Class ;
    rdfs:label "OTHER" ;
    rdfs:subClassOf cwe:ArchitectureName .

<https://w3id.org/lmodel/cwe/ArchitectureName#POWER_ARCHITECTURE> a owl:Class ;
    rdfs:label "POWER_ARCHITECTURE" ;
    rdfs:subClassOf cwe:ArchitectureName .

<https://w3id.org/lmodel/cwe/ArchitectureName#SPARC> a owl:Class ;
    rdfs:label "SPARC" ;
    rdfs:subClassOf cwe:ArchitectureName .

<https://w3id.org/lmodel/cwe/ArchitectureName#X86> a owl:Class ;
    rdfs:label "X86" ;
    rdfs:subClassOf cwe:ArchitectureName .

cwe:ArchitecturePlatform a owl:Class ;
    rdfs:label "ArchitecturePlatform" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:class_ ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:PlatformPrevalence ;
            owl:onProperty cwe:prevalence ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:class_ ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:ArchitectureClass ;
            owl:onProperty cwe:class_ ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:prevalence ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:prevalence ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:ArchitectureName ;
            owl:onProperty cwe:name ] ;
    skos:definition "A processor architecture or class applicable to a weakness (Architecture element in ApplicablePlatformsType)." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:Audience a owl:Class ;
    rdfs:label "Audience" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:StakeholderType ;
            owl:onProperty cwe:type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cwe:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:description ] ;
    skos:definition "A target stakeholder group for a CWE view or category (AudienceType/Stakeholder in XSD)." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

<https://w3id.org/lmodel/cwe/CWEViewType#EXPLICIT> a owl:Class ;
    rdfs:label "EXPLICIT" ;
    rdfs:subClassOf cwe:CWEViewType ;
    skos:definition "Flat list related through an external factor (e.g. Top-N list)." .

<https://w3id.org/lmodel/cwe/CWEViewType#GRAPH> a owl:Class ;
    rdfs:label "GRAPH" ;
    rdfs:subClassOf cwe:CWEViewType ;
    skos:definition "Hierarchical representation from a specific vantage point." .

<https://w3id.org/lmodel/cwe/CWEViewType#IMPLICIT> a owl:Class ;
    rdfs:label "IMPLICIT" ;
    rdfs:subClassOf cwe:CWEViewType ;
    skos:definition "Subset identified by an XSL filter expression." .

cwe:Category a owl:Class ;
    rdfs:label "Category" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:mapping_notes ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:mapping_notes ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:WeaknessStatus ;
            owl:onProperty cwe:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:TaxonomyMapping ;
            owl:onProperty cwe:taxonomy_mappings ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:Note ;
            owl:onProperty cwe:notes ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:MappingNotes ;
            owl:onProperty cwe:mapping_notes ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:references ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty cwe:id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:content_history ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:notes ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cwe:summary ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:summary ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:ContentHistory ;
            owl:onProperty cwe:content_history ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:taxonomy_mappings ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:Relationship ;
            owl:onProperty cwe:relationships ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:summary ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:content_history ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:relationships ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:CWEReference ;
            owl:onProperty cwe:references ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cwe:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:relationships ] ;
    skos:definition "A collection of weaknesses grouped by a shared characteristic (CategoryType in XSD). Organizational mechanism only; not for mapping." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

<https://w3id.org/lmodel/cwe/CodeNature#ATTACK> a owl:Class ;
    rdfs:label "ATTACK" ;
    rdfs:subClassOf cwe:CodeNature .

<https://w3id.org/lmodel/cwe/CodeNature#BAD> a owl:Class ;
    rdfs:label "BAD" ;
    rdfs:subClassOf cwe:CodeNature .

<https://w3id.org/lmodel/cwe/CodeNature#GOOD> a owl:Class ;
    rdfs:label "GOOD" ;
    rdfs:subClassOf cwe:CodeNature .

<https://w3id.org/lmodel/cwe/CodeNature#INFORMATIVE> a owl:Class ;
    rdfs:label "INFORMATIVE" ;
    rdfs:subClassOf cwe:CodeNature .

<https://w3id.org/lmodel/cwe/CodeNature#MITIGATION> a owl:Class ;
    rdfs:label "MITIGATION" ;
    rdfs:subClassOf cwe:CodeNature .

<https://w3id.org/lmodel/cwe/CodeNature#RESULT> a owl:Class ;
    rdfs:label "RESULT" ;
    rdfs:subClassOf cwe:CodeNature .

cwe:CommonConsequence a owl:Class ;
    rdfs:label "CommonConsequence" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cwe:LikelihoodLevel ;
            owl:onProperty cwe:likelihood ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cwe:consequence_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:TechnicalImpact ;
            owl:onProperty cwe:impacts ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cwe:note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:likelihood ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:scopes ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:likelihood ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:consequence_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:note ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:SecurityScope ;
            owl:onProperty cwe:scopes ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:impacts ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:consequence_id ] ;
    skos:definition "Individual consequence associated with a weakness (CommonConsequencesType/Consequence in XSD)." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

<https://w3id.org/lmodel/cwe/ContentImportance#CRITICAL> a owl:Class ;
    rdfs:label "CRITICAL" ;
    rdfs:subClassOf cwe:ContentImportance ;
    skos:definition "Changes the meaning or interpretation of the entry." .

<https://w3id.org/lmodel/cwe/ContentImportance#NORMAL> a owl:Class ;
    rdfs:label "NORMAL" ;
    rdfs:subClassOf cwe:ContentImportance .

cwe:Contribution a owl:Class ;
    rdfs:label "Contribution" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:contribution_comment ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:contribution_version ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cwe:contribution_version ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cwe:contribution_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:contribution_organization ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:contribution_release_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty cwe:contribution_release_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:contribution_comment ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cwe:contribution_comment ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:contribution_organization ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:contribution_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:contribution_release_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:contribution_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:contribution_version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:contribution_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty cwe:contribution_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cwe:contribution_organization ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:ContributionType ;
            owl:onProperty cwe:type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:contribution_date ] ;
    skos:definition "A contribution record documenting donated content or feedback (ContentHistoryType/Contribution in XSD)." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

<https://w3id.org/lmodel/cwe/ContributionType#CONTENT> a owl:Class ;
    rdfs:label "CONTENT" ;
    rdfs:subClassOf cwe:ContributionType ;
    skos:definition "Content donated to the CWE entry." .

<https://w3id.org/lmodel/cwe/ContributionType#FEEDBACK> a owl:Class ;
    rdfs:label "FEEDBACK" ;
    rdfs:subClassOf cwe:ContributionType ;
    skos:definition "General feedback given about the CWE entry." .

cwe:DemonstrativeExample a owl:Class ;
    rdfs:label "DemonstrativeExample" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:example_codes ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:title_text ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:intro_text ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:CWEReference ;
            owl:onProperty cwe:references ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:title_text ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cwe:title_text ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:body_texts ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cwe:demonstrative_example_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:demonstrative_example_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:references ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cwe:intro_text ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:ExampleCode ;
            owl:onProperty cwe:example_codes ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:intro_text ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:demonstrative_example_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cwe:body_texts ] ;
    skos:definition "A code example illustrating how a weakness may appear (DemonstrativeExamplesType/Demonstrative_Example in XSD)." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

<https://w3id.org/lmodel/cwe/DetectionEffectiveness#HIGH> a owl:Class ;
    rdfs:label "HIGH" ;
    rdfs:subClassOf cwe:DetectionEffectiveness ;
    skos:definition "Succeeds frequently; few false reports." .

<https://w3id.org/lmodel/cwe/DetectionEffectiveness#LIMITED> a owl:Class ;
    rdfs:label "LIMITED" ;
    rdfs:subClassOf cwe:DetectionEffectiveness ;
    skos:definition "Useful in limited circumstances." .

<https://w3id.org/lmodel/cwe/DetectionEffectiveness#MODERATE> a owl:Class ;
    rdfs:label "MODERATE" ;
    rdfs:subClassOf cwe:DetectionEffectiveness ;
    skos:definition "Applicable broadly but may lack complete coverage." .

<https://w3id.org/lmodel/cwe/DetectionEffectiveness#NONE> a owl:Class ;
    rdfs:label "NONE" ;
