    rdfs:label "FunctionalArea" ;
    owl:unionOf ( <https://w3id.org/lmodel/cwe/FunctionalArea#AUTHENTICATION> <https://w3id.org/lmodel/cwe/FunctionalArea#AUTHORIZATION> <https://w3id.org/lmodel/cwe/FunctionalArea#CODE_LIBRARIES> <https://w3id.org/lmodel/cwe/FunctionalArea#COUNTERS> <https://w3id.org/lmodel/cwe/FunctionalArea#CRYPTOGRAPHY> <https://w3id.org/lmodel/cwe/FunctionalArea#ERROR_HANDLING> <https://w3id.org/lmodel/cwe/FunctionalArea#INTERPROCESS_COMMUNICATION> <https://w3id.org/lmodel/cwe/FunctionalArea#FILE_PROCESSING> <https://w3id.org/lmodel/cwe/FunctionalArea#LOGGING> <https://w3id.org/lmodel/cwe/FunctionalArea#MEMORY_MANAGEMENT> <https://w3id.org/lmodel/cwe/FunctionalArea#NETWORKING> <https://w3id.org/lmodel/cwe/FunctionalArea#NUMBER_PROCESSING> <https://w3id.org/lmodel/cwe/FunctionalArea#PROGRAM_INVOCATION> <https://w3id.org/lmodel/cwe/FunctionalArea#PROTECTION_MECHANISM> <https://w3id.org/lmodel/cwe/FunctionalArea#SESSION_MANAGEMENT> <https://w3id.org/lmodel/cwe/FunctionalArea#SIGNALS> <https://w3id.org/lmodel/cwe/FunctionalArea#STRING_PROCESSING> <https://w3id.org/lmodel/cwe/FunctionalArea#NOT_FUNCTIONAL_AREA_SPECIFIC> <https://w3id.org/lmodel/cwe/FunctionalArea#POWER> <https://w3id.org/lmodel/cwe/FunctionalArea#CLOCK> ) ;
    skos:definition "Functional area where a weakness is most likely to occur (FunctionalAreaEnumeration in XSD)." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> ;
    linkml:permissible_values <https://w3id.org/lmodel/cwe/FunctionalArea#AUTHENTICATION>,
        <https://w3id.org/lmodel/cwe/FunctionalArea#AUTHORIZATION>,
        <https://w3id.org/lmodel/cwe/FunctionalArea#CLOCK>,
        <https://w3id.org/lmodel/cwe/FunctionalArea#CODE_LIBRARIES>,
        <https://w3id.org/lmodel/cwe/FunctionalArea#COUNTERS>,
        <https://w3id.org/lmodel/cwe/FunctionalArea#CRYPTOGRAPHY>,
        <https://w3id.org/lmodel/cwe/FunctionalArea#ERROR_HANDLING>,
        <https://w3id.org/lmodel/cwe/FunctionalArea#FILE_PROCESSING>,
        <https://w3id.org/lmodel/cwe/FunctionalArea#INTERPROCESS_COMMUNICATION>,
        <https://w3id.org/lmodel/cwe/FunctionalArea#LOGGING>,
        <https://w3id.org/lmodel/cwe/FunctionalArea#MEMORY_MANAGEMENT>,
        <https://w3id.org/lmodel/cwe/FunctionalArea#NETWORKING>,
        <https://w3id.org/lmodel/cwe/FunctionalArea#NOT_FUNCTIONAL_AREA_SPECIFIC>,
        <https://w3id.org/lmodel/cwe/FunctionalArea#NUMBER_PROCESSING>,
        <https://w3id.org/lmodel/cwe/FunctionalArea#POWER>,
        <https://w3id.org/lmodel/cwe/FunctionalArea#PROGRAM_INVOCATION>,
        <https://w3id.org/lmodel/cwe/FunctionalArea#PROTECTION_MECHANISM>,
        <https://w3id.org/lmodel/cwe/FunctionalArea#SESSION_MANAGEMENT>,
        <https://w3id.org/lmodel/cwe/FunctionalArea#SIGNALS>,
        <https://w3id.org/lmodel/cwe/FunctionalArea#STRING_PROCESSING> .

cwe:TechnicalImpact a owl:Class ;
