	skos:definition "The edition of the source." ;
	skos:exactMatch <http://w3id.org/sepses/vocab/ref/cwe#referenceEdition> ;
	skos:inScheme cwe:cwe_core .
cwe:Effectiveness a owl:ObjectProperty .
cwe:Effectiveness_Notes a owl:DatatypeProperty .
cwe:Entries a owl:ObjectProperty ;
	rdfs:label "Entries" ;
	skos:definition "The example's prose and code, in the order they are meant to be read." ;
	skos:inScheme cwe:cwe_entries ;
