cwe:TechnologyPlatform a owl:Class ;
    rdfs:label "TechnologyPlatform" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:prevalence ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:class_ ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:PlatformPrevalence ;
            owl:onProperty cwe:prevalence ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:TechnologyName ;
            owl:onProperty cwe:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:prevalence ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:class_ ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:TechnologyClass ;
            owl:onProperty cwe:class_ ] ;
    skos:definition "A technology or technology class applicable to a weakness (Technology element in ApplicablePlatformsType)." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:View a owl:Class ;
    rdfs:label "View" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cwe:Note ;
            owl:onProperty cwe:notes ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cwe:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:references ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:filter ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:Audience ;
            owl:onProperty cwe:audience ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cwe:filter ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:CWEReference ;
            owl:onProperty cwe:references ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:mapping_notes ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:WeaknessStatus ;
            owl:onProperty cwe:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:CWEViewType ;
            owl:onProperty cwe:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:objective ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:objective ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:CatalogMember ;
            owl:onProperty cwe:members ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty cwe:id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:filter ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cwe:objective ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:content_history ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:notes ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:MappingNotes ;
            owl:onProperty cwe:mapping_notes ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:members ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:ContentHistory ;
            owl:onProperty cwe:content_history ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:content_history ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:mapping_notes ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:audience ] ;
    skos:definition "A perspective from which to look at weaknesses in the catalog (ViewType in XSD). Types: Graph, Explicit slice, Implicit slice." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

<https://w3id.org/lmodel/cwe/WeaknessAbstraction#BASE> a owl:Class ;
    rdfs:label "BASE" ;
    rdfs:subClassOf cwe:WeaknessAbstraction ;
    skos:definition "Mostly independent of resource or technology; supports detection/prevention." .

<https://w3id.org/lmodel/cwe/WeaknessAbstraction#CLASS> a owl:Class ;
    rdfs:label "CLASS" ;
    rdfs:subClassOf cwe:WeaknessAbstraction ;
    skos:definition "Abstract, independent of any specific language or technology." .

<https://w3id.org/lmodel/cwe/WeaknessAbstraction#COMPOUND> a owl:Class ;
    rdfs:label "COMPOUND" ;
    rdfs:subClassOf cwe:WeaknessAbstraction ;
    skos:definition "Meaningful aggregation — Chain or Composite." .

<https://w3id.org/lmodel/cwe/WeaknessAbstraction#PILLAR> a owl:Class ;
    rdfs:label "PILLAR" ;
    rdfs:subClassOf cwe:WeaknessAbstraction ;
    skos:definition "Most abstract type; a theme for all class/base/variant weaknesses." .

<https://w3id.org/lmodel/cwe/WeaknessAbstraction#VARIANT> a owl:Class ;
    rdfs:label "VARIANT" ;
    rdfs:subClassOf cwe:WeaknessAbstraction ;
    skos:definition "Linked to a specific language or technology." .

cwe:WeaknessOrdinality a owl:Class ;
    rdfs:label "WeaknessOrdinality" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cwe:ordinality ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cwe:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cwe:description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cwe:ordinality ],
        [ a owl:Restriction ;
            owl:allValuesFrom cwe:WeaknessOrdinalityLevel ;
            owl:onProperty cwe:ordinality ] ;
    skos:definition "Potential ordering relationship with other weaknesses (WeaknessOrdinalitiesType/Weakness_Ordinality in XSD)." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

<https://w3id.org/lmodel/cwe/WeaknessOrdinalityLevel#INDIRECT> a owl:Class ;
    rdfs:label "INDIRECT" ;
    rdfs:subClassOf cwe:WeaknessOrdinalityLevel ;
    skos:definition "Does not directly lead to security weaknesses but may facilitate them." .

<https://w3id.org/lmodel/cwe/WeaknessOrdinalityLevel#PRIMARY> a owl:Class ;
    rdfs:label "PRIMARY" ;
    rdfs:subClassOf cwe:WeaknessOrdinalityLevel ;
    skos:definition "Weakness exists independent of other weaknesses." .

<https://w3id.org/lmodel/cwe/WeaknessOrdinalityLevel#RESULTANT> a owl:Class ;
    rdfs:label "RESULTANT" ;
    rdfs:subClassOf cwe:WeaknessOrdinalityLevel ;
    skos:definition "Weakness exists only in the presence of other weaknesses." .

<https://w3id.org/lmodel/cwe/WeaknessRelationNature#CAN_ALSO_BE> a owl:Class ;
    rdfs:label "CAN_ALSO_BE" ;
    rdfs:subClassOf cwe:WeaknessRelationNature ;
    skos:definition "In proper context can also be perceived as the target weakness." .

<https://w3id.org/lmodel/cwe/WeaknessRelationNature#CAN_FOLLOW> a owl:Class ;
    rdfs:label "CAN_FOLLOW" ;
    rdfs:subClassOf cwe:WeaknessRelationNature ;
    skos:definition "Chaining; this weakness can follow the target." .

<https://w3id.org/lmodel/cwe/WeaknessRelationNature#CAN_PRECEDE> a owl:Class ;
    rdfs:label "CAN_PRECEDE" ;
    rdfs:subClassOf cwe:WeaknessRelationNature ;
    skos:definition "Chaining; this weakness can precede the target." .

<https://w3id.org/lmodel/cwe/WeaknessRelationNature#CHILD_OF> a owl:Class ;
    rdfs:label "CHILD_OF" ;
    rdfs:subClassOf cwe:WeaknessRelationNature ;
    skos:definition "Related weakness at a higher level of abstraction." .

<https://w3id.org/lmodel/cwe/WeaknessRelationNature#PARENT_OF> a owl:Class ;
    rdfs:label "PARENT_OF" ;
    rdfs:subClassOf cwe:WeaknessRelationNature ;
    skos:definition "Related weakness at a lower level of abstraction." .

<https://w3id.org/lmodel/cwe/WeaknessRelationNature#PEER_OF> a owl:Class ;
    rdfs:label "PEER_OF" ;
    rdfs:subClassOf cwe:WeaknessRelationNature ;
    skos:definition "Shows similarity with the target; no precise fit elsewhere." .

<https://w3id.org/lmodel/cwe/WeaknessRelationNature#REQUIRED_BY> a owl:Class ;
    rdfs:label "REQUIRED_BY" ;
    rdfs:subClassOf cwe:WeaknessRelationNature ;
    skos:definition "Composite; this weakness is required by the target." .

<https://w3id.org/lmodel/cwe/WeaknessRelationNature#REQUIRES> a owl:Class ;
    rdfs:label "REQUIRES" ;
    rdfs:subClassOf cwe:WeaknessRelationNature ;
    skos:definition "Composite; this weakness requires the target." .

<https://w3id.org/lmodel/cwe/WeaknessRelationNature#STARTS_WITH> a owl:Class ;
    rdfs:label "STARTS_WITH" ;
    rdfs:subClassOf cwe:WeaknessRelationNature ;
    skos:definition "Chaining; this weakness starts the chain." .

<https://w3id.org/lmodel/cwe/WeaknessSource#ASSIGNER> a owl:Class ;
    rdfs:label "ASSIGNER" ;
    rdfs:subClassOf cwe:WeaknessSource ;
    skos:definition "Data provided by the CVE assigner/CNA." .

<https://w3id.org/lmodel/cwe/WeaknessSource#CNA> a owl:Class ;
    rdfs:label "CNA" ;
    rdfs:subClassOf cwe:WeaknessSource ;
    skos:definition "Data provided by a CVE Numbering Authority." .

<https://w3id.org/lmodel/cwe/WeaknessSource#MITRE> a owl:Class ;
    rdfs:label "MITRE" ;
    rdfs:subClassOf cwe:WeaknessSource ;
    skos:definition "Data sourced from MITRE CWE content." .

<https://w3id.org/lmodel/cwe/WeaknessSource#NIST> a owl:Class ;
    rdfs:label "NIST" ;
    rdfs:subClassOf cwe:WeaknessSource ;
    skos:definition "Data produced by NIST/NVD analysis." .

<https://w3id.org/lmodel/cwe/WeaknessSource#OTHER> a owl:Class ;
    rdfs:label "OTHER" ;
    rdfs:subClassOf cwe:WeaknessSource ;
    skos:definition "Other or unspecified source." .

<https://w3id.org/lmodel/cwe/WeaknessStatus#DEPRECATED> a owl:Class ;
    rdfs:label "DEPRECATED" ;
    rdfs:subClassOf cwe:WeaknessStatus ;
    skos:definition "Removed from CWE; likely a duplicate or created in error." .

<https://w3id.org/lmodel/cwe/WeaknessStatus#DRAFT> a owl:Class ;
    rdfs:label "DRAFT" ;
    rdfs:subClassOf cwe:WeaknessStatus ;
    skos:definition "All important elements filled; may still have problems or gaps." .

<https://w3id.org/lmodel/cwe/WeaknessStatus#INCOMPLETE> a owl:Class ;
    rdfs:label "INCOMPLETE" ;
    rdfs:subClassOf cwe:WeaknessStatus ;
    skos:definition "Not all important elements filled; quality not guaranteed." .

<https://w3id.org/lmodel/cwe/WeaknessStatus#OBSOLETE> a owl:Class ;
    rdfs:label "OBSOLETE" ;
    rdfs:subClassOf cwe:WeaknessStatus ;
    skos:definition "Still valid but no longer relevant; likely superseded." .

<https://w3id.org/lmodel/cwe/WeaknessStatus#STABLE> a owl:Class ;
    rdfs:label "STABLE" ;
    rdfs:subClassOf cwe:WeaknessStatus ;
    skos:definition "All important elements verified; unlikely to change significantly." .

<https://w3id.org/lmodel/cwe/WeaknessStatus#USABLE> a owl:Class ;
    rdfs:label "USABLE" ;
    rdfs:subClassOf cwe:WeaknessStatus ;
    skos:definition "Has received close extensive review; critical elements verified." .

<https://w3id.org/lmodel/cwe/WeaknessStructure#CHAIN> a owl:Class ;
    rdfs:label "CHAIN" ;
    rdfs:subClassOf cwe:WeaknessStructure ;
    skos:definition "Set of weaknesses reachable consecutively to produce a vulnerability." .

<https://w3id.org/lmodel/cwe/WeaknessStructure#COMPOSITE> a owl:Class ;
    rdfs:label "COMPOSITE" ;
    rdfs:subClassOf cwe:WeaknessStructure ;
    skos:definition "Set of weaknesses that must all be present simultaneously." .

<https://w3id.org/lmodel/cwe/WeaknessStructure#SIMPLE> a owl:Class ;
    rdfs:label "SIMPLE" ;
    rdfs:subClassOf cwe:WeaknessStructure ;
    skos:definition "Single weakness whose exploitation is not dependent on another weakness." .

cwe:affected_resources a owl:ObjectProperty ;
    rdfs:label "affected_resources" ;
    rdfs:range cwe:AffectedResource ;
    skos:definition "System resources that can be affected by exploiting this weakness." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:alternate_terms a owl:ObjectProperty ;
    rdfs:label "alternate_terms" ;
    rdfs:range cwe:AlternateTerm ;
    skos:definition "Other names by which this weakness is known." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:architectures a owl:ObjectProperty ;
    rdfs:label "architectures" ;
    rdfs:range cwe:ArchitecturePlatform ;
    skos:definition "Processor architectures applicable to this weakness." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:audience a owl:ObjectProperty ;
    rdfs:label "audience" ;
    rdfs:range cwe:Audience ;
    skos:definition "Target stakeholder groups for this view or category." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:authors a owl:DatatypeProperty ;
    rdfs:label "authors" ;
    rdfs:range xsd:string ;
    skos:definition "Authors of the referenced material." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:background_details a owl:DatatypeProperty ;
    rdfs:label "background_details" ;
    rdfs:range xsd:string ;
    skos:definition "Background information relevant but not describing the weakness itself." ;
    skos:inScheme <https://w3id.org/lmodel/cwe> .

cwe:body_texts a owl:DatatypeProperty ;
    rdfs:label "body_texts" ;
    rdfs:range xsd:string ;
