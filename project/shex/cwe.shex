             <https://w3id.org/lmodel/cwe/CweTechnologyName#Analog%20and%20Mixed%20Signal%20Hardware>
             <https://w3id.org/lmodel/cwe/CweTechnologyName#Audio/Video%20Hardware>
             <https://w3id.org/lmodel/cwe/CweTechnologyName#Bus/Interface%20Hardware>
             <https://w3id.org/lmodel/cwe/CweTechnologyName#Clock/Counter%20Hardware>
             <https://w3id.org/lmodel/cwe/CweTechnologyName#Communication%20Hardware>
             <https://w3id.org/lmodel/cwe/CweTechnologyName#Controller%20Hardware>
             <https://w3id.org/lmodel/cwe/CweTechnologyName#Memory%20Hardware>
             <https://w3id.org/lmodel/cwe/CweTechnologyName#Microcontroller%20Hardware>
             <https://w3id.org/lmodel/cwe/CweTechnologyName#Network%20on%20Chip%20Hardware>
             <https://w3id.org/lmodel/cwe/CweTechnologyName#Power%20Management%20Hardware>
             <https://w3id.org/lmodel/cwe/CweTechnologyName#Processor%20Hardware>
             <https://w3id.org/lmodel/cwe/CweTechnologyName#Security%20Hardware>
             <https://w3id.org/lmodel/cwe/CweTechnologyName#Sensor%20Hardware>
             <https://w3id.org/lmodel/cwe/CweTechnologyName#Storage%20Hardware>
             <https://w3id.org/lmodel/cwe/CweTechnologyName#Test/Debug%20Hardware>
             <https://w3id.org/lmodel/cwe/CweTechnologyName#Other> ] ? ;
          <Class> [ <https://w3id.org/lmodel/cwe/CweTechnologyClass#Client%20Server>
             <https://w3id.org/lmodel/cwe/CweTechnologyClass#Cloud%20Computing>
             <https://w3id.org/lmodel/cwe/CweTechnologyClass#ICS/OT> <https://w3id.org/lmodel/cwe/CweTechnologyClass#Mainframe>
             <https://w3id.org/lmodel/cwe/CweTechnologyClass#Mobile> <https://w3id.org/lmodel/cwe/CweTechnologyClass#N-Tier>
             <https://w3id.org/lmodel/cwe/CweTechnologyClass#SOA>
             <https://w3id.org/lmodel/cwe/CweTechnologyClass#System%20on%20Chip>
             <https://w3id.org/lmodel/cwe/CweTechnologyClass#Web%20Based>
             <https://w3id.org/lmodel/cwe/CweTechnologyClass#Not%20Technology-Specific> ] ? ;
          <Prevalence> [ <https://w3id.org/lmodel/cwe/CwePrevalence#Often> <https://w3id.org/lmodel/cwe/CwePrevalence#Sometimes>
             <https://w3id.org/lmodel/cwe/CwePrevalence#Rarely> <https://w3id.org/lmodel/cwe/CwePrevalence#Undetermined>
             <https://w3id.org/lmodel/cwe/CwePrevalence#None> ] ;
          <Note> @<CweStructuredText> ?
       ) ;
       rdf:type [ <CweTechnologyPlatform> ] ?
    )
}

<CweView> CLOSED {
    (  $<CweView_tes> (  &<CweEntry_tes> ;
          rdf:type [ <CweEntry> ] ? ;
          <Type> [ <https://w3id.org/lmodel/cwe/CweViewType#Implicit> <https://w3id.org/lmodel/cwe/CweViewType#Explicit>
             <https://w3id.org/lmodel/cwe/CweViewType#Graph> ] ;
          <Objective> @<CweStructuredText> ;
          <Audience> @<CweStakeholder> * ;
          <Members> @<CweRelationships> ? ;
          <Filter> @linkml:String ?
       ) ;
       rdf:type [ <CweView> ]
    )
}

<CweWeakness> CLOSED {
    (  $<CweWeakness_tes> (  &<CweEntry_tes> ;
          rdf:type [ <CweEntry> ] ? ;
          <Abstraction> [ <https://w3id.org/lmodel/cwe/CweAbstraction#Pillar> <https://w3id.org/lmodel/cwe/CweAbstraction#Class>
             <https://w3id.org/lmodel/cwe/CweAbstraction#Base> <https://w3id.org/lmodel/cwe/CweAbstraction#Variant>
             <https://w3id.org/lmodel/cwe/CweAbstraction#Compound> ] ;
          <Structure> [ <https://w3id.org/lmodel/cwe/CweStructure#Chain> <https://w3id.org/lmodel/cwe/CweStructure#Composite>
             <https://w3id.org/lmodel/cwe/CweStructure#Simple> ] ;
          <Diagram> @linkml:String ? ;
          <Description> @linkml:String ;
          <Extended_Description> @<CweStructuredText> ? ;
          <Technical_Nuance> @<CweStructuredText> ? ;
          <Dimensions> @<CweDimension> * ;
          <Related_Weaknesses> @<CweRelatedWeakness> * ;
          <Weakness_Ordinalities> @<CweWeaknessOrdinality> * ;
          <Applicable_Platforms> @<CweApplicablePlatforms> ? ;
          <Background_Details> @<CweStructuredText> * ;
          <Alternate_Terms> @<CweAlternateTerm> * ;
          <Modes_Of_Introduction> @<CweIntroduction> * ;
          <Exploitation_Factors> @<CweStructuredText> * ;
          <Likelihood_Of_Exploit> [ <https://w3id.org/lmodel/cwe/CweLikelihood#High>
             <https://w3id.org/lmodel/cwe/CweLikelihood#Medium> <https://w3id.org/lmodel/cwe/CweLikelihood#Low>
             <https://w3id.org/lmodel/cwe/CweLikelihood#Unknown> ] ? ;
          <Common_Consequences> @<CweConsequence> * ;
          <Detection_Methods> @<CweDetectionMethod> * ;
          <Potential_Mitigations> @<CweMitigation> * ;
          <Demonstrative_Examples> @<CweDemonstrativeExample> * ;
          <Observed_Examples> @<CweObservedExample> * ;
          <Functional_Areas> [ <https://w3id.org/lmodel/cwe/CweFunctionalArea#Authentication>
             <https://w3id.org/lmodel/cwe/CweFunctionalArea#Authorization>
             <https://w3id.org/lmodel/cwe/CweFunctionalArea#Code%20Libraries>
             <https://w3id.org/lmodel/cwe/CweFunctionalArea#Counters> <https://w3id.org/lmodel/cwe/CweFunctionalArea#Cryptography>
             <https://w3id.org/lmodel/cwe/CweFunctionalArea#Error%20Handling>
             <https://w3id.org/lmodel/cwe/CweFunctionalArea#Interprocess%20Communication>
             <https://w3id.org/lmodel/cwe/CweFunctionalArea#File%20Processing>
             <https://w3id.org/lmodel/cwe/CweFunctionalArea#Logging>
             <https://w3id.org/lmodel/cwe/CweFunctionalArea#Memory%20Management>
             <https://w3id.org/lmodel/cwe/CweFunctionalArea#Networking>
             <https://w3id.org/lmodel/cwe/CweFunctionalArea#Number%20Processing>
             <https://w3id.org/lmodel/cwe/CweFunctionalArea#Program%20Invocation>
             <https://w3id.org/lmodel/cwe/CweFunctionalArea#Protection%20Mechanism>
             <https://w3id.org/lmodel/cwe/CweFunctionalArea#Session%20Management>
             <https://w3id.org/lmodel/cwe/CweFunctionalArea#Signals>
             <https://w3id.org/lmodel/cwe/CweFunctionalArea#String%20Processing>
             <https://w3id.org/lmodel/cwe/CweFunctionalArea#Not%20Functional-Area-Specific>
             <https://w3id.org/lmodel/cwe/CweFunctionalArea#Power> <https://w3id.org/lmodel/cwe/CweFunctionalArea#Clock> ] * ;
          <Affected_Resources> [ <https://w3id.org/lmodel/cwe/CweResource#CPU>
             <https://w3id.org/lmodel/cwe/CweResource#File%20or%20Directory> <https://w3id.org/lmodel/cwe/CweResource#Memory>
             <https://w3id.org/lmodel/cwe/CweResource#System%20Process> <https://w3id.org/lmodel/cwe/CweResource#Other> ] * ;
          <Taxonomy_Mappings> @<CweTaxonomyMapping> * ;
          <Related_Attack_Patterns> @<CweRelatedAttackPattern> *
       ) ;
       rdf:type [ <CweWeakness> ]
    )
}

<CweWeaknessCatalog> CLOSED {
    (  $<CweWeaknessCatalog_tes> (  <Name> @linkml:String ;
          <Version> @linkml:String ;
          <Date> @linkml:Date ;
          <Weaknesses> @<CweWeakness> * ;
          <Groupings> @<CweGrouping> * ;
          <Views> @<CweView> * ;
          <External_References> @<CweExternalReference> *
       ) ;
       rdf:type [ <CweWeaknessCatalog> ] ?
    )
}

<CweWeaknessOrdinality> CLOSED {
    (  $<CweWeaknessOrdinality_tes> (  <Ordinality> [ <https://w3id.org/lmodel/cwe/CweOrdinality#Indirect>
             <https://w3id.org/lmodel/cwe/CweOrdinality#Primary> <https://w3id.org/lmodel/cwe/CweOrdinality#Resultant> ] ;
          <Description> @linkml:String ?
       ) ;
       rdf:type [ <CweWeaknessOrdinality> ] ?
    )
}
