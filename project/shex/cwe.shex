# metamodel_version: 1.7.0
# version: 7.3
BASE <https://w3id.org/lmodel/cwe/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX linkml: <https://w3id.org/linkml/>
PREFIX schema1: <http://schema.org/>
PREFIX dct: <http://purl.org/dc/terms/>


<CveId> xsd:string

linkml:String xsd:string

linkml:Integer xsd:integer

linkml:Boolean xsd:boolean

linkml:Float xsd:float

linkml:Double xsd:double

linkml:Decimal xsd:decimal

linkml:Time xsd:time

linkml:Date xsd:date

linkml:Datetime xsd:dateTime

linkml:DateOrDatetime linkml:DateOrDatetime

linkml:Uriorcurie IRI

linkml:Curie xsd:string

linkml:Uri IRI

linkml:Ncname xsd:string

linkml:Objectidentifier IRI

linkml:Nodeidentifier NONLITERAL

linkml:Jsonpointer xsd:string

linkml:Jsonpath xsd:string

linkml:Sparqlpath xsd:string

<AlternateTerm> CLOSED {
    (  $<AlternateTerm_tes> (  <term> @linkml:String ;
          dct:description @linkml:String ?
       ) ;
       rdf:type [ <AlternateTerm> ] ?
    )
}

<ApplicablePlatforms> CLOSED {
    (  $<ApplicablePlatforms_tes> (  <languages> @<LanguagePlatform> * ;
          <operating_systems> @<OSPlatform> * ;
          <architectures> @<ArchitecturePlatform> * ;
          <technologies> @<TechnologyPlatform> *
       ) ;
       rdf:type [ <ApplicablePlatforms> ] ?
    )
}

<ArchitecturePlatform> CLOSED {
    (  $<ArchitecturePlatform_tes> (  rdfs:label [ <https://w3id.org/lmodel/cwe/ArchitectureName#ALPHA>
             <https://w3id.org/lmodel/cwe/ArchitectureName#ARM> <https://w3id.org/lmodel/cwe/ArchitectureName#ITANIUM>
             <https://w3id.org/lmodel/cwe/ArchitectureName#POWER_ARCHITECTURE> <https://w3id.org/lmodel/cwe/ArchitectureName#SPARC>
             <https://w3id.org/lmodel/cwe/ArchitectureName#X86> <https://w3id.org/lmodel/cwe/ArchitectureName#OTHER> ] ? ;
          <class_> [ <https://w3id.org/lmodel/cwe/ArchitectureClass#EMBEDDED>
             <https://w3id.org/lmodel/cwe/ArchitectureClass#MICROCOMPUTER>
             <https://w3id.org/lmodel/cwe/ArchitectureClass#WORKSTATION>
             <https://w3id.org/lmodel/cwe/ArchitectureClass#NOT_ARCHITECTURE_SPECIFIC> ] ? ;
          <prevalence> [ <https://w3id.org/lmodel/cwe/PlatformPrevalence#OFTEN>
             <https://w3id.org/lmodel/cwe/PlatformPrevalence#SOMETIMES> <https://w3id.org/lmodel/cwe/PlatformPrevalence#RARELY>
             <https://w3id.org/lmodel/cwe/PlatformPrevalence#UNDETERMINED> ]
       ) ;
       rdf:type [ <ArchitecturePlatform> ] ?
    )
}

<Audience> CLOSED {
    (  $<Audience_tes> (  <type> [ <https://w3id.org/lmodel/cwe/StakeholderType#ACADEMIC_RESEARCHERS>
             <https://w3id.org/lmodel/cwe/StakeholderType#APPLIED_RESEARCHERS>
             <https://w3id.org/lmodel/cwe/StakeholderType#ASSESSMENT_TEAMS>
             <https://w3id.org/lmodel/cwe/StakeholderType#ASSESSMENT_TOOL_VENDORS>
             <https://w3id.org/lmodel/cwe/StakeholderType#CWE_TEAM> <https://w3id.org/lmodel/cwe/StakeholderType#EDUCATORS>
             <https://w3id.org/lmodel/cwe/StakeholderType#HARDWARE_DESIGNERS>
             <https://w3id.org/lmodel/cwe/StakeholderType#INFORMATION_PROVIDERS>
             <https://w3id.org/lmodel/cwe/StakeholderType#PRODUCT_CUSTOMERS>
             <https://w3id.org/lmodel/cwe/StakeholderType#PRODUCT_VENDORS>
             <https://w3id.org/lmodel/cwe/StakeholderType#SOFTWARE_DEVELOPERS>
             <https://w3id.org/lmodel/cwe/StakeholderType#VULNERABILITY_ANALYSTS>
             <https://w3id.org/lmodel/cwe/StakeholderType#OTHER> ] ;
          dct:description @linkml:String ?
       ) ;
       rdf:type [ <Audience> ] ?
    )
}

<CatalogMember> CLOSED {
    (  $<CatalogMember_tes> (  <cwe_id> @linkml:Integer ;
          <view_id> @linkml:Integer
       ) ;
       rdf:type [ <CatalogMember> ] ?
    )
}

<Category> CLOSED {
    (  $<Category_tes> (  rdfs:label @linkml:String ;
          <status> [ <https://w3id.org/lmodel/cwe/WeaknessStatus#DEPRECATED> <https://w3id.org/lmodel/cwe/WeaknessStatus#DRAFT>
             <https://w3id.org/lmodel/cwe/WeaknessStatus#INCOMPLETE> <https://w3id.org/lmodel/cwe/WeaknessStatus#OBSOLETE>
             <https://w3id.org/lmodel/cwe/WeaknessStatus#STABLE> <https://w3id.org/lmodel/cwe/WeaknessStatus#USABLE> ] ;
          <summary> @linkml:String ;
          <relationships> @<Relationship> ? ;
          <taxonomy_mappings> @<TaxonomyMapping> * ;
          <references> @<CWEReference> * ;
          <mapping_notes> @<MappingNotes> ;
          skos:note @<Note> * ;
          <content_history> @<ContentHistory>
       ) ;
       rdf:type [ <Category> ]
    )
}

<CommonConsequence> CLOSED {
    (  $<CommonConsequence_tes> (  <consequence_id> @linkml:String ? ;
          <scopes> [ <https://w3id.org/lmodel/cwe/SecurityScope#CONFIDENTIALITY>
             <https://w3id.org/lmodel/cwe/SecurityScope#INTEGRITY> <https://w3id.org/lmodel/cwe/SecurityScope#AVAILABILITY>
             <https://w3id.org/lmodel/cwe/SecurityScope#ACCESS_CONTROL> <https://w3id.org/lmodel/cwe/SecurityScope#ACCOUNTABILITY>
             <https://w3id.org/lmodel/cwe/SecurityScope#AUTHENTICATION> <https://w3id.org/lmodel/cwe/SecurityScope#AUTHORIZATION>
             <https://w3id.org/lmodel/cwe/SecurityScope#NON_REPUDIATION> <https://w3id.org/lmodel/cwe/SecurityScope#OTHER> ] + ;
          <impacts> [ <https://w3id.org/lmodel/cwe/TechnicalImpact#MODIFY_MEMORY>
             <https://w3id.org/lmodel/cwe/TechnicalImpact#READ_MEMORY>
             <https://w3id.org/lmodel/cwe/TechnicalImpact#MODIFY_FILES_OR_DIRECTORIES>
             <https://w3id.org/lmodel/cwe/TechnicalImpact#READ_FILES_OR_DIRECTORIES>
             <https://w3id.org/lmodel/cwe/TechnicalImpact#MODIFY_APPLICATION_DATA>
             <https://w3id.org/lmodel/cwe/TechnicalImpact#READ_APPLICATION_DATA>
             <https://w3id.org/lmodel/cwe/TechnicalImpact#DOS_CRASH_EXIT_OR_RESTART>
             <https://w3id.org/lmodel/cwe/TechnicalImpact#DOS_AMPLIFICATION>
             <https://w3id.org/lmodel/cwe/TechnicalImpact#DOS_INSTABILITY>
             <https://w3id.org/lmodel/cwe/TechnicalImpact#DOS_RESOURCE_CONSUMPTION_CPU>
             <https://w3id.org/lmodel/cwe/TechnicalImpact#DOS_RESOURCE_CONSUMPTION_MEMORY>
             <https://w3id.org/lmodel/cwe/TechnicalImpact#DOS_RESOURCE_CONSUMPTION_OTHER>
             <https://w3id.org/lmodel/cwe/TechnicalImpact#EXECUTE_UNAUTHORIZED_CODE_OR_COMMANDS>
             <https://w3id.org/lmodel/cwe/TechnicalImpact#GAIN_PRIVILEGES_OR_ASSUME_IDENTITY>
             <https://w3id.org/lmodel/cwe/TechnicalImpact#BYPASS_PROTECTION_MECHANISM>
             <https://w3id.org/lmodel/cwe/TechnicalImpact#HIDE_ACTIVITIES>
             <https://w3id.org/lmodel/cwe/TechnicalImpact#ALTER_EXECUTION_LOGIC>
             <https://w3id.org/lmodel/cwe/TechnicalImpact#QUALITY_DEGRADATION>
             <https://w3id.org/lmodel/cwe/TechnicalImpact#UNEXPECTED_STATE>
             <https://w3id.org/lmodel/cwe/TechnicalImpact#VARIES_BY_CONTEXT>
             <https://w3id.org/lmodel/cwe/TechnicalImpact#INCREASE_ANALYTICAL_COMPLEXITY>
             <https://w3id.org/lmodel/cwe/TechnicalImpact#REDUCE_MAINTAINABILITY>
             <https://w3id.org/lmodel/cwe/TechnicalImpact#REDUCE_PERFORMANCE>
             <https://w3id.org/lmodel/cwe/TechnicalImpact#REDUCE_RELIABILITY> <https://w3id.org/lmodel/cwe/TechnicalImpact#OTHER> ]
          + ;
          <likelihood> [ <https://w3id.org/lmodel/cwe/LikelihoodLevel#HIGH> <https://w3id.org/lmodel/cwe/LikelihoodLevel#MEDIUM>
             <https://w3id.org/lmodel/cwe/LikelihoodLevel#LOW> <https://w3id.org/lmodel/cwe/LikelihoodLevel#UNKNOWN> ] ? ;
          <note> @linkml:String ?
       ) ;
       rdf:type [ <CommonConsequence> ] ?
    )
}

<ContentHistory> CLOSED {
    (  $<ContentHistory_tes> (  <submission> @<Submission> ;
          <modifications> @<Modification> * ;
          <contributions> @<Contribution> * ;
          <previous_entry_names> @<PreviousEntryName> *
       ) ;
       rdf:type [ <ContentHistory> ] ?
    )
}

<Contribution> CLOSED {
    (  $<Contribution_tes> (  <type> [ <https://w3id.org/lmodel/cwe/ContributionType#CONTENT>
             <https://w3id.org/lmodel/cwe/ContributionType#FEEDBACK> ] ;
          <contribution_name> @linkml:String ? ;
          <contribution_organization> @linkml:String ? ;
          <contribution_date> @linkml:Date ;
          <contribution_version> @linkml:String ? ;
          <contribution_release_date> @linkml:Date ? ;
          <contribution_comment> @linkml:String ?
       ) ;
       rdf:type [ <Contribution> ] ?
    )
}

<CWEReference> CLOSED {
    (  $<CWEReference_tes> (  <external_reference_id> @linkml:String ;
          <section> @linkml:String ?
       ) ;
       rdf:type [ <CWEReference> ] ?
    )
}

<DemonstrativeExample> CLOSED {
    (  $<DemonstrativeExample_tes> (  <demonstrative_example_id> @linkml:String ? ;
          <title_text> @linkml:String ? ;
          <intro_text> @linkml:String ;
          <body_texts> @linkml:String * ;
          <example_codes> @<ExampleCode> * ;
          <references> @<CWEReference> *
       ) ;
       rdf:type [ <DemonstrativeExample> ] ?
    )
}

<DetectionMethod> CLOSED {
    (  $<DetectionMethod_tes> (  <detection_method_id> @linkml:String ? ;
          <method> [ <https://w3id.org/lmodel/cwe/DetectionMethodType#AUTOMATED_ANALYSIS>
             <https://w3id.org/lmodel/cwe/DetectionMethodType#AUTOMATED_DYNAMIC_ANALYSIS>
             <https://w3id.org/lmodel/cwe/DetectionMethodType#AUTOMATED_STATIC_ANALYSIS>
             <https://w3id.org/lmodel/cwe/DetectionMethodType#AUTOMATED_STATIC_ANALYSIS_SOURCE_CODE>
             <https://w3id.org/lmodel/cwe/DetectionMethodType#AUTOMATED_STATIC_ANALYSIS_BINARY_OR_BYTECODE>
             <https://w3id.org/lmodel/cwe/DetectionMethodType#FUZZING>
             <https://w3id.org/lmodel/cwe/DetectionMethodType#MANUAL_ANALYSIS>
             <https://w3id.org/lmodel/cwe/DetectionMethodType#MANUAL_DYNAMIC_ANALYSIS>
             <https://w3id.org/lmodel/cwe/DetectionMethodType#MANUAL_STATIC_ANALYSIS>
             <https://w3id.org/lmodel/cwe/DetectionMethodType#MANUAL_STATIC_ANALYSIS_SOURCE_CODE>
             <https://w3id.org/lmodel/cwe/DetectionMethodType#MANUAL_STATIC_ANALYSIS_BINARY_OR_BYTECODE>
             <https://w3id.org/lmodel/cwe/DetectionMethodType#WHITE_BOX>
             <https://w3id.org/lmodel/cwe/DetectionMethodType#BLACK_BOX>
             <https://w3id.org/lmodel/cwe/DetectionMethodType#ARCHITECTURE_OR_DESIGN_REVIEW>
             <https://w3id.org/lmodel/cwe/DetectionMethodType#DYNAMIC_ANALYSIS_WITH_MANUAL_RESULTS_INTERPRETATION>
             <https://w3id.org/lmodel/cwe/DetectionMethodType#DYNAMIC_ANALYSIS_WITH_AUTOMATED_RESULTS_INTERPRETATION>
             <https://w3id.org/lmodel/cwe/DetectionMethodType#FORMAL_VERIFICATION>
             <https://w3id.org/lmodel/cwe/DetectionMethodType#SIMULATION_EMULATION>
             <https://w3id.org/lmodel/cwe/DetectionMethodType#OTHER> ] ;
          dct:description @linkml:String ;
          <effectiveness> [ <https://w3id.org/lmodel/cwe/DetectionEffectiveness#HIGH>
             <https://w3id.org/lmodel/cwe/DetectionEffectiveness#MODERATE>
             <https://w3id.org/lmodel/cwe/DetectionEffectiveness#SOAR_PARTIAL>
             <https://w3id.org/lmodel/cwe/DetectionEffectiveness#OPPORTUNISTIC>
             <https://w3id.org/lmodel/cwe/DetectionEffectiveness#LIMITED> <https://w3id.org/lmodel/cwe/DetectionEffectiveness#NONE>
             ] ? ;
          <effectiveness_notes> @linkml:String ?
       ) ;
       rdf:type [ <DetectionMethod> ] ?
    )
}

<ExampleCode> CLOSED {
    (  $<ExampleCode_tes> (  skos:related [ <https://w3id.org/lmodel/cwe/CodeNature#ATTACK>
             <https://w3id.org/lmodel/cwe/CodeNature#BAD> <https://w3id.org/lmodel/cwe/CodeNature#GOOD>
             <https://w3id.org/lmodel/cwe/CodeNature#INFORMATIVE> <https://w3id.org/lmodel/cwe/CodeNature#MITIGATION>
             <https://w3id.org/lmodel/cwe/CodeNature#RESULT> ] ;
          <language> [ <https://w3id.org/lmodel/cwe/ProgrammingLanguage#ADA>
             <https://w3id.org/lmodel/cwe/ProgrammingLanguage#ARM_ASSEMBLY> <https://w3id.org/lmodel/cwe/ProgrammingLanguage#ASP>
             <https://w3id.org/lmodel/cwe/ProgrammingLanguage#ASP_DOT_NET> <https://w3id.org/lmodel/cwe/ProgrammingLanguage#BASIC>
             <https://w3id.org/lmodel/cwe/ProgrammingLanguage#C> <https://w3id.org/lmodel/cwe/ProgrammingLanguage#C_PLUS_PLUS>
             <https://w3id.org/lmodel/cwe/ProgrammingLanguage#C_SHARP> <https://w3id.org/lmodel/cwe/ProgrammingLanguage#COBOL>
             <https://w3id.org/lmodel/cwe/ProgrammingLanguage#FORTRAN> <https://w3id.org/lmodel/cwe/ProgrammingLanguage#FSHARP>
             <https://w3id.org/lmodel/cwe/ProgrammingLanguage#GO> <https://w3id.org/lmodel/cwe/ProgrammingLanguage#HTML>
             <https://w3id.org/lmodel/cwe/ProgrammingLanguage#JAVA> <https://w3id.org/lmodel/cwe/ProgrammingLanguage#JAVASCRIPT>
             <https://w3id.org/lmodel/cwe/ProgrammingLanguage#JSON> <https://w3id.org/lmodel/cwe/ProgrammingLanguage#JSP>
             <https://w3id.org/lmodel/cwe/ProgrammingLanguage#OBJECTIVE_C> <https://w3id.org/lmodel/cwe/ProgrammingLanguage#PASCAL>
             <https://w3id.org/lmodel/cwe/ProgrammingLanguage#PERL> <https://w3id.org/lmodel/cwe/ProgrammingLanguage#PHP>
             <https://w3id.org/lmodel/cwe/ProgrammingLanguage#PSEUDOCODE> <https://w3id.org/lmodel/cwe/ProgrammingLanguage#PYTHON>
             <https://w3id.org/lmodel/cwe/ProgrammingLanguage#RUBY> <https://w3id.org/lmodel/cwe/ProgrammingLanguage#RUST>
             <https://w3id.org/lmodel/cwe/ProgrammingLanguage#SHELL> <https://w3id.org/lmodel/cwe/ProgrammingLanguage#SQL>
             <https://w3id.org/lmodel/cwe/ProgrammingLanguage#SWIFT> <https://w3id.org/lmodel/cwe/ProgrammingLanguage#VB_DOT_NET>
             <https://w3id.org/lmodel/cwe/ProgrammingLanguage#VERILOG> <https://w3id.org/lmodel/cwe/ProgrammingLanguage#VHDL>
             <https://w3id.org/lmodel/cwe/ProgrammingLanguage#XML> <https://w3id.org/lmodel/cwe/ProgrammingLanguage#X86_ASSEMBLY>
             <https://w3id.org/lmodel/cwe/ProgrammingLanguage#OTHER> ] ? ;
          <content> @linkml:String ?
       ) ;
       rdf:type [ <ExampleCode> ] ?
    )
}

<ExternalReference> CLOSED {
    (  $<ExternalReference_tes> (  dct:title @linkml:String ;
          <authors> @linkml:String * ;
          <edition> @linkml:String ? ;
          <publication> @linkml:String ? ;
          <publication_year> @linkml:String ? ;
          <publication_month> @linkml:String ? ;
          <publication_day> @linkml:String ? ;
          <publisher> @linkml:String ? ;
          schema1:url @linkml:Uri ? ;
          <url_date> @linkml:Date ?
       ) ;
       rdf:type [ <ExternalReference> ]
    )
}

<LanguagePlatform> CLOSED {
    (  $<LanguagePlatform_tes> (  rdfs:label [ <https://w3id.org/lmodel/cwe/ProgrammingLanguage#ADA>
             <https://w3id.org/lmodel/cwe/ProgrammingLanguage#ARM_ASSEMBLY> <https://w3id.org/lmodel/cwe/ProgrammingLanguage#ASP>
             <https://w3id.org/lmodel/cwe/ProgrammingLanguage#ASP_DOT_NET> <https://w3id.org/lmodel/cwe/ProgrammingLanguage#BASIC>
             <https://w3id.org/lmodel/cwe/ProgrammingLanguage#C> <https://w3id.org/lmodel/cwe/ProgrammingLanguage#C_PLUS_PLUS>
             <https://w3id.org/lmodel/cwe/ProgrammingLanguage#C_SHARP> <https://w3id.org/lmodel/cwe/ProgrammingLanguage#COBOL>
             <https://w3id.org/lmodel/cwe/ProgrammingLanguage#FORTRAN> <https://w3id.org/lmodel/cwe/ProgrammingLanguage#FSHARP>
             <https://w3id.org/lmodel/cwe/ProgrammingLanguage#GO> <https://w3id.org/lmodel/cwe/ProgrammingLanguage#HTML>
             <https://w3id.org/lmodel/cwe/ProgrammingLanguage#JAVA> <https://w3id.org/lmodel/cwe/ProgrammingLanguage#JAVASCRIPT>
             <https://w3id.org/lmodel/cwe/ProgrammingLanguage#JSON> <https://w3id.org/lmodel/cwe/ProgrammingLanguage#JSP>
             <https://w3id.org/lmodel/cwe/ProgrammingLanguage#OBJECTIVE_C> <https://w3id.org/lmodel/cwe/ProgrammingLanguage#PASCAL>
             <https://w3id.org/lmodel/cwe/ProgrammingLanguage#PERL> <https://w3id.org/lmodel/cwe/ProgrammingLanguage#PHP>
             <https://w3id.org/lmodel/cwe/ProgrammingLanguage#PSEUDOCODE> <https://w3id.org/lmodel/cwe/ProgrammingLanguage#PYTHON>
             <https://w3id.org/lmodel/cwe/ProgrammingLanguage#RUBY> <https://w3id.org/lmodel/cwe/ProgrammingLanguage#RUST>
             <https://w3id.org/lmodel/cwe/ProgrammingLanguage#SHELL> <https://w3id.org/lmodel/cwe/ProgrammingLanguage#SQL>
             <https://w3id.org/lmodel/cwe/ProgrammingLanguage#SWIFT> <https://w3id.org/lmodel/cwe/ProgrammingLanguage#VB_DOT_NET>
             <https://w3id.org/lmodel/cwe/ProgrammingLanguage#VERILOG> <https://w3id.org/lmodel/cwe/ProgrammingLanguage#VHDL>
             <https://w3id.org/lmodel/cwe/ProgrammingLanguage#XML> <https://w3id.org/lmodel/cwe/ProgrammingLanguage#X86_ASSEMBLY>
             <https://w3id.org/lmodel/cwe/ProgrammingLanguage#OTHER> ] ? ;
          <class_> [ <https://w3id.org/lmodel/cwe/LanguageClass#ASSEMBLY> <https://w3id.org/lmodel/cwe/LanguageClass#COMPILED>
             <https://w3id.org/lmodel/cwe/LanguageClass#HARDWARE_DESCRIPTION_LANGUAGE>
             <https://w3id.org/lmodel/cwe/LanguageClass#INTERPRETED> <https://w3id.org/lmodel/cwe/LanguageClass#OBJECT_ORIENTED>
             <https://w3id.org/lmodel/cwe/LanguageClass#MEMORY_UNSAFE>
             <https://w3id.org/lmodel/cwe/LanguageClass#NOT_LANGUAGE_SPECIFIC> ] ? ;
          <prevalence> [ <https://w3id.org/lmodel/cwe/PlatformPrevalence#OFTEN>
             <https://w3id.org/lmodel/cwe/PlatformPrevalence#SOMETIMES> <https://w3id.org/lmodel/cwe/PlatformPrevalence#RARELY>
             <https://w3id.org/lmodel/cwe/PlatformPrevalence#UNDETERMINED> ]
       ) ;
       rdf:type [ <LanguagePlatform> ] ?
    )
}

<MappingNotes> CLOSED {
    (  $<MappingNotes_tes> (  <usage> [ <https://w3id.org/lmodel/cwe/MappingUsage#ALLOWED>
             <https://w3id.org/lmodel/cwe/MappingUsage#ALLOWED_WITH_REVIEW> <https://w3id.org/lmodel/cwe/MappingUsage#DISCOURAGED>
             <https://w3id.org/lmodel/cwe/MappingUsage#PROHIBITED> ] ;
          <rationale> @linkml:String ;
          <comments> @linkml:String ;
          <reasons> [ <https://w3id.org/lmodel/cwe/MappingReason#ABSTRACTION> <https://w3id.org/lmodel/cwe/MappingReason#CATEGORY>
             <https://w3id.org/lmodel/cwe/MappingReason#VIEW> <https://w3id.org/lmodel/cwe/MappingReason#DEPRECATED>
             <https://w3id.org/lmodel/cwe/MappingReason#POTENTIAL_DEPRECATION>
             <https://w3id.org/lmodel/cwe/MappingReason#FREQUENT_MISUSE>
             <https://w3id.org/lmodel/cwe/MappingReason#FREQUENT_MISINTERPRETATION>
             <https://w3id.org/lmodel/cwe/MappingReason#MULTIPLE_USE> <https://w3id.org/lmodel/cwe/MappingReason#CWE_OVERLAP>
             <https://w3id.org/lmodel/cwe/MappingReason#ACCEPTABLE_USE>
             <https://w3id.org/lmodel/cwe/MappingReason#POTENTIAL_MAJOR_CHANGES> <https://w3id.org/lmodel/cwe/MappingReason#OTHER>
             ] + ;
          <suggestions> @<MappingSuggestion> *
       ) ;
       rdf:type [ <MappingNotes> ] ?
    )
}

<MappingSuggestion> CLOSED {
    (  $<MappingSuggestion_tes> (  <cwe_id> @linkml:Integer ;
          <comment> @linkml:String
       ) ;
       rdf:type [ <MappingSuggestion> ] ?
    )
}

<ModeOfIntroduction> CLOSED {
    (  $<ModeOfIntroduction_tes> (  <phase> [ <https://w3id.org/lmodel/cwe/LifecyclePhase#POLICY>
             <https://w3id.org/lmodel/cwe/LifecyclePhase#REQUIREMENTS>
             <https://w3id.org/lmodel/cwe/LifecyclePhase#ARCHITECTURE_AND_DESIGN>
             <https://w3id.org/lmodel/cwe/LifecyclePhase#IMPLEMENTATION>
             <https://w3id.org/lmodel/cwe/LifecyclePhase#BUILD_AND_COMPILATION>
             <https://w3id.org/lmodel/cwe/LifecyclePhase#TESTING> <https://w3id.org/lmodel/cwe/LifecyclePhase#DOCUMENTATION>
             <https://w3id.org/lmodel/cwe/LifecyclePhase#BUNDLING> <https://w3id.org/lmodel/cwe/LifecyclePhase#DISTRIBUTION>
             <https://w3id.org/lmodel/cwe/LifecyclePhase#INSTALLATION>
             <https://w3id.org/lmodel/cwe/LifecyclePhase#SYSTEM_CONFIGURATION>
             <https://w3id.org/lmodel/cwe/LifecyclePhase#OPERATION>
             <https://w3id.org/lmodel/cwe/LifecyclePhase#PATCHING_AND_MAINTENANCE>
             <https://w3id.org/lmodel/cwe/LifecyclePhase#PORTING> <https://w3id.org/lmodel/cwe/LifecyclePhase#INTEGRATION>
             <https://w3id.org/lmodel/cwe/LifecyclePhase#MANUFACTURING>
             <https://w3id.org/lmodel/cwe/LifecyclePhase#DECOMMISSIONING_AND_END_OF_LIFE> ] ;
          <note> @linkml:String ?
       ) ;
       rdf:type [ <ModeOfIntroduction> ] ?
    )
